<form id="addressForm" class="flow-card">
    <div class="address-form-grid">
        <label>عنوان آدرس<input name="title" placeholder="مثلاً خانه یا محل کار" maxlength="40" required autofocus></label>
        <label>نام گیرنده<input name="recipient" autocomplete="name" maxlength="100" required></label>
        <label>شماره همراه<input name="phone" type="tel" inputmode="tel" autocomplete="tel" pattern="[0-9۰-۹٠-٩]{11}" maxlength="11" required></label>
        <label>
            استان
            <select name="province" autocomplete="address-level1" required>
                <option value="">انتخاب استان</option>
            </select>
        </label>
        <label>
            شهر
            <select name="city" autocomplete="address-level2" required disabled>
                <option value="">ابتدا استان را انتخاب کنید</option>
            </select>
        </label>
    </div>
    <label>نشانی کامل<textarea name="street" autocomplete="street-address" rows="3" maxlength="400" required></textarea></label>
    <label>کد پستی<input name="postal" inputmode="numeric" autocomplete="postal-code" pattern="[0-9۰-۹٠-٩]{10}" maxlength="10" required></label>
    <p class="invoice-demo-note">آدرس فقط در همین مرورگر ذخیره می‌شود.</p>
    <p id="addressFormStatus" role="status"></p>
    <button type="submit" class="flow-button">ذخیره و انتخاب آدرس <i class="bi bi-check2"></i></button>
</form>