@model Shop.Models.ManagedPageContent
@foreach (var contentSection in Model.Sections)
{
    <section class="legal-section">
        @if (!string.IsNullOrWhiteSpace(contentSection.Heading))
        {
            <h2>@contentSection.Heading</h2>
        }
        @foreach (var paragraph in (contentSection.Body ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            <p>@paragraph</p>
        }
    </section>
}
