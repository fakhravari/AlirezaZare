@inject Shop.Services.CatalogRepository StoreCatalog
<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
<div class="home-header-top" aria-label="جست‌وجو و پشتیبانی فروشگاه">
    <a class="home-header-support home-header-support-link" href="tel:03969455457" aria-label="تماس فوری با پشتیبانی به شماره 03969455457">
        <span class="home-header-support-icon" aria-hidden="true"><i class="bi bi-headset"></i></span>
        <span>
            <small>پشتیبانی فوری و پیگیری سفارش</small><strong dir="ltr">03969455457</strong>
        </span>
    </a>
    <form class="home-header-search" action="Search" method="get" role="search">
        <button type="submit" aria-label="جست‌وجو">
            <i class="bi bi-search" aria-hidden="true"></i>
        </button>
        <input class="header-search-input" id="headerSearchInput" name="q" type="search" placeholder="نام محصول، برند یا دسته را جستجو کنید..." aria-label="جستجوی محصول" aria-controls="headerSearchSuggestions" aria-autocomplete="list" autocomplete="off"/>
        <div class="header-search-suggestions" id="headerSearchSuggestions" role="region" aria-label="پیشنهادهای جستجو" hidden></div>
    </form>
</div>
<div class="container">
<button class="navbar-toggler shadow-none border-0"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#mobileMenu"
        aria-label="باز کردن منو">
    <i class="bi bi-list"></i>
</button>
<a class="navbar-brand brand header-home-link header-brand-lockup" asp-controller="Home" asp-action="Index" aria-label="برق شیراز؛ فروشگاه تخصصی برق و ابزار ندا اولیائی" title="رفتن به صفحهٔ اصلی">
    <picture class="header-brand-mark" aria-hidden="true">
        <img src="~/content/identity/store-electrical-lockup.svg" alt="" width="256" height="72" decoding="async" asp-append-version="true" />
    </picture>
</a>
<div class="home-nav-groups">
<div class="home-nav-menu-group">
<div class="collapse navbar-collapse">
<ul class="navbar-nav mx-auto gap-lg-2">
@if (ViewData["HeaderVariant"]?.ToString() == "inner")
{
    <li class="nav-item dropdown category-nav-dropdown">
        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-grid nav-menu-icon" aria-hidden="true"></i><span>دسته‌بندی قطعات</span>
        </button>
        <div class="dropdown-menu category-nav-mega" aria-label="دسته‌بندی محصولات">
            <aside class="category-mega-sidebar" aria-label="گروه‌های محصول">
                <button type="button" data-mega-category="tools">
                    <i class="bi bi-lightning-charge"></i><span>ابزار برقی</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="hand-tools">
                    <i class="bi bi-tools"></i><span>ابزار دستی</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="components">
                    <i class="bi bi-cpu"></i><span>قطعات الکترونیکی</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="cables">
                    <i class="bi bi-plug"></i><span>سیم، کابل و اتصالات</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="lighting">
                    <i class="bi bi-lightbulb"></i><span>روشنایی و لامپ</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="switchgear">
                    <i class="bi bi-toggle-on"></i><span>کلید و تجهیزات برقی</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="safety">
                    <i class="bi bi-shield-check"></i><span>ایمنی و حفاظت</span><i class="bi bi-chevron-left"></i>
                </button>
                <button type="button" data-mega-category="measurement">
                    <i class="bi bi-speedometer2"></i><span>ابزار اندازه‌گیری</span><i class="bi bi-chevron-left"></i>
                </button>
            </aside>
            <div class="category-mega-content">
                <div class="category-mega-panels" id="categoryMegaPanels" aria-live="polite">
                    <p class="category-mega-hint">برای دیدن زیرشاخه‌ها، یک گروه را انتخاب کنید.</p>
                </div>
            </div>
        </div>
    </li>
}
<li class="nav-item">
    <a class="nav-link" href="Search">
        <i class="bi bi-shop nav-menu-icon" aria-hidden="true"></i><span>فروشگاه</span>
    </a>
</li>
<li class="nav-item dropdown brand-dropdown">
<a class="nav-link dropdown-toggle"
   href="Home/Index#brands"
   role="button"
   data-bs-toggle="dropdown"
   aria-expanded="false">
    <i class="bi bi-award nav-menu-icon" aria-hidden="true"></i><span>برند</span><i class="bi bi-chevron-down brand-menu-caret" aria-hidden="true"></i>
</a>
<ul class="dropdown-menu brand-menu"
    style="
                        width: min(1120px, calc(100vw - 48px)) !important;
                        min-height: 390px !important;
                        display: none;
                        ">
<li class="brand-menu-heading">
    <span>
        <strong>برندهای معتبر ابزار</strong>
        <small>لوگوی برند را انتخاب کنید و محصولاتش را ببینید</small>
    </span>
    <b>@StoreCatalog.Read().Brands.Count برند</b>
</li>
@foreach (BrandProfileModel brand in StoreCatalog.Read().Brands)
{
    string slug = brand.Slug;
    <li>
        <a class="dropdown-item" href="@Url.Content($"~/Search?brand={brand.Slug}")">
            @if (!string.IsNullOrWhiteSpace(brand.LogoFile))
            {
                <span class="brand-menu-logo-frame">
                    <img class="brand-menu-logo" src="@Url.Content($"~/content/brands/{brand.LogoFile}")" alt="" width="52" height="38" decoding="async" />
                </span>
            }
            else
            {
                <span class="brand-menu-logo-frame brand-menu-logo-fallback brand-menu-logo-fallback--@slug" aria-hidden="true">@(slug == "uni-t" ? "UNI-T" : slug == "yihua" ? "YIHUA" : brand.Name)</span>
            }
            <span>
                <strong>@brand.PersianName</strong>
                <small>@brand.Name</small>
            </span>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </a>
    </li>
}
<li class="brand-menu-footer">
    <a class="brand-menu-all-link" href="@Url.Content("~/brands")">
        <span class="brand-menu-cta-copy">
            <strong>مشاهده همه برندها</strong>
            <small>برند مناسب ابزار و تجهیزات خود را پیدا کنید</small>
        </span>
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
    </a>
    <span class="brand-trust">
        <i class="bi bi-shield-check">
        </i>
        <span>
            <strong>
                برندهای ابزار
            </strong><small>ابزار و تجهیزات برق</small>
        </span>
    </span>
</li>
</ul>
</li>
<li class="nav-item">
    <a class="nav-link" href="Magazine">
        <i class="bi bi-journal-text nav-menu-icon" aria-hidden="true"></i><span>مجله فنی</span>
    </a>
</li>
<li class="nav-item dropdown quick-links-dropdown">
    <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-info-circle nav-menu-icon" aria-hidden="true"></i><span>راهنما و اطلاعات</span><i class="bi bi-chevron-down quick-links-caret" aria-hidden="true"></i>
    </button>
    <div class="dropdown-menu quick-links-menu" aria-label="راهنما و اطلاعات">
        <section class="quick-links-group" aria-labelledby="quickCustomerLinks">
            <h3 id="quickCustomerLinks"><i class="bi bi-headset" aria-hidden="true"></i> خدمات مشتریان</h3>
            <a href="@Url.Content("~/Tracking")">پیگیری سفارش</a>
            <a href="@Url.Content("~/Shipping")">شرایط ارسال</a>
            <a href="@Url.Content("~/Warranty")">ضمانت اصالت</a>
            <a href="@Url.Content("~/Faq")">پرسش‌های متداول</a>
            <a href="@Url.Content("~/Legal/Returns")">رویه بازگرداندن کالا</a>
        </section>
        <section class="quick-links-group" aria-labelledby="quickCompanyLinks">
            <h3 id="quickCompanyLinks"><i class="bi bi-building" aria-hidden="true"></i> کمپانی و قوانین</h3>
            <a href="@Url.Content("~/Home/Index#story")">درباره مجموعه</a>
            <a href="@Url.Content("~/Magazine")">مجله برق و ابزار</a>
            <a href="@Url.Content("~/Contact")">تماس با ما</a>
            <a href="@Url.Content("~/Legal/Privacy")">حریم خصوصی</a>
            <a href="@Url.Content("~/Legal/Terms")">شرایط استفاده</a>
        </section>
    </div>
</li>
<li class="nav-item">
    <a class="nav-link" href="About">
        <i class="bi bi-info-circle nav-menu-icon" aria-hidden="true"></i><span>درباره ما</span>
    </a>
</li>
<li class="nav-item">
    <a class="nav-link" href="Contact">
        <i class="bi bi-telephone nav-menu-icon" aria-hidden="true"></i><span>تماس با ما</span>
    </a>
</li>
</ul>
</div>
</div>
<div class="home-nav-action-group">
    <div class="nav-tools">
        <div class="account-wrap" id="accountWrap">
            <button class="account-btn logged-out"
                    id="accountToggle"
                    type="button"
                    aria-label="حساب کاربری"
                    aria-expanded="false"
                    aria-controls="accountPanel">
                <i class="bi bi-person">
                </i>
                <span class="account-label">
                    ورود / ثبت‌نام
                </span><i class="bi bi-chevron-down"></i>
            </button>
            <div class="account-panel shared-account-card" id="accountPanel">
                <div class="account-user">
                    <div class="account-avatar">م</div>
                    <div>
                        <strong>
                            محمدحسین فخراوری
                        </strong><small>مشتری ندا اولیائی</small>
                    </div>
                </div>
                <nav class="account-links" aria-label="منوی حساب کاربری">
                    <a href="Profile">
                        <i class="bi bi-person"></i><span>پروفایل من</span>
                    </a>
                    <a href="Profile/Orders">
                        <i class="bi bi-bag"></i>
                        <span>
                            سفارش‌های من
                        </span><b>۰</b>
                    </a>
                    <a href="Profile/Addresses">
                        <i class="bi bi-signpost-2"></i><span>آدرس‌های من</span>
                    </a>
                    <a href="Profile/Favorites">
                        <i class="bi bi-heart">
                        </i><span>لیست علاقه‌مندی‌ها</span>
                    </a>
                    <a class="account-logout" href="#">
                        <i class="bi bi-box-arrow-left">
                        </i><span>خروج از حساب کاربری</span>
                    </a>
                </nav>
            </div>
        </div>
        <a class="mobile-header-search" href="Search" aria-label="جستجوی محصولات" title="جستجوی محصولات">
            <i class="bi bi-search" aria-hidden="true"></i>
        </a>
        <div class="nav-actions" aria-label="خرید، مقایسه و علاقه‌مندی‌ها">
            <div class="favorites-wrap" id="favoritesWrap">
                <a class="nav-shortcut favorites-toggle" id="favoritesToggle" href="Profile/Favorites" aria-label="علاقه‌مندی‌ها" aria-expanded="false" aria-controls="favoritesPanel" title="علاقه‌مندی‌ها">
                    <i class="bi bi-heart" aria-hidden="true"></i>
                    <b class="nav-count" id="favoritesCount" aria-hidden="true">۰</b>
                </a>
                <section class="compare-panel favorites-panel" id="favoritesPanel" aria-label="فهرست علاقه‌مندی‌ها" aria-hidden="true">
                    <div class="compare-panel-head">
                        <span>
                            <i class="bi bi-heart-fill" aria-hidden="true"></i>
                            <span class="compare-panel-title-copy">
                                <strong>علاقه‌مندی‌های شما</strong><small class="compare-panel-count" id="favoritesPanelCount">۰ محصول</small>
                            </span>
                        </span>
                        <button class="compare-panel-close" type="button" aria-label="بستن علاقه‌مندی‌ها" title="بستن">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="compare-panel-items" id="favoritesPanelItems"></div>
                    <a class="compare-panel-link" href="Profile/Favorites">مشاهدهٔ همهٔ علاقه‌مندی‌ها <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                </section>
            </div>
            <div class="compare-wrap" id="compareWrap">
                <a class="nav-shortcut compare-toggle" id="compareToggle" href="Compare" aria-label="مشاهده محصولات مقایسه" title="مقایسه محصولات">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                    <b class="nav-count" id="compareCount" aria-hidden="true">۰</b>
                </a>
                <section class="compare-panel" id="comparePanel" aria-label="فهرست مقایسه محصولات" aria-hidden="true">
                    <div class="compare-panel-head">
                        <span>
                            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                            <span class="compare-panel-title-copy">
                                <strong>مقایسه محصولات</strong><small class="compare-panel-count" id="comparePanelCount">۰ محصول</small>
                            </span>
                        </span>
                        <button class="compare-panel-close" type="button" aria-label="بستن مقایسه محصولات" title="بستن">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="compare-panel-items" id="comparePanelItems"></div>
                    <a class="compare-panel-link" href="/Compare">مشاهدهٔ همهٔ مقایسه‌ها <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                </section>
            </div>
            <div class="cart-wrap" id="cartWrap">
                <button class="cart-btn cart-icon-theme"
                        id="cartToggle"
                        type="button"
                        aria-label="مشاهده سبد خرید"
                        aria-expanded="false"
                        aria-controls="cartPanel">
                    <i class="bi bi-cart3"></i><b id="cartCount">۰</b>
                </button>
                <div class="cart-panel" id="cartPanel">
                    <span class="cart-sheet-handle" aria-hidden="true"></span>
                    <div class="cart-head">
                        <div class="cart-head-title">
                            <span class="cart-head-icon">
                                <i class="bi bi-bag-check"></i>
                            </span>
                            <span>
                                <strong>
                                    سبد خرید شما
                                </strong><small id="cartTitleCount">۰ محصول</small>
                            </span>
                        </div>
                        <button class="cart-panel-close" type="button" aria-label="بستن سبد خرید" title="بستن">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="cart-items ui-scrollbar ui-scrollbar--navy" id="cartItems">
                        <div class="empty-cart header-panel-empty">
                            <span class="empty-cart-icon header-panel-empty-icon">
                                <i class="bi bi-cart3" aria-hidden="true"></i>
                            </span><strong>سبد خرید شما خالی است</strong>
                            <p>برای شروع، یک محصول به سبد خرید اضافه کنید.</p>
                        </div>
                    </div>
                    <div class="cart-footer" id="cartFooter">
                        <div class="cart-total-summary">
                            <div class="cart-total-amount">
                                <span>مبلغ قابل پرداخت</span><strong id="cartTotal">۰ تومان</strong>
                            </div>
                            <div class="cart-safety-badge" role="note" aria-label="یادآوری بررسی شرایط محصول">
                                <span class="cart-safety-icon" aria-hidden="true">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <span class="cart-safety-copy">
                                    <strong>پیش از سفارش</strong><small>مشخصات و شرایط هر کالا را بررسی کنید.</small>
                                </span>
                                <i class="bi bi-check-circle-fill cart-safety-check" aria-hidden="true"></i>
                            </div>
                        </div>
                        <a href="#">
                            مشاهده سبد و تسویه
                            <i class="bi bi-arrow-left">
                            </i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>
</nav>
