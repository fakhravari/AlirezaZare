@inject Microsoft.Extensions.Options.IOptions<Shop.Models.SiteIdentityOptions> SiteIdentityOptions
@{
    string cdnBaseUrl = ViewData["MediaCdnBaseUrl"] as string ?? "";
    Shop.Models.SiteIdentityOptions identity = SiteIdentityOptions.Value;
    string fallbackSocialUrl = Url.Content("~/Contact");
    bool hasInstagramUrl = !string.IsNullOrWhiteSpace(identity.InstagramUrl);
    bool hasTelegramUrl = !string.IsNullOrWhiteSpace(identity.TelegramUrl);
    bool hasLinkedInUrl = !string.IsNullOrWhiteSpace(identity.LinkedInUrl);
    bool hasWhatsAppNumber = !string.IsNullOrWhiteSpace(identity.WhatsAppNumber);
}
<footer>
    <div class="container">
        <div class="row g-4 footer-main">
            <div class="col-lg-4">
                <a class="brand footer-brand" href="Home/Index#home" aria-label="@identity.VisualBrandName؛ مرجع تخصصی ابزار و تجهیزات برقی؛ رفتن به صفحهٔ اصلی">
                    <img class="footer-brand-logo" src="@(cdnBaseUrl)content/identity/store-electrical-lockup.svg" alt="@identity.VisualBrandName؛ مرجع تخصصی ابزار و تجهیزات برقی" width="360" height="120" decoding="async"/>
                </a>
                @if (!string.IsNullOrWhiteSpace(identity.FooterDescription)) { <p>@identity.FooterDescription</p> }
                <div class="socials" aria-label="شبکه‌های اجتماعی و راه‌های ارتباطی">
                    <a href="@(hasInstagramUrl ? identity.InstagramUrl : fallbackSocialUrl)" target="@(hasInstagramUrl ? "_blank" : null)" rel="@(hasInstagramUrl ? "noopener noreferrer" : null)" aria-label="اینستاگرام" title="اینستاگرام"><i class="bi bi-instagram" aria-hidden="true"></i><span class="visually-hidden">اینستاگرام</span></a>
                    <a href="@(hasWhatsAppNumber ? $"https://wa.me/{identity.WhatsAppNumber}" : fallbackSocialUrl)" target="@(hasWhatsAppNumber ? "_blank" : null)" rel="@(hasWhatsAppNumber ? "noopener noreferrer" : null)" aria-label="واتس‌اپ" title="واتس‌اپ"><i class="bi bi-whatsapp" aria-hidden="true"></i><span class="visually-hidden">واتس‌اپ</span></a>
                    <a href="@(hasTelegramUrl ? identity.TelegramUrl : fallbackSocialUrl)" target="@(hasTelegramUrl ? "_blank" : null)" rel="@(hasTelegramUrl ? "noopener noreferrer" : null)" aria-label="تلگرام" title="تلگرام"><i class="bi bi-telegram" aria-hidden="true"></i><span class="visually-hidden">تلگرام</span></a>
                    <a href="@(hasLinkedInUrl ? identity.LinkedInUrl : fallbackSocialUrl)" target="@(hasLinkedInUrl ? "_blank" : null)" rel="@(hasLinkedInUrl ? "noopener noreferrer" : null)" aria-label="لینکدین" title="لینکدین"><i class="bi bi-linkedin" aria-hidden="true"></i><span class="visually-hidden">لینکدین</span></a>
                    <a href="tel:@identity.SupportPhoneUri" aria-label="تماس تلفنی" title="تماس تلفنی"><i class="bi bi-telephone" aria-hidden="true"></i><span class="visually-hidden">تماس تلفنی</span></a>
                </div>
                <div class="trust-badges" aria-label="نمادهای اعتماد">
                    <a class="trust-badge-image enamad-link" referrerpolicy="origin" target="_blank" rel="noopener" href="https://trustseal.enamad.ir/?id=8270056&amp;Code=magw24ZAYJwl3ZjkoHJrQoG8tZ4dv7MC" aria-label="مشاهده نماد اعتماد الکترونیکی فروشگاه (پنجره جدید)">
                        <img referrerpolicy="origin" src="https://trustseal.enamad.ir/logo.aspx?id=8270056&amp;Code=magw24ZAYJwl3ZjkoHJrQoG8tZ4dv7MC" alt="نماد اعتماد الکترونیکی فروشگاه" code="magw24ZAYJwl3ZjkoHJrQoG8tZ4dv7MC"/>
                    </a>
                    <img class="trust-badge-image" src="@(cdnBaseUrl)content/trust/trust-kasbokar.webp" alt="مجوز کسب‌وکارهای مجازی" loading="lazy"/>
                    <img class="trust-badge-image" src="@(cdnBaseUrl)content/trust/trust-samandehi.webp" alt="نماد ساماندهی" loading="lazy"/>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h2>دسته‌بندی‌ها</h2>
                <a href="/search?product-group=power-tools">ابزار برقی</a>
                <a href="/search?product-group=measurement-tools">ابزار اندازه‌گیری</a>
                <a href="/search?product-group=soldering-and-board-repair">لحیم‌کاری و تعمیر برد</a>
                <a href="/search?product-group=lighting-and-lamps">روشنایی و لامپ</a>
            </div>
            <div class="col-6 col-lg-2">
                <h2>خدمات مشتریان</h2>
                <a href="/Tracking">
                    پیگیری سفارش
                </a>
                <a href="/Shipping">
                    شرایط ارسال
                </a>
                <a href="/Warranty">
                    ضمانت اصالت
                </a><a href="/Faq">پرسش‌های متداول</a>
                <a href="/Legal/Returns">رویه بازگرداندن کالا</a>
            </div>
            <div class="col-6 col-lg-2">
                <h2>کمپانی و قوانین</h2>
                <a href="Home/Index#story">
                    درباره مجموعه
                </a>
                <a href="Magazine">
                    مجله برق و ابزار
                </a><a href="Contact">تماس با ما</a>
                <a href="/Legal/Privacy">حریم خصوصی</a>
                <a href="/Legal/Terms">شرایط استفاده</a>
            </div>
            <div class="col-6 col-lg-2">
                <h2>راه‌های ارتباطی</h2>
                <a href="tel:@identity.SupportPhoneUri">
                    مدیریت: @identity.SupportPhoneDisplay
                </a>
                <a href="tel:@identity.SupportPhoneUri">
                    پشتیبانی: @identity.SupportPhoneDisplay
                </a>
            </div>
        </div>
        <div class="copyright">
            <span>
                © ۱۴۰۵ @identity.DisplayName؛ تمامی حقوق محفوظ است.
            </span><span>تخصص ما تأمین ابزار و تجهیزات فنی معتبر است.</span>
        </div>
    </div>
</footer>
