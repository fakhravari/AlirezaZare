<section class="newsletter">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow dark">سامانه اطلاع‌رسانی رسمی کمپانی</span>
                <h2>عضویت در باشگاه مشتریان ندا اولیائی</h2>
                <p>
                    اطلاعیه‌های رسمی موجودی محصولات، شرایط فروش، پیشنهادهای دوره‌ای و
                    راهنماهای تخصصی کمپانی را دریافت کنید.
                </p>
            </div>
            <div class="col-lg-5">
                <form id="newsletterForm" class="subscribe">
                    <input
                        dir="rtl"
                        type="email"
                        required
                        placeholder="نشانی ایمیل شما"
                        aria-label="نشانی ایمیل شما"/>
                    <button type="submit" aria-label="عضویت در باشگاه مشتریان">
                        <i class="bi bi-arrow-left"></i>
                    </button>
                </form>
                <small id="formMessage"></small>
            </div>
        </div>
    </div>
</section>
