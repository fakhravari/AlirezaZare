<section class="newsletter">
    <div class="container">
        <div class="row align-items-center g-3 g-lg-5">
            <div class="col-lg-7">
                <span class="eyebrow dark">به‌روزرسانی‌های فروشگاه</span>
                <h2>از تازه‌های محصولات باخبر شوید</h2>
                <p>
                    در حال حاضر ثبت‌نام خبرنامه فعال نیست. برای مشاهدهٔ محصولات و
                    راهنماهای فنی، محصولات و مجله را مرور کنید.
                </p>
            </div>
            <div class="col-lg-5">
                <form id="newsletterForm" class="subscribe">
                    <input
                        dir="rtl"
                        type="email"
                        required
                        placeholder="نشانی ایمیل شما"
                        aria-label="نشانی ایمیل شما"/>
                    <button type="submit" aria-label="بررسی وضعیت خبرنامه">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </button>
                </form>
                <small id="formMessage"></small>
            </div>
        </div>
    </div>
</section>
