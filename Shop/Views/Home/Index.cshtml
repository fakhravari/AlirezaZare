<section class="journal py-section" id="journal">
    <div class="container">
        <div
            class="section-head d-flex justify-content-between align-items-end mb-5">
            <div>
                <span class="eyebrow dark">مجله تخصصی برق و ابزار</span>
                <h2>راهنمای خرید و <em>کار با ابزار</em></h2>
            </div>
            <a asp-controller="Magazine" asp-action="Index">مشاهده همه مطالب <i class="bi bi-arrow-left"></i></a>
        </div>
        <div class="row g-4">
            <div class="col-md-6 journal-feature-column">
                <article class="journal-main">
                    <span class="journal-main-featured"><i class="bi bi-stars" aria-hidden="true"></i> انتخاب تحریریه</span>
                    <img
                        loading="lazy"
                        decoding="async"
                        src="~/Shop/images/products/tool-hammer-drill.png"
                        alt="راهنمای انتخاب دریل برای خانه و کارگاه"/>
                    <div>
                        <div class="journal-main-meta" aria-label="دسته‌بندی و اطلاعات مطلب">
                            <span class="journal-main-meta-copy">
                                <span class="journal-main-category"><i class="bi bi-bookmark-star" aria-hidden="true"></i> راهنمای خرید</span>
                                <span class="journal-main-read"><i class="bi bi-clock" aria-hidden="true"></i> ۸ دقیقه مطالعه</span>
                                <span class="journal-main-author"><i class="bi bi-person-circle" aria-hidden="true"></i> تحریریه ندا اولیائی</span>
                            </span>
                            <time datetime="2026-10-14"><i class="bi bi-calendar3" aria-hidden="true"></i> ۱۴۰۵/۰۷/۲۲</time>
                        </div>
                        <h3>
                            <a asp-controller="Magazine" asp-action="Details" asp-route-slug="choosing-work-drill" style="color: inherit; text-decoration: none;">راهنمای انتخاب دریل برای خانه و کارگاه</a>
                        </h3>
                        <a class="journal-main-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="choosing-work-drill">خواندن راهنما <i class="bi bi-arrow-left-circle-fill" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>
            <div class="col-md-6 journal-list-column">
                <div class="journal-list">
                    <div class="journal-list-heading">
                        <span class="journal-list-heading-icon"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i></span>
                        <div><small>مجلهٔ تخصصی برق و ابزار</small><strong>منتخب راهنماها</strong></div>
                        <span class="journal-list-count"><b>۵</b> مطلب کاربردی</span>
                    </div>
                    @{ var metric1 = JournalArticles.GetMetrics("multimeter-buying-guide"); }
                    <article>
                        <span class="journal-list-number">۱</span>
                        <div class="journal-list-card-meta">
                            <small>راهنمای خرید</small>
                            <span class="journal-list-pick"><i class="bi bi-stars" aria-hidden="true"></i> پیشنهاد تحریریه</span>
                        </div>
                        <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="multimeter-buying-guide" style="color: inherit; text-decoration: none;">چطور مولتی‌متر مناسب انتخاب کنیم؟</a></h4>
                        <div class="journal-list-reading journal-list-stats" aria-label="آمار مقاله">
                            <span class="journal-metric" title="بازدید"><i class="bi bi-eye" aria-hidden="true"></i><span>@PersianNumber(metric1.Views)</span><small>بازدید</small></span>
                            <span class="journal-metric journal-like-metric" title="پسند"><i class="bi bi-heart-fill" aria-hidden="true"></i><span>@PersianNumber(metric1.Likes)</span><small>پسند</small></span>
                            <span class="journal-metric" title="میانگین امتیاز"><i class="bi bi-star-fill" aria-hidden="true"></i><span>@PersianRating(metric1.AverageRating)</span><small>امتیاز</small></span>
                        </div>
                        <a class="journal-list-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="multimeter-buying-guide" aria-label="خواندن راهنمای انتخاب مولتی‌متر"><span>خواندن راهنما</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    </article>
                    @{ var metric2 = JournalArticles.GetMetrics("electrical-tool-safety"); }
                    <article>
                        <span class="journal-list-number">۲</span>
                        <div class="journal-list-card-meta">
                            <small>ایمنی و نگهداری</small>
                        </div>
                        <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="electrical-tool-safety" style="color: inherit; text-decoration: none;">چک‌لیست ایمنی هنگام کار با ابزار برقی</a></h4>
                        <div class="journal-list-reading journal-list-stats" aria-label="آمار مقاله">
                            <span class="journal-metric" title="بازدید"><i class="bi bi-eye" aria-hidden="true"></i><span>@PersianNumber(metric2.Views)</span><small>بازدید</small></span>
                            <span class="journal-metric journal-like-metric" title="پسند"><i class="bi bi-heart-fill" aria-hidden="true"></i><span>@PersianNumber(metric2.Likes)</span><small>پسند</small></span>
                            <span class="journal-metric" title="میانگین امتیاز"><i class="bi bi-star-fill" aria-hidden="true"></i><span>@PersianRating(metric2.AverageRating)</span><small>امتیاز</small></span>
                        </div>
                        <a class="journal-list-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="electrical-tool-safety" aria-label="خواندن چک‌لیست ایمنی ابزار برقی"><span>خواندن راهنما</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    </article>
                    @{ var metric3 = JournalArticles.GetMetrics("soldering-station-basics"); }
                    <article>
                        <span class="journal-list-number">۳</span>
                        <div class="journal-list-card-meta">
                            <small>آموزش تخصصی</small>
                        </div>
                        <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="soldering-station-basics" style="color: inherit; text-decoration: none;">راهنمای انتخاب ایستگاه لحیم‌کاری</a></h4>
                        <div class="journal-list-reading journal-list-stats" aria-label="آمار مقاله">
                            <span class="journal-metric" title="بازدید"><i class="bi bi-eye" aria-hidden="true"></i><span>@PersianNumber(metric3.Views)</span><small>بازدید</small></span>
                            <span class="journal-metric journal-like-metric" title="پسند"><i class="bi bi-heart-fill" aria-hidden="true"></i><span>@PersianNumber(metric3.Likes)</span><small>پسند</small></span>
                            <span class="journal-metric" title="میانگین امتیاز"><i class="bi bi-star-fill" aria-hidden="true"></i><span>@PersianRating(metric3.AverageRating)</span><small>امتیاز</small></span>
                        </div>
                        <a class="journal-list-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="soldering-station-basics" aria-label="خواندن راهنمای ایستگاه لحیم‌کاری"><span>خواندن راهنما</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    </article>
                    @{ var metric4 = JournalArticles.GetMetrics("worklight-selection"); }
                    <article>
                        <span class="journal-list-number">۴</span>
                        <div class="journal-list-card-meta">
                            <small>راهنمای خرید</small>
                        </div>
                        <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="worklight-selection" style="color: inherit; text-decoration: none;">انتخاب چراغ کار برای تعمیرگاه و محیط نصب</a></h4>
                        <div class="journal-list-reading journal-list-stats" aria-label="آمار مقاله">
                            <span class="journal-metric" title="بازدید"><i class="bi bi-eye" aria-hidden="true"></i><span>@PersianNumber(metric4.Views)</span><small>بازدید</small></span>
                            <span class="journal-metric journal-like-metric" title="پسند"><i class="bi bi-heart-fill" aria-hidden="true"></i><span>@PersianNumber(metric4.Likes)</span><small>پسند</small></span>
                            <span class="journal-metric" title="میانگین امتیاز"><i class="bi bi-star-fill" aria-hidden="true"></i><span>@PersianRating(metric4.AverageRating)</span><small>امتیاز</small></span>
                        </div>
                        <a class="journal-list-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="worklight-selection" aria-label="خواندن راهنمای انتخاب چراغ کار"><span>خواندن راهنما</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    </article>
                    @{ var metric5 = JournalArticles.GetMetrics("battery-tool-care"); }
                    <article>
                        <span class="journal-list-number">۵</span>
                        <div class="journal-list-card-meta">
                            <small>ایمنی و نگهداری</small>
                        </div>
                        <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="battery-tool-care" style="color: inherit; text-decoration: none;">نگهداری باتری ابزار شارژی</a></h4>
                        <div class="journal-list-reading journal-list-stats" aria-label="آمار مقاله">
                            <span class="journal-metric" title="بازدید"><i class="bi bi-eye" aria-hidden="true"></i><span>@PersianNumber(metric5.Views)</span><small>بازدید</small></span>
                            <span class="journal-metric journal-like-metric" title="پسند"><i class="bi bi-heart-fill" aria-hidden="true"></i><span>@PersianNumber(metric5.Likes)</span><small>پسند</small></span>
                            <span class="journal-metric" title="میانگین امتیاز"><i class="bi bi-star-fill" aria-hidden="true"></i><span>@PersianRating(metric5.AverageRating)</span><small>امتیاز</small></span>
                        </div>
                        <a class="journal-list-cta" asp-controller="Magazine" asp-action="Details" asp-route-slug="battery-tool-care" aria-label="خواندن راهنمای نگهداری باتری ابزار شارژی"><span>خواندن راهنما</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    </article>
                </div>
            </div>
        </div>
    </div>
</section>

