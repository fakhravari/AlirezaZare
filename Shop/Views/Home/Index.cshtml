@using System.Globalization
@model PageModel

@section Hero {
    <partial name="_Hero"/>
}


<main id="home-main-content">
    <section class="home-sales-plans" id="homeSalesTime" aria-label="پیشنهادهای دیجی‌تایم" hidden>
        <div class="container" id="homeSalesTimeContent"></div>
    </section>

    <partial name="_Collection"/>

    <partial name="_Offers"/>

    <partial name="_Bestsellers"/>

    <partial name="_Newest"/>

    <partial name="_Brands"/>


    <partial name="_Testimonials"/>

    <partial name="_PurchaseBenefits"/>

    <section class="journal py-section" id="journal">
        <div class="container">
            <div class="section-head d-flex justify-content-between align-items-end mb-md-5">
                <div>
                    <span class="eyebrow dark">مجله تخصصی برق و ابزار</span>
                    <h2>راهنمای خرید و <em>کار با ابزار</em></h2>
                </div>
                <a asp-controller="Magazine" asp-action="Index">مشاهده همه مطالب <i class="bi bi-arrow-left"></i></a>
            </div>
            @if (Model is PageModel<MagazineIndexViewModel> page && page.Data.Posts.Count > 0)
            {
                var posts = page.Data.Posts.Take(6).ToArray();
                var lead = posts[0];
                <div class="row g-4">
                    <div class="col-md-6 journal-feature-column">
                        <article class="journal-main">
                            <div class="journal-main-featured-meta">
                                <span class="journal-main-featured"><i class="bi bi-stars" aria-hidden="true"></i> تازه‌ترین راهنما</span>
                            </div>
                            <img loading="lazy" decoding="async" src="@lead.Image" alt="@lead.Title"/>
                            <div>
                                <div class="journal-main-meta" aria-label="دسته‌بندی و اطلاعات مطلب">
                                    <span class="journal-main-meta-copy">
                                        <span class="journal-main-category"><i class="bi bi-bookmark-star" aria-hidden="true"></i> @lead.Category</span>
                                        <span class="journal-main-read"><i class="bi bi-clock" aria-hidden="true"></i> @lead.ReadMinutes دقیقه مطالعه</span>
                                    </span>
                                </div>
                                <h3><a asp-controller="Magazine" asp-action="Details" asp-route-slug="@lead.Slug">@lead.Title</a></h3>
                                <p>@lead.Summary</p>
                            </div>
                        </article>
                    </div>
                    <div class="col-md-6 journal-list-column">
                        <div class="journal-list">
                            <div class="journal-list-heading">
                                <span class="journal-list-heading-icon"><i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i></span>
                                <div><small>مجلهٔ تخصصی برق و ابزار</small><strong>منتخب راهنماها</strong></div>
                                <span class="journal-list-count"><b>@posts.Skip(1).Count()</b> مطلب کاربردی</span>
                            </div>
                            @foreach (var (post, index) in posts.Skip(1).Select((post, index) => (post, index: index + 1)))
                            {
                                <article>
                                    <span class="journal-list-number">@index</span>
                                    <div class="journal-list-card-meta"><small>@post.Category</small></div>
                                    <h4><a asp-controller="Magazine" asp-action="Details" asp-route-slug="@post.Slug">@post.Title</a></h4>
                                    <div class="journal-list-stats" aria-label="زمان مطالعه">
                                        <span class="journal-metric"><i class="bi bi-clock" aria-hidden="true"></i><small>@post.ReadMinutes دقیقه</small></span>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="journal-empty-state">مطالب مجله به‌زودی منتشر می‌شوند.</p>
            }
        </div>
    </section>
    <partial name="_Newsletter"/>
</main>

@section PageStyles {
    <link href="~/shop/css/pages/home-warmth.css" rel="stylesheet" asp-append-version="true"/>
}

@section HomeStyles {
    <link href="~/shop/css/pages/home-collection.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/home-brands.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/home-testimonials.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/home-sales-plans.js" asp-append-version="true"></script>
}
