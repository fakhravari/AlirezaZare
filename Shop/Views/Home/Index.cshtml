@model PageModel

@section Hero {
    <section class="electrical-showcase" aria-label="دسته‌بندی و پیشنهادهای فروشگاه">
        <div class="electrical-home-row">
            <aside class="electrical-category-menu" id="productCategories" aria-label="مگامنوی دسته‌بندی قطعات">
                <div class="electrical-category-heading"><span><i class="bi bi-list"></i></span> دسته‌بندی قطعات</div>
                <button class="active" type="button" data-category="tools" aria-expanded="false"><i class="bi bi-lightning-charge"></i><span>ابزار برقی</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="hand-tools" aria-expanded="false"><i class="bi bi-tools"></i><span>ابزار دستی</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="components" aria-expanded="false"><i class="bi bi-cpu"></i><span>قطعات الکترونیکی</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="cables" aria-expanded="false"><i class="bi bi-plug"></i><span>سیم، کابل و اتصالات</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="lighting" aria-expanded="false"><i class="bi bi-lightbulb"></i><span>روشنایی و لامپ</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="switchgear" aria-expanded="false"><i class="bi bi-toggle-on"></i><span>کلید و تجهیزات برقی</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="safety" aria-expanded="false"><i class="bi bi-shield-check"></i><span>ایمنی و حفاظت</span><i class="bi bi-chevron-left"></i></button>
                <button type="button" data-category="measurement" aria-expanded="false"><i class="bi bi-speedometer2"></i><span>اندازه‌گیری</span><i class="bi bi-chevron-left"></i></button>
                <div class="electrical-submenu" id="electricalSubmenu" hidden></div>
            </aside>
        <div id="heroSwiper" class="swiper hero-swiper electrical-swiper">
            <div class="swiper-wrapper">
                <article class="swiper-slide electrical-slide electrical-slide-tools">
                    <img class="electrical-banner-image" src="Shop/images/banners/electrical-tools.png" alt="ابزار برقی، دریل و تجهیزات اندازه‌گیری" fetchpriority="high"/>
                    <div class="electrical-copy">
                        <span class="electrical-kicker"><i class="bi bi-lightning-charge-fill"></i> انتخاب حرفه‌ای‌ها</span>
                        <h1>ابزار برقی،<br/><em>قدرتِ انجام کار</em></h1>
                        <p>دریل، فرز، دستگاه جوش و ابزارهای کارگاهی از برندهای معتبر، همراه با ضمانت و ارسال سریع.</p>
                        <a class="electrical-cta" href="Search">مشاهده ابزارها <i class="bi bi-arrow-left"></i></a>
                    </div>
                    <span class="electrical-slide-index">01 <i></i> 03</span>
                </article>
                <article class="swiper-slide electrical-slide electrical-slide-parts">
                    <img class="electrical-banner-image" src="Shop/images/banners/electrical-components.png" alt="قطعات الکترونیکی و برد مدار چاپی" loading="lazy"/>
                    <div class="electrical-copy">
                        <span class="electrical-kicker"><i class="bi bi-cpu-fill"></i> دنیای قطعات الکترونیک</span>
                        <h2>قطعه‌ی درست،<br/><em>مدارِ مطمئن</em></h2>
                        <p>انواع مقاومت، خازن، آی‌سی، رله و ماژول‌های کاربردی برای تعمیرکاران و سازندگان.</p>
                        <a class="electrical-cta" href="Search">خرید قطعات <i class="bi bi-arrow-left"></i></a>
                    </div>
                    <span class="electrical-slide-index">02 <i></i> 03</span>
                </article>
                <article class="swiper-slide electrical-slide electrical-slide-lighting">
                    <img class="electrical-banner-image" src="Shop/images/banners/electrical-lighting.png" alt="لامپ‌های LED، چراغ کارگاهی و کابل برق" loading="lazy"/>
                    <div class="electrical-copy">
                        <span class="electrical-kicker"><i class="bi bi-lightbulb-fill"></i> روشنایی کم‌مصرف</span>
                        <h2>نور بهتر،<br/><em>مصرف کمتر</em></h2>
                        <p>لامپ LED، پنل و چراغ‌های کارگاهی برای خانه، فروشگاه و محیط‌های صنعتی.</p>
                        <a class="electrical-cta" href="Search">دیدن محصولات روشنایی <i class="bi bi-arrow-left"></i></a>
                    </div>
                    <span class="electrical-slide-index">03 <i></i> 03</span>
                </article>
            </div>
            <button class="electrical-arrow electrical-prev" type="button" aria-label="اسلاید قبلی"><i class="bi bi-chevron-right"></i></button>
            <button class="electrical-arrow electrical-next" type="button" aria-label="اسلاید بعدی"><i class="bi bi-chevron-left"></i></button>
            <div class="swiper-pagination" aria-label="انتخاب اسلاید"></div>
        </div>
        </div>
    </section>
}




