@using Shop.Controllers
@using System.Globalization
@{
    var reviews = ViewData["HomeReviews"] as IReadOnlyList<HomeReviewCard> ?? [];
    var average = ViewData["HomeReviewAverage"] as double? ?? 0;
    var reviewCount = ViewData["HomeReviewCount"] as int? ?? 0;
    var persianCulture = CultureInfo.GetCultureInfo("fa-IR");
}
<section class="testimonials py-section" id="testimonials">
    <div class="container">
        <div class="testimonial-intro">
            <div>
                <span class="eyebrow dark">تجربه خرید از ندا اولیائی</span>
                <h2>آنچه مشتریان ما <em>می‌گویند</em></h2>
            </div>
            <div class="testimonial-tools">
                <div class="rating-summary">
                    <div class="rating-score">@(reviewCount == 0 ? "—" : average.ToString("0.0", CultureInfo.InvariantCulture))</div>
                    <div>
                        <div class="rating-stars" role="img" aria-label="امتیاز میانگین @average از ۵">
                            @for (var star = 0; star < 5; star++)
                            {
                                <i class="bi @(star < Math.Round(average) ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                            }
                        </div>
                        @if (reviewCount > 0)
                        {
                            <strong>بر پایهٔ @reviewCount نظر تأییدشده</strong>
                            <span>کیفیت، اصالت و همراهی تا انتخاب نهایی</span>
                        }
                        else
                        {
                            <strong>هنوز نظری تأیید نشده است</strong>
                            <span>پس از تأیید دیدگاه‌ها، نظر خریداران اینجا نمایش داده می‌شود.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="testimonial-slider-wrap">
            <div class="testimonial-grid testimonial-slider" id="testimonialSlider">
                @foreach (var (review, index) in reviews.Select((review, index) => (review, index)))
                {
                    <article class="testimonial-card @(index == 0 ? "featured-review" : "")">
                        <span class="quote-mark" aria-hidden="true"><i class="bi bi-chat-quote-fill"></i></span>
                        <div class="rating-stars" role="img" aria-label="@review.Rating ستاره از ۵">
                            @for (var star = 0; star < review.Rating; star++)
                            {
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                            }
                        </div>
                        <p>@review.Text</p>
                        <div class="reviewer">
                            <span class="reviewer-avatar avatar-navy" aria-hidden="true">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <div>
                                <strong>@review.DisplayName</strong>
                                <small>خریدار @review.ProductName</small>
                                <time class="review-date" datetime="@review.CreatedAtUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <span>@review.CreatedAtUtc.ToString("yyyy/MM/dd", persianCulture)</span>
                                </time>
                            </div>
                        </div>
                    </article>
                }
                @if (reviews.Count == 0)
                {
                    <p class="text-muted">هنوز دیدگاه تأییدشده‌ای برای نمایش ثبت نشده است.</p>
                }
            </div>
        </div>
    </div>
</section>
