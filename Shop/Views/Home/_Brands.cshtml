@using Shop.Models
@{
    IReadOnlyList<BrandProfileModel> brands = ViewData["HomeBrands"] as IReadOnlyList<BrandProfileModel> ?? Array.Empty<BrandProfileModel>();
    string cdnBaseUrl = ViewData["MediaCdnBaseUrl"] as string ?? "";
}
@if (brands.Count > 0)
{
    <section class="brands-section" id="brands" aria-labelledby="brandsTitle">
        <div class="container">
            <div class="brands-heading">
                <span class="brands-line"></span>
                <h2 id="brandsTitle">برندهای موجود</h2>
                <span class="brands-line"></span>
            </div>
            <div class="brands-slider" id="brandsSlider">
                @foreach (BrandProfileModel brand in brands)
                {
                    <div class="brand-card-shell">
                        <a class="brand-card" href="@Url.Content($"~/search?brand={brand.Slug}")" aria-label="مشاهده محصولات @brand.PersianName">
                            <span class="brand-logo-frame">
                                @if (!string.IsNullOrWhiteSpace(brand.LogoFile))
                                {
                                    <img class="brand-logo-image" src="@(cdnBaseUrl)content/brands/@brand.LogoFile" alt="لوگوی @brand.Name" loading="lazy" decoding="async">
                                }
                                else
                                {
                                    <span class="brand-wordmark">@brand.Name</span>
                                }
                            </span>
                            <strong>@brand.PersianName</strong>
                        </a>
                        <a class="brand-card-detail" href="@Url.Content($"~/brands/{brand.Slug}")" aria-label="جزئیات برند @brand.PersianName" title="جزئیات برند @brand.PersianName">
                            <i class="bi bi-info-circle" aria-hidden="true"></i><span class="visually-hidden">جزئیات برند @brand.PersianName</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}