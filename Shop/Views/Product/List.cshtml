@model PageModel

<header class="page-hero search-intro">
    <div class="container">
        <nav class="cart-breadcrumb taxonomy-breadcrumb" id="searchBreadcrumb" aria-label="مسیر صفحه">
            <ol>
                <li>
                    <a href="/">
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                    </a>
                </li>
                <li class="cart-breadcrumb-current">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page">ابزار و تجهیزات</span>
                </li>
            </ol>
        </nav>
        <h1>جستجو و انتخاب ابزار <em>دقیق‌تر</em></h1>
        <p>
            با ترکیب چند فیلتر، سریع‌تر به ابزار متناسب با بودجه، توان موردنیاز و
            محیط استفاده خود برسید.
        </p>
        <div class="hero-trail" aria-label="امکانات جستجوی محصولات">
            <span>فیلترهای دقیق</span>
            <span>انتخاب متناسب با نیاز</span>
            <span>بررسی مشخصات و قیمت</span>
        </div>
    </div>
</header>

<main class="search-main search-page container">
    <button
        class="mobile-filter-toggle"
        id="mobileFilterToggle"
        type="button"
        aria-controls="filterPanel"
        aria-expanded="false">
        <i class="bi bi-sliders" aria-hidden="true"></i> فیلتر پیشرفته
        <span id="activeFilterCount">۰</span>
    </button>
    <aside class="filter-panel" id="filterPanel">
        <div class="filter-head">
            <div class="filter-head-copy">
                <span class="filter-head-title">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    فیلتر محصولات
                </span>
                <small>
                    <b id="filterResultCount">۰</b>
                    <span>محصول پیدا شد</span>
                </small>
            </div>
            <button id="closeFilters" type="button" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <button class="clear-filters" id="clearFilters" type="button" hidden>
            <i class="bi bi-arrow-counterclockwise"></i> پاک‌کردن همه فیلترها
        </button>
        <label class="filter-option filter-stock-option" for="availabilityFilter">
            <span>وضعیت موجودی</span>
            <select id="availabilityFilter" name="available">
                <option value="all">همهٔ کالاها</option>
                <option value="in-stock">کالاهای موجود</option>
                <option value="out-of-stock">کالاهای ناموجود</option>
            </select>
        </label>
        <label class="filter-option filter-discount-option" for="discountFilter">
            <span><i class="bi bi-tags" aria-hidden="true"></i> فقط کالاهای تخفیف‌دار</span>
            <input id="discountFilter" name="discounted" type="checkbox" value="1" />
        </label>
        <div class="filter-group" data-filter-fa="برند" data-filter-en="Brand" data-filter-slug="brand">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="برند" data-filter-en="Brand" data-filter-slug="brand">
                    <i class="bi bi-patch-check" aria-hidden="true"></i><span>برند</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="filter-options" id="brandFilters"></div>
        </div>
        <div class="filter-group" data-filter-fa="گروه محصول" data-filter-en="Product group" data-filter-slug="product-group">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="گروه محصول" data-filter-en="Product group" data-filter-slug="product-group">
                    <i class="bi bi-tools" aria-hidden="true"></i><span>گروه محصول</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="filter-options" id="typeFilters"></div>
        </div>
        <div class="filter-group" data-filter-fa="نوع تغذیه" data-filter-en="Power type" data-filter-slug="power-type">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="نوع تغذیه" data-filter-en="Power type" data-filter-slug="power-type">
                    <i class="bi bi-lightning-charge" aria-hidden="true"></i><span>نوع تغذیه</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="filter-options" id="movementFilters"></div>
        </div>
        <div class="filter-group" data-filter-fa="محیط کاربرد" data-filter-en="Application environment" data-filter-slug="application-environment">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="محیط کاربرد" data-filter-en="Application environment" data-filter-slug="application-environment">
                    <i class="bi bi-building-gear" aria-hidden="true"></i><span>محیط کاربرد</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="filter-options" id="strapFilters"></div>
        </div>
        <div class="filter-group" data-filter-fa="رنگ" data-filter-en="Color" data-filter-slug="color">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="رنگ" data-filter-en="Color" data-filter-slug="color">
                    <i class="bi bi-palette2" aria-hidden="true"></i><span>رنگ</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="filter-options" id="colorFilters"></div>
        </div>
        <div class="filter-group" data-filter-fa="بازه قیمت تومان" data-filter-en="Price range Toman" data-filter-slug="price-range">
            <button type="button" aria-expanded="false">
                <span class="filter-group-title" data-filter-fa="بازه قیمت تومان" data-filter-en="Price range Toman" data-filter-slug="price-range">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i><span>بازه قیمت (تومان)</span>
                </span>
                <span class="filter-group-arrow">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </span>
            </button>
            <div class="price-filter">
                <div class="price-filter-values" aria-live="polite">
                    <span>از <b id="minPriceLabel">۰</b></span>
                    <span>تا <b id="maxPriceLabel">۶۰</b> میلیون تومان</span>
                </div>
                <div class="price-range" dir="ltr" style="--range-start: 0%; --range-end: 100%">
                    <div class="price-range-track" aria-hidden="true"></div>
                    <label class="ui-sr-only" for="minPrice">حداقل قیمت به میلیون تومان</label>
                    <input id="minPrice" class="price-range-input price-range-min" type="range" dir="rtl" min="0" max="60" value="0" step="1" aria-label="حداقل قیمت به میلیون تومان" />
                    <label class="ui-sr-only" for="maxPrice">حداکثر قیمت به میلیون تومان</label>
                    <input id="maxPrice" class="price-range-input price-range-max" type="range" dir="rtl" min="0" max="60" value="60" step="1" aria-label="حداکثر قیمت به میلیون تومان" />
                </div>
            </div>
        </div>
    </aside>
    <div class="filter-backdrop" id="filterBackdrop"></div>

    <section class="results-area">
        <div class="results-toolbar">
            <div class="search-box">
                <i class="bi bi-search" aria-hidden="true">
                </i
                >
                <label class="ui-sr-only" for="productSearch">
                    جستجو در محصولات
                </label
                >
                <input
                    id="productSearch"
                    type="search"
                    placeholder="جستجو در نام، برند یا ویژگی..."
                    autocomplete="off"/>
            </div>
            <div class="sort-box">
                <span class="sort-label" id="sortProductsLabel"><i class="bi bi-arrow-down-up" aria-hidden="true"></i> مرتب‌سازی بر اساس:</span>
                <div class="sort-options" role="radiogroup" aria-labelledby="sortProductsLabel">
                    <label class="sort-option">
                        <input type="radio" name="productSort" value="recommended" checked />
                        <span>محبوب‌ترین</span>
                    </label>
                    <label class="sort-option">
                        <input type="radio" name="productSort" value="newest" />
                        <span>جدیدترین</span>
                    </label>
                    <label class="sort-option">
                        <input type="radio" name="productSort" value="low" />
                        <span>ارزان‌ترین</span>
                    </label>
                    <label class="sort-option">
                        <input type="radio" name="productSort" value="high" />
                        <span>گران‌ترین</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="results-summary" hidden>
            <p><b id="resultCount">۰</b> محصول پیدا شد</p>
            <div class="active-chips" id="activeChips"></div>
        </div>
        <div class="product-results search-page-results" id="productResults"></div>
        <div class="empty-results empty-state-card" id="emptyResults" hidden>
            <i class="bi bi-search"></i>
            <h2>محصولی پیدا نشد</h2>
            <p>فیلترها را تغییر دهید یا همه فیلترها را پاک کنید.</p>
            <button type="button">پاک‌کردن فیلترها</button>
        </div>
        <div class="load-more-state" id="loadMoreState">
            <span class="loader"></span>
            <p>در حال بارگذاری محصولات بیشتر...</p>
        </div>
        <div class="results-end" id="resultsEnd" role="status" hidden>
            <div class="end-icon" aria-hidden="true">
                <i class="bi bi-check2"></i>
            </div>
            <div>
                <strong>به پایان نتایج رسیدید</strong>
                <p>
                    هر <b id="endResultCount">۰</b> محصول مطابق انتخاب شما نمایش داده شد.
                </p>
            </div>
        </div>
        <div id="loadMoreSentinel" aria-hidden="true"></div>
    </section>
</main>

<partial name="_PurchaseBenefits"/>

<div class="search-toast" id="searchToast" role="status"></div>
<style>
      .search-toast {
        position: fixed;
        z-index: 3000;
        right: 24px;
        bottom: 24px;
        left: auto;
        width: min(340px, calc(100vw - 48px));
        padding: 14px 17px;
        border: 1px solid rgba(213, 182, 124, 0.55);
        border-radius: 12px;
        background: var(--color-navy);
        color: #fff;
        box-shadow: 0 15px 35px rgba(3, 13, 35, 0.25);
        font: 600 12px/1.8 var(--font-body);
        text-align: right;
        direction: rtl;
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition: 0.25s;
      }
      .search-toast.show {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
      @@media (max-width: 575px) {
        .search-toast {
          right: 12px;
          bottom: 12px;
          left: auto;
          width: min(340px, calc(100vw - 24px));
        }
      }
    </style>
<style>
      .results-summary[hidden] {
        display: none !important;
      }
      .header-cart {
        padding: 0;
      }
      .search-cart-backdrop {
        position: fixed;
        z-index: 2190;
        inset: 0;
        background: rgba(3, 13, 35, 0.55);
        opacity: 0;
        visibility: hidden;
        transition: 0.25s;
      }
      .search-cart-backdrop.open {
        opacity: 1;
        visibility: visible;
      }
      .search-cart-drawer {
        position: fixed;
        z-index: 2200;
        top: 0;
        bottom: 0;
        left: 0;
        width: min(390px, 92vw);
        background: var(--color-surface);
        color: var(--color-ink);
        box-shadow: 18px 0 55px rgba(3, 13, 35, 0.3);
        opacity: 0;
        visibility: hidden;
        transform: translateX(-105%);
        transition: 0.32s;
      }
      .search-cart-drawer.open {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
      .search-cart-head {
        display: flex;
        min-height: 82px;
        padding: 0 20px;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(
          135deg,
          var(--color-blue),
          var(--color-navy)
        );
        color: #fff;
      }
      .search-cart-head span {
        display: flex;
        flex-direction: column;
      }
      .search-cart-head small {
        margin-top: 3px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 10px;
      }
      .search-cart-head button {
        width: 38px;
        height: 38px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }
      .search-cart-items {
        max-height: calc(100dvh - 190px);
        padding: 12px;
        overflow: auto;
      }
      .search-cart-item {
        display: grid;
        padding: 10px;
        grid-template-columns: 62px 1fr auto;
        gap: 11px;
        align-items: center;
        border-bottom: 1px solid #ded4c6;
      }
      .search-cart-item img {
        width: 62px;
        height: 68px;
        border-radius: 9px;
        object-fit: cover;
      }
      .search-cart-item span {
        display: flex;
        flex-direction: column;
      }
      .search-cart-item strong {
        font-size: 12px;
      }
      .search-cart-item small {
        margin-top: 5px;
        color: #926a35;
        font-size: 10px;
      }
      .search-cart-item > b {
        font-size: 10px;
      }
      .search-cart-empty {
        display: flex;
        min-height: 270px;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #788290;
      }
      .search-cart-empty i {
        margin-bottom: 12px;
        color: var(--color-blue);
        font-size: 38px;
      }
      .search-cart-footer {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        padding: 16px 18px;
        background: #f1e9dd;
      }
      .search-cart-footer > div {
        display: flex;
        margin-bottom: 12px;
        justify-content: space-between;
        font-size: 11px;
      }
      .search-cart-footer strong {
        color: var(--color-blue);
        font-size: 14px;
      }
      .search-cart-footer > button {
        width: 100%;
        min-height: 46px;
        border: 0;
        border-radius: 11px;
        background: var(--color-blue);
        color: #fff;
        font-weight: 700;
      }
      @@media (min-width: 992px) {
        .search-cart-backdrop {
          display: none;
        }
        .search-cart-drawer {
          top: 92px;
          bottom: auto;
          left: 24px;
          width: 410px;
          height: min(560px, calc(100dvh - 116px));
          max-height: calc(100dvh - 116px);
          overflow: hidden;
          border-radius: 22px;
          opacity: 0;
          visibility: hidden;
          transform: translateY(12px) scale(0.985);
          transform-origin: top left;
          pointer-events: none;
          transition:
            opacity 0.24s ease,
            visibility 0.24s ease,
            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .search-cart-drawer.open {
          opacity: 1;
          visibility: visible;
          transform: none;
          pointer-events: auto;
        }
        .search-cart-items {
          max-height: calc(100% - 190px);
        }
      }
    </style>


@section SearchStyles {
    <link href="~/shop/css/pages/search.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/search.js" asp-append-version="true"></script>

}
