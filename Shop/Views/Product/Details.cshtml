@model PageModel<ProductDetailsModel>


<main class="product-detail-page">
    <header class="page-hero product-detail-hero">
        <img class="hero-image" src="@Model.Seo.ImageUrl" alt="@Model.Data.Name" width="1254" height="1254" fetchpriority="high" />
        <div class="container">
            <nav class="cart-breadcrumb taxonomy-breadcrumb" aria-label="مسیر صفحه">
                <ol>
                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                        </a>
                    </li>
                    <li class="cart-breadcrumb-current">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page"><i class="bi bi-tools" aria-hidden="true"></i><span class="product-breadcrumb-label">@(Model.Data.Name ?? "جزئیات محصول")</span></span>
                    </li>
                </ol>
            </nav>
            <h1 id="productPageTitle">@(Model.Data.Name ?? "جزئیات محصول")</h1>
            <p>@Model.Seo.Description</p>
            <div class="hero-trail" aria-label="اطلاعات محصول">
                <span>مشخصات فنی</span>
                <span>قیمت و موجودی</span>
                <span>شرایط ضمانت کالا</span>
            </div>
        </div>
    </header>

    <section class="flow-main container">
        <div id="productView"></div>
        <partial name="_RelatedLinks"/>
    </section>
</main>

<partial name="_PurchaseBenefits"/>

@section Styles {
    <link href="~/shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/product-detail.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/form-confirm-dialog.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/form-confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/page-content.js" asp-append-version="true"></script>
}

@section PageStyles {
    <link href="~/shop/css/pages/product-detail-pricing.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/product-detail-options.css" rel="stylesheet" asp-append-version="true"/>
}
