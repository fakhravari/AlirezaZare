@model PageModel


<main class="flow-main container">
    <nav class="cart-breadcrumb" aria-label="مسیر صفحه">
        <ol>
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                </a>
            </li>
            <li class="cart-breadcrumb-current">
                <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page"><i class="bi bi-heart" aria-hidden="true"></i>علاقه‌مندی‌ها</span>
            </li>
        </ol>
    </nav>
    <header class="flow-heading">
        <span>فهرست شخصی شما</span>
        <h1>علاقه‌مندی‌ها</h1>
        <p>کالاهای ذخیره‌شده را یک‌جا مرور و با مشخصات نیازتان مقایسه کنید.</p>
    </header>
    <div id="favoritesView" aria-live="polite"><section class="flow-card flow-empty empty-state-card"><i class="bi bi-heart" aria-hidden="true"></i><h2>هنوز کالایی ذخیره نشده است</h2><p>در صفحهٔ محصولات، گزینهٔ علاقه‌مندی را انتخاب کنید تا کالاهای موردنظر اینجا نمایش داده شوند. این فهرست در همین مرورگر نگهداری می‌شود.</p><a class="flow-button" asp-controller="Product" asp-action="List">مرور محصولات</a></section></div>
    <partial name="_RelatedLinks"/>
</main>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
