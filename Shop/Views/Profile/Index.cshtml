@model PageModel

@{
    var profileSection = Context.Request.Path.Value?.TrimEnd('/').Split('/').LastOrDefault();
    var profileTitle = profileSection switch
    {
        "Orders" => "سفارش‌های من",
        "Addresses" => "آدرس‌های من",
        "Favorites" => "علاقه‌مندی‌ها",
        _ => "پروفایل من"
    };
    var profileIcon = profileSection switch
    {
        "Orders" => "bi-bag-check",
        "Addresses" => "bi-geo-alt",
        "Favorites" => "bi-heart",
        _ => "bi-person"
    };
}

<main class="flow-main container">
<nav class="cart-breadcrumb profile-breadcrumb" aria-label="مسیر صفحه">
    <ol>
        <li>
            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
            </a>
        </li>
        @if (profileSection is "Orders" or "Addresses" or "Favorites")
        {
            <li class="profile-breadcrumb-parent">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                <a asp-controller="Profile" asp-action="Index">حساب کاربری</a>
            </li>
        }
        <li class="cart-breadcrumb-current">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
            <span aria-current="page">
                <i class="bi @profileIcon" aria-hidden="true"></i>@profileTitle
            </span>
        </li>
    </ol>
</nav>
<header class="account-welcome">
    <div class="account-welcome-copy">
        <span class="account-welcome-brand">کمپانی علی‌رضا زارع</span>
        <h1>حساب کاربری</h1>
        <p>فضای شخصی شما؛ برای پیگیری هر انتخاب ماندگار.</p>
        <div class="account-welcome-links">
            <a asp-controller="Profile" asp-action="Orders"><i class="bi bi-bag-check" aria-hidden="true"></i> سفارش‌های من <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            <a asp-controller="Profile" asp-action="Favorites"><i class="bi bi-heart" aria-hidden="true"></i> علاقه‌مندی‌ها</a>
        </div>
    </div>
    <div class="account-welcome-art" aria-hidden="true">
        <span class="account-welcome-tool-icon">
            <i class="bi bi-tools"></i>
        </span>
        <span>ابزار و تجهیزات برقی</span>
    </div>
</header>
<div class="account-dashboard">
<aside class="account-sidebar">
    <div class="account-profile">
        <span class="account-profile-avatar">
            <i class="bi bi-person"></i>
        </span>
        <div>
            <small>حساب کاربری</small><strong>محمدحسین فخراوری</strong><span>مشتری کمپانی علی‌رضا زارع</span>
        </div>
        <a class="account-profile-edit" href="#profileEditDialog" data-profile-edit-trigger aria-label="ویرایش پروفایل">
            <i class="bi bi-pencil-square" aria-hidden="true"></i><span>ویرایش پروفایل</span>
        </a>
    </div>
    <nav class="account-tabs" aria-label="بخش‌های حساب">
        <a href="Profile">
            <i class="bi bi-person"></i>
            <span>
                <strong>پروفایل من</strong>
            </span><i class="bi bi-chevron-left"></i>
        </a>
        <a href="Profile/Orders">
            <i class="bi bi-bag-check"></i>
            <span>
                <strong>سفارش‌های من</strong>
            </span><i class="bi bi-chevron-left"></i>
        </a>
        <a href="Profile/Addresses">
            <i class="bi bi-geo-alt"></i>
            <span>
                <strong>آدرس‌های من</strong>
            </span><i class="bi bi-chevron-left"></i>
        </a>
        <a href="Profile/Favorites">
            <i class="bi bi-heart"></i>
            <span>
                <strong>علاقه‌مندی‌ها</strong>
            </span><i class="bi bi-chevron-left"></i>
        </a>
    </nav>
    <div class="account-sidebar-help">
        <i class="bi bi-headset"></i>
        <div>
            <strong>نیاز به راهنمایی دارید؟</strong><a href="Contact">ارتباط با پشتیبانی</a>
        </div>
    </div>
</aside>
<div class="account-content">
<section id="overview" class="account-section account-overview">
    <div class="overview-heading">
        <i class="bi bi-grid-1x2" aria-hidden="true"></i>
        <div>
            <span>نمای کلی حساب</span>
            <h2>گزارش فعالیت‌های شما</h2>
            <p>خلاصه‌ای از خریدها و اطلاعات ذخیره‌شده در حساب کاربری</p>
        </div>
    </div>
    <div class="account-stats">
        <article>
            <span class="stat-icon stat-orders">
                <i class="bi bi-bag-check"></i>
            </span>
            <div>
                <strong id="statOrders">۰</strong><small>سفارش ثبت‌شده</small>
            </div>
        </article>
        <article>
            <span class="stat-icon stat-addresses">
                <i class="bi bi-geo-alt"></i>
            </span>
            <div>
                <strong id="statAddresses">۰</strong><small>آدرس ذخیره‌شده</small>
            </div>
        </article>
        <article>
            <span class="stat-icon stat-favorites">
                <i class="bi bi-heart"></i>
            </span>
            <div>
                <strong id="statFavorites">۰</strong><small>کالای موردعلاقه</small>
            </div>
        </article>
    </div>
    <div class="overview-panels">
        <article>
            <div class="overview-panel-title">
                <i class="bi bi-clock-history"></i>
                <h3>فعالیت‌های اخیر</h3>
            </div>
            <div class="overview-empty">
                <i class="bi bi-stars"></i><strong>هنوز فعالیتی ثبت نشده است</strong>
                <p>پس از ثبت آدرس، ذخیره محصول یا خرید، خلاصه فعالیت‌ها اینجا نمایش داده می‌شود.</p>
            </div>
        </article>
        <article class="overview-guide">
            <div class="overview-panel-title">
                <i class="bi bi-compass"></i>
                <h3>شروع سریع</h3>
            </div>
            <a href="Search">
                <i class="bi bi-tools"></i>
                <span>
                    <strong>مشاهده محصولات</strong><small>ابزار و تجهیزات برق را بررسی کنید</small>
                </span><i class="bi bi-arrow-left"></i>
            </a>
            <a href="Profile/Addresses">
                <i class="bi bi-plus-circle"></i>
                <span>
                    <strong>ثبت آدرس تحویل</strong><small>برای خرید سریع‌تر آماده شوید</small>
                </span><i class="bi bi-arrow-left"></i>
            </a>
        </article>
    </div>
</section>
