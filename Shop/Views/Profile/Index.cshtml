<section id="addresses" class="account-section">
    <div class="account-section-heading">
        <h2>آدرس‌های من</h2><button id="newAddress" class="flow-button" type="button"><i class="bi bi-plus-lg"></i> آدرس جدید</button>
    </div>
    <div id="addressList"></div>
</section>
<section id="favorites" class="account-section">
    <h2>لیست علاقه‌مندی‌ها</h2>
