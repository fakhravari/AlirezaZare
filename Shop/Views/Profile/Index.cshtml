@model PageModel<ProfilePageViewModel>
@using System.Text.Json
@{
    var profileSection = Model.Data.Section;
}
<script type="application/json" id="accountData">@Html.Raw(JsonSerializer.Serialize(new { schemaVersion = 1, coupons = Model.Data.Coupons }, AccountData.JsonOptions))</script>
@Html.AntiForgeryToken()

<main class="flow-main container profile-page-main">
<header class="account-welcome">
    <div class="account-welcome-copy">
        <h1>@Model.Data.Title</h1>
        <p>@Model.Data.Description</p>
        <nav class="cart-breadcrumb profile-breadcrumb" aria-label="مسیر صفحه">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                    </a>
                </li>
                @if (profileSection is "orders" or "addresses" or "favorites" or "coupons" or "pricealerts" or "messages")
                {
                    <li class="profile-breadcrumb-parent">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        <a asp-controller="Profile" asp-action="Index">حساب کاربری</a>
                    </li>
                }
                <li class="cart-breadcrumb-current">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    <span aria-current="page">
                        <i class="bi @Model.Data.Icon" aria-hidden="true"></i>@Model.Data.Title
                    </span>
                </li>
            </ol>
        </nav>
    </div>
    <div class="account-welcome-art" aria-hidden="true">
        <span class="account-welcome-tool-icon">
            <i class="bi bi-tools"></i>
        </span>
        <span>ابزار و تجهیزات برقی</span>
    </div>
</header>
<div class="account-dashboard">
    <aside class="account-sidebar">
        <div class="account-profile">
            <span class="account-profile-avatar">
                <i class="bi bi-person"></i>
            </span>
            <div>
                <small>حساب کاربری</small><strong>کاربر</strong>
            </div>
            <a class="account-profile-edit" href="#profileEditDialog" data-profile-edit-trigger aria-label="ویرایش پروفایل">
                <i class="bi bi-pencil-square" aria-hidden="true"></i><span>ویرایش پروفایل</span>
            </a>
        </div>
        <nav class="account-tabs" aria-label="بخش‌های حساب">
            <a asp-controller="Profile" asp-action="Index" aria-current="@(profileSection == "profile" ? "page" : null)">
                <i class="bi bi-person"></i>
                <span>
                    <strong>پروفایل من</strong>
                </span><i class="bi bi-chevron-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Orders" aria-current="@(profileSection == "orders" ? "page" : null)">
                <i class="bi bi-bag-check"></i>
                <span>
                    <strong>سفارش‌های من</strong>
                </span><b class="account-tab-badge" data-account-count="orders" aria-label="تعداد سفارش‌های موفق">۰</b><i class="bi bi-chevron-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Addresses" aria-current="@(profileSection == "addresses" ? "page" : null)">
                <i class="bi bi-geo-alt"></i>
                <span>
                    <strong>آدرس‌های من</strong>
                </span><b class="account-tab-badge" data-account-count="addresses" aria-label="تعداد آدرس‌های فعال">۰</b><i class="bi bi-chevron-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Favorites" aria-current="@(profileSection == "favorites" ? "page" : null)">
                <i class="bi bi-heart"></i>
                <span>
                    <strong>علاقه‌مندی‌ها</strong>
                </span><b class="account-tab-badge" data-account-count="favorites" aria-label="تعداد علاقه‌مندی‌ها">۰</b><i class="bi bi-chevron-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Coupons" aria-current="@(profileSection == "coupons" ? "page" : null)">
                <i class="bi bi-ticket-perforated"></i>
                <span>
                    <strong>کدهای تخفیف</strong>
                </span><b class="account-tab-badge" data-account-count="coupons" aria-label="تعداد کدهای تخفیف فعال">۰</b><i class="bi bi-chevron-left"></i>
            </a>
            <a class="account-tab-pricealerts" asp-controller="Profile" asp-action="PriceAlerts" aria-current="@(profileSection == "pricealerts" ? "page" : null)">
                <i class="bi bi-bell"></i>
                <span>
                    <strong>پیگیری قیمت و موجودی</strong>
                </span><b class="account-tab-badge" data-account-count="pricealerts" aria-label="تعداد پیگیری‌های فعال">۰</b><i class="bi bi-chevron-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Messages" aria-current="@(profileSection == "messages" ? "page" : null)">
                <i class="bi bi-envelope"></i>
                <span>
                    <strong>پیام‌ها</strong>
                </span><i class="bi bi-chevron-left"></i>
            </a>
        </nav>
        <div class="account-sidebar-help">
            <i class="bi bi-headset"></i>
            <div>
                <strong>نیاز به راهنمایی دارید؟</strong><a asp-controller="Contact" asp-action="Index">ارتباط با پشتیبانی</a>
            </div>
        </div>
    </aside>
    <div class="account-content">
        <section id="overview" class="account-section account-overview" hidden="@(profileSection == "profile" ? null : "hidden")">
            <div class="overview-heading">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                <div>
                    <span>نمای کلی حساب</span>
                    <h2>خلاصهٔ حساب شما</h2>
                    <p>خلاصه‌ای از خریدها و اطلاعات ذخیره‌شده در حساب کاربری</p>
                </div>
            </div>
            <section class="profile-personal-card" aria-labelledby="profilePersonalTitle">
                <header>
                    <i class="bi bi-person" aria-hidden="true"></i>
                    <h3 id="profilePersonalTitle">مشخصات فردی</h3>
                </header>
                <div class="profile-personal-grid">
                    <div>
                        <span>نام و نام خانوادگی</span><strong data-profile-value="name">ثبت نشده</strong>
                    </div>
                    <div>
                        <span>پست الکترونیکی</span><strong data-profile-value="email" dir="ltr">—</strong>
                    </div>
                    <div>
                        <span>شماره موبایل</span><strong data-profile-value="phone" dir="ltr">—</strong>
                    </div>
                    <div>
                        <span>دریافت خبرنامه</span><strong data-profile-value="newsletter">خیر</strong>
                    </div>
                </div>
                <a class="profile-personal-edit" href="#profileEditDialog" data-profile-edit-trigger>ویرایش اطلاعات</a>
                <span class="profile-personal-avatar" aria-hidden="true">
                    <i class="bi bi-person"></i>
                </span>
            </section>
            <div class="account-stats">
                <article>
                    <span class="stat-icon stat-orders">
                        <i class="bi bi-bag-check"></i>
                    </span>
                    <div>
                        <strong id="statOrders">۰</strong><small>سفارش ثبت‌شده</small>
                    </div>
                </article>
                <article>
                    <span class="stat-icon stat-addresses">
                        <i class="bi bi-geo-alt"></i>
                    </span>
                    <div>
                        <strong id="statAddresses">۰</strong><small>آدرس ذخیره‌شده</small>
                    </div>
                </article>
                <article>
                    <span class="stat-icon stat-favorites">
                        <i class="bi bi-heart"></i>
                    </span>
                    <div>
                        <strong id="statFavorites">۰</strong><small>کالای موردعلاقه</small>
                    </div>
                </article>
                <article>
                    <span class="stat-icon stat-coupons">
                        <i class="bi bi-ticket-perforated"></i>
                    </span>
                    <div>
                        <strong id="statCoupons">۰</strong><small>کد تخفیف فعال</small>
                    </div>
                </article>
                <article>
                    <span class="stat-icon stat-compare">
                        <i class="bi bi-arrow-left-right"></i>
                    </span>
                    <div>
                        <strong id="statCompare">۰</strong><small>محصول در مقایسه</small>
                    </div>
                </article>
            </div>
        </section>
        <partial name="_Orders" model="@(new ProfileOrdersViewModel(profileSection == "orders", Model.Data.Orders))"/>
        <section id="addresses" class="account-section" hidden="@(profileSection == "addresses" ? null : "hidden")">
            <div class="account-section-heading">
                <h2>آدرس‌های من</h2><button id="newAddress" class="flow-button" type="button"><i class="bi bi-plus-lg"></i> آدرس جدید</button>
            </div>
            <div id="addressList"></div>
        </section>
        <section id="favorites" class="account-section" hidden="@(profileSection == "favorites" ? null : "hidden")">
            <div class="account-section-heading">
                <h2>لیست علاقه‌مندی‌ها</h2>
                <button id="clearFavorites" class="profile-favorites-clear" type="button" hidden>
                    <i class="bi bi-trash3" aria-hidden="true"></i><span>حذف همه</span>
                </button>
            </div>
            <div id="favoritesView"></div>
        </section>
        <section id="coupons" class="account-section" hidden="@(profileSection == "coupons" ? null : "hidden")">
            <div class="account-section-heading">
                <div>
                    <h2 id="profileCouponsTitle" tabindex="-1">کدهای تخفیف من</h2>
                    <p>کدهای فعال را در سبد خرید وارد کنید.</p>
                </div>
                <a class="account-section-action profile-coupons-cart-link" href="/Cart">
                    <i class="bi bi-bag" aria-hidden="true"></i>
                    <span>رفتن به سبد خرید</span>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
            <div id="profileCouponsList" class="overview-coupon-list profile-coupon-list" tabindex="-1" aria-live="polite"></div>
            <div id="profileCouponsPagination" class="orders-pagination profile-coupons-pagination" hidden>
                <p role="status"></p>
                <nav class="site-pagination" aria-label="صفحه‌بندی کدهای تخفیف"></nav>
            </div>
        </section>
        <section id="price-alerts" class="account-section" hidden="@(profileSection == "pricealerts" ? null : "hidden")">
            <div class="account-section-heading">
                <div>
                    <h2>پیگیری‌های قیمت و موجودی</h2>
                    <p>هر پیگیری برای یک کالای بدون ویژگی یا ترکیب ویژگی مشخص ثبت می‌شود.</p>
                </div>
            </div>
            <div id="priceAlertsList" class="profile-price-alert-list" aria-live="polite"></div>
        </section>
        <section id="messages" class="account-section profile-messages" hidden="@(profileSection == "messages" ? null : "hidden")">
            <div class="account-section-heading">
                <div>
                    <h2 id="profileMessagesTitle" tabindex="-1">پیام‌های فروشگاه</h2>
                    <p>اطلاعیه‌ها و پیام‌های ارسال‌شده از طرف مدیر فروشگاه</p>
                </div>
            </div>
            <p class="profile-messages-demo-note"><i class="bi bi-info-circle" aria-hidden="true"></i> پیام‌های ارسال‌شده از طرف فروشگاه در اینجا نمایش داده می‌شوند.</p>
            <div id="profileMessagesList" class="profile-messages-list" aria-live="polite"></div>
            <div id="profileMessagesPagination" class="orders-pagination profile-messages-pagination" hidden>
                <p role="status"></p>
                <nav class="site-pagination" aria-label="صفحه‌بندی پیام‌ها"></nav>
            </div>
        </section>
        <p id="accountStatus" role="status"></p>
    </div>
</div>
<dialog id="addressDialog" class="address-dialog" aria-labelledby="addressDialogTitle">
    <div class="address-dialog-heading">
        <div class="address-dialog-title">
            <span class="address-dialog-icon">
                <i class="bi bi-geo-alt"></i>
            </span>
            <div>
                <span class="address-dialog-kicker">اطلاعات تحویل سفارش</span>
                <h2 id="addressDialogTitle">تعریف آدرس جدید</h2>
                <p>مشخصات تحویل را وارد کنید.</p>
            </div>
        </div>
        <button class="site-modal-close" id="closeAddress" type="button" aria-label="بستن">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <partial name="_AddressForm"/>
</dialog>
<dialog id="profileEditDialog" class="shared-login-modal profile-edit-dialog" aria-labelledby="profileEditDialogTitle">
    <div class="profile-edit-dialog-header">
        <button class="login-close" type="button" data-profile-edit-close aria-label="بستن">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
        <div class="login-brand">
            <span>
                <i class="bi bi-person" aria-hidden="true"></i>
            </span>
            <div>
                <strong>ندا اولیائی</strong><small>مدیریت اطلاعات حساب کاربری</small>
            </div>
        </div>
    </div>
    <div class="login-step">
        <span class="profile-edit-kicker">اطلاعات شخصی</span>
        <h2 id="profileEditDialogTitle">ویرایش پروفایل</h2>
        <p>اطلاعات حساب را به‌روز کنید.</p>
        <form id="profileEditModalForm" class="profile-edit-form" autocomplete="off" novalidate>
            <label>
                نام
                <span class="login-input">
                    <input name="firstName" required maxlength="50"/><i class="bi bi-person" aria-hidden="true"></i>
                </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="firstName"></small>
            </label>
            <label>
                نام خانوادگی
                <span class="login-input">
                    <input name="lastName" required maxlength="50"/><i class="bi bi-person" aria-hidden="true"></i>
                </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="lastName"></small>
            </label>
            <fieldset class="profile-edit-gender">
                <legend>جنسیت</legend>
                <div>
                    @foreach (var gender in Model.Data.Genders)
                    {
                        <label>
                            <input type="radio" name="idGender" value="@gender.Id" data-gender-code="@gender.Code"/><span>@gender.NameFa</span>
                        </label>
                    }
                </div><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="gender"></small>
            </fieldset>
            <label>
                شماره موبایل <small>قابل ویرایش</small>
                <span class="login-input">
                    <input name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" required dir="ltr" aria-describedby="profileEditPhoneError"/><i class="bi bi-phone" aria-hidden="true"></i>
                </span><small id="profileEditPhoneError" class="profile-edit-validation field-validation-valid" data-profile-edit-error="phone" role="alert"></small>
            </label>
            <label class="profile-edit-full">
                ایمیل <small>فقط‌خواندنی</small>
                <span class="login-input">
                    <input name="email" type="email" dir="ltr" readonly aria-readonly="true"/><i class="bi bi-envelope" aria-hidden="true"></i>
                </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="email"></small>
            </label>
            <label class="profile-edit-newsletter profile-edit-full">
                <input name="newsletter" type="checkbox"/>
                <span>مایلم خبرنامه و پیشنهادهای فروشگاه را دریافت کنم.</span>
            </label>
            <fieldset class="profile-edit-password profile-edit-full">
                <legend>تغییر رمز عبور</legend>
                <p id="profilePasswordHint">برای حسابی که رمز دارد، رمز فعلی را وارد کنید.</p>
                <label class="profile-edit-password-current" hidden>
                    رمز فعلی <small>(اگر برای حساب تنظیم شده است)</small>
                    <span class="login-input">
                        <input name="currentPassword" type="password" autocomplete="current-password"/><i class="bi bi-lock" aria-hidden="true"></i>
                    </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="currentPassword" role="alert"></small>
                </label>
                <label>
                    رمز جدید
                    <span class="login-input">
                        <input name="newPassword" type="password" autocomplete="new-password"/><i class="bi bi-lock-fill" aria-hidden="true"></i>
                    </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="newPassword" role="alert"></small>
                </label>
                <label>
                    تکرار رمز جدید
                    <span class="login-input">
                        <input name="newPasswordConfirmation" type="password" autocomplete="new-password"/><i class="bi bi-lock-fill" aria-hidden="true"></i>
                    </span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="newPasswordConfirmation" role="alert"></small>
                </label>
            </fieldset>
            <button class="profile-edit-full" type="submit">ذخیره تغییرات <i class="bi bi-floppy2-fill" aria-hidden="true"></i></button>
        </form>
    </div>
</dialog>
</main>


@section Styles {
    <link href="~/shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/checkout.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/account-page.css" rel="stylesheet" asp-append-version="true">
    <link href="~/shop/css/pages/form-confirm-dialog.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/page-content.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/iran-places.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/address-fields.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/form-confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/account-page.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/orders-pagination.js" asp-append-version="true"></script>
    <script>
      (() => {
        const dialog = document.getElementById('profileEditDialog');
        const form = document.getElementById('profileEditModalForm');
        if (!dialog || !form) return;
        const storage = window.HNUI?.storage;
        const savedProfile = storage?.json('hn-profile', {}) || {};
        const phone = form.elements.phone;
        const currentPasswordField = form.querySelector('.profile-edit-password-current');
        const setGender = (idGender, legacyCode) => {
          const options = [...form.querySelectorAll('[name="idGender"]')];
          const selected = options.find(option => Number(option.value) === Number(idGender))
            || options.find(option => legacyCode && option.dataset.genderCode === legacyCode);
          if (selected) selected.checked = true;
        };
        const normalizePhone = value => window.HNUI.toEnglishDigits(value).replace(/\D/g, '').slice(0, 11);
        ['firstName', 'lastName', 'email'].forEach(name => {
          if (savedProfile[name]) form.elements[name].value = savedProfile[name];
        });
        if (savedProfile.phone) phone.value = normalizePhone(savedProfile.phone);
        setGender(savedProfile.idGender, savedProfile.gender);
        form.elements.newsletter.checked = savedProfile.newsletter === true;
        const setPasswordFields = hasPassword => {
          currentPasswordField.hidden = !hasPassword;
          document.getElementById('profilePasswordHint').textContent = hasPassword
            ? 'برای تغییر رمز، رمز فعلی و رمز جدید را وارد کنید.'
            : 'این حساب هنوز رمز ندارد؛ برای تعیین رمز، رمز جدید و تکرار آن را وارد کنید.';
        };
        setPasswordFields(savedProfile.hasPassword === true);
        const renderProfile = profile => {
          const name = `${profile.firstName || form.elements.firstName.value} ${profile.lastName || form.elements.lastName.value}`.trim();
          document.querySelector('[data-profile-value="name"]').textContent = name || 'ثبت نشده';
          document.querySelector('[data-profile-value="email"]').textContent = profile.email || form.elements.email.value || '—';
          document.querySelector('[data-profile-value="phone"]').textContent = window.HNUI.toPersianDigits(profile.phone || phone.value) || '—';
          const profileName = document.querySelector('.account-profile > div strong');
          if (profileName) profileName.textContent = name || 'حساب کاربری';
          document.querySelector('[data-profile-value="newsletter"]').textContent = profile.newsletter ? 'بله' : 'خیر';
        };
        renderProfile(savedProfile);
        const hydrateProfile = async () => {
          const response = await window.HNUI.api.request('account/state');
          if (!response.ok) return;
          const account = await response.json();
          Object.assign(savedProfile, { firstName: account.firstName, lastName: account.lastName, email: account.email, phone: account.phone, idGender: account.idGender, newsletter: account.newsletter, hasPassword: account.hasPassword === true });
          ['firstName', 'lastName'].forEach(name => { form.elements[name].value = savedProfile[name] || ''; });
          form.elements.email.value = account.email || '';
          if (savedProfile.phone) phone.value = normalizePhone(savedProfile.phone);
          form.elements.newsletter.checked = savedProfile.newsletter === true;
          setPasswordFields(savedProfile.hasPassword);
          setGender(savedProfile.idGender, savedProfile.gender);
          storage?.set('hn-profile', JSON.stringify(savedProfile)); renderProfile(savedProfile);
        };
        if (window.HNUI?.auth.isLoggedIn()) void hydrateProfile().catch(() => {});
        document.addEventListener('hn:auth-change', event => { if (event.detail) void hydrateProfile().catch(() => {}); });
        const profileName = document.querySelector('.account-profile > div strong');
        if (profileName) {
          profileName.textContent = `${form.elements.firstName.value.trim()} ${form.elements.lastName.value.trim()}`.trim();
        }
        const setError = (name, message) => {
          const host = form.querySelector(`[data-profile-edit-error="${name}"]`);
          const control = form.querySelector(name === 'gender' ? '[name="idGender"]' : `[name="${name}"]`);
          host.textContent = message;
          host.className = `profile-edit-validation ${message ? 'field-validation-error' : 'field-validation-valid'}`;
          if (name === 'gender') form.querySelector('.profile-edit-gender').classList.toggle('is-invalid', Boolean(message));
          else {
            control.classList.toggle('input-validation-error', Boolean(message));
            control.setAttribute('aria-invalid', String(Boolean(message)));
          }
        };
        const validate = () => {
          const firstName = form.elements.firstName.value.trim();
          const lastName = form.elements.lastName.value.trim();
          const email = form.elements.email;
          const normalizedPhone = normalizePhone(phone.value);
          const gender = form.querySelector('[name="idGender"]:checked');
          setError('firstName', firstName ? '' : 'نام را وارد کنید.');
          setError('lastName', lastName ? '' : 'نام خانوادگی را وارد کنید.');
          setError('email', !email.value || email.validity.valid ? '' : 'ایمیل را با قالب صحیح وارد کنید.');
          setError('phone', /^09\d{9}$/.test(normalizedPhone) ? '' : 'شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.');
          setError('gender', gender ? '' : 'جنسیت را انتخاب کنید.');
          return firstName && lastName && (!email.value || email.validity.valid) && /^09\d{9}$/.test(normalizedPhone) && gender;
        };
        document.querySelectorAll('[data-profile-edit-trigger]').forEach(trigger => trigger.addEventListener('click', event => {
          event.preventDefault();
          if (!window.HNUI?.auth.isLoggedIn()) { dialog.showModal(); return; }
          trigger.setAttribute('aria-busy', 'true');
          void hydrateProfile().catch(() => {}).finally(() => { trigger.removeAttribute('aria-busy'); dialog.showModal(); });
        }));
        document.querySelectorAll('[data-profile-edit-close]').forEach(close => close.addEventListener('click', () => dialog.close()));
        phone.addEventListener('input', () => {
          const normalizedPhone = normalizePhone(phone.value);
          if (phone.value !== normalizedPhone) phone.value = normalizedPhone;
        });
        form.addEventListener('input', validate);
        form.addEventListener('change', validate);
        form.addEventListener('submit', async event => {
          event.preventDefault();
          if (!validate()) return;
          const currentPassword = form.elements.currentPassword.value;
          const newPassword = form.elements.newPassword.value;
          const newPasswordConfirmation = form.elements.newPasswordConfirmation.value;
          const changingPassword = Boolean(currentPassword || newPassword || newPasswordConfirmation);
          if (changingPassword && (!newPassword || newPassword !== newPasswordConfirmation || (savedProfile.hasPassword && !currentPassword))) {
            document.getElementById('accountStatus').textContent = !newPassword
              ? 'رمز جدید را وارد کنید.'
              : newPassword !== newPasswordConfirmation
                ? 'تکرار رمز جدید مطابقت ندارد.'
                : 'برای تغییر رمز، رمز فعلی را وارد کنید.';
            return;
          }
          const profile = {
            firstName: form.elements.firstName.value.trim(),
            lastName: form.elements.lastName.value.trim(),
            email: form.elements.email.value.trim(),
            phone: normalizePhone(phone.value),
            idGender: Number(form.querySelector('[name="idGender"]:checked').value),
            newsletter: form.elements.newsletter.checked
          };
          if (window.HNUI?.auth.isLoggedIn()) {
              if (changingPassword) {
                const passwordResponse = await window.HNUI.api.request('account/password', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ currentPassword: currentPassword || null, newPassword, newPasswordConfirmation }) });
                if (!passwordResponse.ok) {
                  const result = await passwordResponse.json().catch(() => ({}));
                  document.getElementById('accountStatus').textContent = result.message || 'تغییر رمز عبور انجام نشد.';
                  return;
                }
                savedProfile.hasPassword = true;
                setPasswordFields(true);
                form.elements.currentPassword.value = '';
                form.elements.newPassword.value = '';
                form.elements.newPasswordConfirmation.value = '';
                document.getElementById('profilePasswordHint').textContent = 'برای تغییر رمز، رمز فعلی و رمز جدید را وارد کنید.';
              }
              const response = await window.HNUI.api.request('account/profile', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ firstName: profile.firstName, lastName: profile.lastName, phone: profile.phone, idGender: profile.idGender, newsletter: profile.newsletter }) });
            if (!response.ok) {
              const result = await response.json().catch(() => ({}));
              document.getElementById('accountStatus').textContent = result.message || 'ذخیرهٔ اطلاعات حساب انجام نشد.';
              return;
            }
            if (changingPassword) {
              profile.hasPassword = true;
            }
          }
          if (!storage?.set('hn-profile', JSON.stringify(profile))) return;
          const displayName = document.querySelector('.account-profile > div strong');
          if (displayName) displayName.textContent = `${profile.firstName} ${profile.lastName}`;
          renderProfile(profile);
          document.getElementById('accountStatus').textContent = 'اطلاعات پروفایل ذخیره شد.';
          dialog.close();
        });
      })();
    </script>
}
