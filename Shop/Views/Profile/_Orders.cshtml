@model bool

<section id="orders" class="account-section" hidden="@(Model ? null : "hidden")">
<div class="orders-heading">
    <div>
        <span>تاریخچه خرید</span>
        <h2 id="ordersTitle" tabindex="-1">سفارش‌های من <small id="ordersTotal">۱۰ سفارش</small></h2>
    </div>
    <a asp-controller="Tracking" asp-action="Index"><i class="bi bi-geo-alt"></i> پیگیری سفارش</a>
</div>
<p class="account-demo-note" role="note">این فهرست برای نمایش رابط کاربری نمونه‌سازی شده است و سوابق واقعی خرید یا وضعیت زندهٔ سفارش‌ها را نشان نمی‌دهد.</p>
<div class="profile-order-list">
<article class="profile-order-card">
    <header>
        <div>
            <span class="order-status is-shipping"><i class="bi bi-truck"></i> در حال ارسال</span><strong>سفارش HN-۱۴۰۵۰۶۲۱</strong>
        </div>
        <time datetime="2026-09-08">۱۷ شهریور ۱۴۰۵</time>
    </header>
