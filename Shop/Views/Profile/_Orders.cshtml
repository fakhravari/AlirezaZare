@model bool

@inject Shop.Services.IAccountDataSource AccountSource
@{
    var orders = (await AccountSource.ReadAsync(Context.RequestAborted)).Orders;
}

<section id="orders" class="account-section" hidden="@(Model ? null : "hidden")">
    <div class="orders-heading">
        <div>
            <span>تاریخچه خرید</span>
            <h2 id="ordersTitle" tabindex="-1">سفارش‌های من <small id="ordersTotal">@orders.Count سفارش</small></h2>
        </div>
    </div>
    <p class="account-demo-note" role="note">این فهرست برای نمایش رابط کاربری نمونه‌سازی شده است و سوابق واقعی خرید یا وضعیت زندهٔ سفارش‌ها را نشان نمی‌دهد.</p>
    <div class="profile-order-list">
        @foreach (var order in orders)
        {
            <article class="profile-order-card"
                     data-order-number="@order.Number"
                     data-order-status="@order.StatusLabel"
                     data-order-date="@order.DateLabel"
                     data-order-datetime="@order.OrderedOn.ToString("yyyy-MM-dd")"
                     data-order-count="@order.ItemCount"
                     data-order-amount="@order.TotalAmount"
                     data-order-delivery="@order.DeliveryDescription">
                <header>
                    <div>
                        <span class="order-status @order.StatusClass"><i class="bi @(order.StatusClass == "is-shipping" ? "bi-truck" : order.StatusClass == "is-processing" ? "bi-hourglass-split" : "bi-check2-circle")" aria-hidden="true"></i> @order.StatusLabel</span>
                        <strong>سفارش @order.Number</strong>
                    </div>
                    <time datetime="@order.OrderedOn.ToString("yyyy-MM-dd")">@order.DateLabel</time>
                </header>
                <div class="order-body order-invoice-summary">
                    <div class="order-products">
                        <span class="order-product-icon" aria-hidden="true"><i class="bi bi-receipt-cutoff"></i></span>
                        <div><strong>خلاصهٔ فاکتور</strong><small>@order.ItemCount کالا · پرداخت آنلاین</small></div>
                    </div>
                    <div class="order-total"><small>مبلغ سفارش</small><strong>@order.TotalAmount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR")) تومان</strong></div>
                </div>
                <footer>
                    <span><i class="bi bi-box-seam" aria-hidden="true"></i> @order.DeliveryDescription</span>
                    <div class="order-card-actions">
                        <a asp-controller="Tracking" asp-action="Index"><i class="bi bi-truck" aria-hidden="true"></i> مشاهده جزئیات تحویل پست</a>
                        <button type="button" data-open-order-invoice><i class="bi bi-receipt" aria-hidden="true"></i> مشاهدهٔ فاکتور</button>
                    </div>
                </footer>
            </article>
        }
    </div>
    <dialog class="order-invoice-dialog" id="orderInvoiceDialog" aria-labelledby="orderInvoiceTitle">
        <header class="order-invoice-dialog-header">
            <div><span>جزئیات سفارش</span><h2 id="orderInvoiceTitle">فاکتور</h2></div>
            <button class="site-modal-close" type="button" data-close-order-invoice aria-label="بستن فاکتور"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>
        <div class="order-invoice-layout">
            <section class="order-invoice-master" aria-label="اطلاعات سفارش">
                <h3><i class="bi bi-card-list" aria-hidden="true"></i> خلاصهٔ سفارش</h3>
                <dl>
                    <div><dt>شماره سفارش</dt><dd data-invoice-number></dd></div>
                    <div><dt>تاریخ ثبت</dt><dd data-invoice-date></dd></div>
                    <div><dt>وضعیت</dt><dd data-invoice-status></dd></div>
                    <div><dt>روش پرداخت</dt><dd>پرداخت آنلاین</dd></div>
                    <div><dt>وضعیت تحویل</dt><dd data-invoice-delivery></dd></div>
                </dl>
            </section>
            <section class="order-invoice-detail" aria-label="اقلام و مبالغ فاکتور">
                <h3><i class="bi bi-receipt" aria-hidden="true"></i> ریز فاکتور</h3>
                <div class="order-invoice-table" role="table" aria-label="اقلام فاکتور">
                    <div class="order-invoice-row order-invoice-table-heading" role="row"><span role="columnheader">شرح</span><span role="columnheader">تعداد</span><span role="columnheader">مبلغ</span></div>
                    <div class="order-invoice-row" role="row"><span role="cell">کالاهای این سفارش</span><span data-invoice-count role="cell"></span><strong data-invoice-amount role="cell"></strong></div>
                </div>
                <div class="order-invoice-payable"><span>مبلغ قابل پرداخت</span><strong data-invoice-total></strong></div>
                <p class="order-invoice-demo-note">جزئیات این فاکتور نمونهٔ نمایشی است و از سوابق مالی واقعی دریافت نشده است.</p>
            </section>
        </div>
    </dialog>
</section>
