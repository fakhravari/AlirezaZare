@model PageModel
@{
    var warrantySections = Model.ManagedContent?.Sections ?? [];
}


<header class="page-hero about-hero">
    <img class="hero-image"
         src="@Url.Content("~/shop/images/heroes/hero-electrical-service.webp")"
         alt="بررسی ابزار برقی و مدارک ضمانت" width="1536" height="1024" fetchpriority="high"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>ضمانت و خدمات پس از فروش</span>
                </span>
            </span>
        </nav>
        <h1>@(Model.ManagedContent?.Title ?? "ضمانت و خدمات پس از فروش")</h1>
        <p>
            @if (!string.IsNullOrWhiteSpace(Model.ManagedContent?.Description))
            {
                @Model.ManagedContent.Description
            }
            else
            {
                <text>مدت و پوشش خدمات هر کالا را در مدارک و کارت ضمانت همان مدل بررسی کنید.</text>
            }
        </p>
        <div class="hero-trail">
            <span>مدارک کالا</span>
            <span>شرایط مدل</span>
            <span>پیگیری خدمات</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main warranty-page">
    <section class="warranty-shell" aria-labelledby="warrantyTitle">
        <div class="warranty-overview">
            <div class="warranty-copy">
                <span class="warranty-kicker"><i class="bi bi-shield-check" aria-hidden="true"></i> ضمانت و خدمات پس از فروش</span>
                <h2 id="warrantyTitle">@(warrantySections.FirstOrDefault()?.Heading ?? "برای استفاده از ضمانت، مدارک محصول را نگه دارید")</h2>
                @if (warrantySections.Count > 0)
                {
                    @foreach (var paragraph in (warrantySections[0].Body ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <p>@paragraph</p> }
                }
                else
                {
                    <p>هنگام تحویل، نام و مدل کالا، شماره سریال و اطلاعات کارت ضمانت را با فاکتور تطبیق دهید. مدت پوشش، اقلام مشمول و شرایط سرویس برای هر محصول متفاوت است؛ مدارک همان کالا مرجع بررسی خواهد بود.</p>
                    <p>اگر برای استفاده از خدمات نیاز به پیگیری داشتید، مدل کالا، تاریخ خرید و شرح کوتاهی از ایراد را آماده کنید. کارشناسان پس از بررسی اطلاعات، مراحل بعدی را با شما هماهنگ می‌کنند.</p>
                }
                <a class="warranty-contact" asp-controller="Contact" asp-action="Index">ارتباط با خدمات مشتریان <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            </div>
            <div class="warranty-visual">
                <img src="~/shop/images/heroes/hero-warranty-work-light.webp" alt="چراغ کار LED و تجهیزات فنی" width="900" height="900" loading="lazy"/>
                <span><i class="bi bi-patch-check" aria-hidden="true"></i> بررسی شرایط هر محصول</span>
            </div>
        </div>

        <section class="warranty-guidance" aria-labelledby="warrantyGuidanceTitle">
            <header>
                <span class="warranty-guidance-badge"><i class="bi bi-clipboard2-check" aria-hidden="true"></i> راهنمای درخواست</span>
                <h2 id="warrantyGuidanceTitle">اگر به خدمات نیاز داشتید</h2>
            </header>
            <ol class="warranty-steps">
                @if (warrantySections.Count > 1)
                {
                    var warrantyIcons = new[] { "bi-receipt", "bi-chat-left-text", "bi-headset" };
                    @for (var i = 1; i < warrantySections.Count; i++)
                    {
                        <li><span class="warranty-step-icon"><i class="bi @(warrantyIcons[(i - 1) % warrantyIcons.Length])" aria-hidden="true"></i></span><div><strong>@warrantySections[i].Heading</strong>@foreach (var paragraph in (warrantySections[i].Body ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <p>@paragraph</p> }</div></li>
                    }
                }
                else
                {
                <li>
                    <span class="warranty-step-icon">
                        <i class="bi bi-receipt" aria-hidden="true"></i>
                    </span>
                    <div>
                        <strong>مدارک را آماده کنید</strong>
                        <p>فاکتور خرید، مدل و کارت ضمانت محصول را در دسترس داشته باشید.</p>
                    </div>
                </li>
                <li>
                    <span class="warranty-step-icon">
                        <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                    </span>
                    <div>
                        <strong>شرح مشکل را بگویید</strong>
                        <p>علائم و زمان بروز مشکل را برای بررسی اولیه با پشتیبانی در میان بگذارید.</p>
                    </div>
                </li>
                <li>
                    <span class="warranty-step-icon">
                        <i class="bi bi-headset" aria-hidden="true"></i>
                    </span>
                    <div>
                        <strong>شرایط را هماهنگ کنید</strong>
                        <p>پوشش و مراحل بعدی بر اساس مدارک محصول و بررسی فروشگاه اعلام می‌شود.</p>
                    </div>
                </li>
                }
            </ol>
        </section>

        <aside class="warranty-note">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <p><strong>نکته:</strong> کارت ضمانت و اطلاعات همان محصول، مرجع تعیین مدت پوشش و شرایط خدمات هستند.</p>
        </aside>
    </section>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="~/shop/css/pages/warranty.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="~/shop/js/pages/page-content.js" asp-append-version="true"></script>
}
