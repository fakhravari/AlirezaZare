@model PageModel

<header class="page-hero compare-page-hero">
    <div class="container">
        <nav class="cart-breadcrumb" aria-label="مسیر صفحه">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                    </a>
                </li>
                <li class="cart-breadcrumb-current">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> مقایسه محصولات</span>
                </li>
            </ol>
        </nav>
        <span class="page-kicker"><i class="bi bi-columns-gap" aria-hidden="true"></i> انتخاب آگاهانه‌تر</span>
        <h1>مقایسه محصولات</h1>
        <p>مشخصات و قیمت محصولات را کنار هم مقایسه کنید.</p>
        <div class="hero-trail" aria-label="مزایای مقایسه محصولات">
            <span>مقایسهٔ مشخصات</span>
            <span>بررسی قیمت‌ها</span>
            <span>انتخاب آگاهانه</span>
        </div>
</div>
</header>
<main class="flow-main container compare-page">
    <section id="compareView" aria-live="polite"><div class="flow-card flow-empty empty-state-card"><i class="bi bi-columns-gap" aria-hidden="true"></i><h2>هنوز محصولی برای مقایسه انتخاب نشده است</h2><p>مدل‌های موردنظرتان را به فهرست مقایسه اضافه کنید.</p><a class="flow-button" asp-controller="Product" asp-action="List">مرور محصولات</a></div></section>
</main>

@section Styles {
    <link href="~/Shop/css/pages/form-confirm-dialog.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/Shop/js/pages/form-confirm-dialog.js" asp-append-version="true"></script>
}
