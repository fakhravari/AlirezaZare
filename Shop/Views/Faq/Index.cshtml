@model PageModel<IReadOnlyList<FaqEntry>>


<header class="page-hero about-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-question-circle" aria-hidden="true"></i>
                    <span>پرسش‌های متداول</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>پرسش‌های متداول</h1>
        <p>
            پاسخ پرسش‌های خرید، پیگیری سفارش و خدمات پس از فروش را اینجا بخوانید.
        </p>
        <div class="hero-trail">
            <span>انتخاب</span>
            <span>سفارش و ارسال</span>
            <span>خدمات</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main faq-main">
    <section class="faq-shell" aria-labelledby="faqListTitle">
        <span class="faq-shell-shape" aria-hidden="true"></span>
        <header class="faq-list-heading">
            <div>
                <span class="faq-list-kicker"><i class="bi bi-chat-square-text" aria-hidden="true"></i>پاسخ‌های راهگشا</span>
                <h2 id="faqListTitle">پرسش‌های پرتکرار</h2>
            </div>
            <span class="faq-count"><i class="bi bi-patch-question" aria-hidden="true"></i>@Model.Data.Count پرسش و پاسخ</span>
        </header>
        <div class="faq-list">
        @foreach (FaqEntry item in Model.Data)
        {
            <details class="faq-item">
                <summary>
                    <span class="faq-question-icon"><i class="bi bi-question-lg" aria-hidden="true"></i></span>
                    <span class="faq-question-text">@item.Question</span>
                    <span class="faq-toggle" aria-hidden="true"><i class="bi bi-plus-lg"></i></span>
                </summary>
                <div class="faq-answer">
                    <span class="faq-answer-label"><i class="bi bi-check2" aria-hidden="true"></i>پاسخ</span>
                    <p>@item.Answer @if (!string.IsNullOrWhiteSpace(item.LinkText) && !string.IsNullOrWhiteSpace(item.LinkUrl))
                    {
                        <a href="@Url.Content("~" + item.LinkUrl)">@item.LinkText</a>
                    }</p>
                </div>
            </details>
        }
        </div>
    </section>
    <a class="faq-contact-cta" href="Contact">
        <span class="faq-contact-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
        <span class="faq-contact-copy"><strong>پاسختان را پیدا نکردید؟</strong><small>برای راهنمایی بیشتر با تیم پشتیبانی در تماس باشید.</small></span>
        <span class="faq-contact-action">ارتباط با ما <i class="bi bi-arrow-left" aria-hidden="true"></i></span>
    </a>
</main>
<section class="faq-related-section" aria-label="صفحات مرتبط">
    <div class="container">
        <partial name="_RelatedLinks"/>
    </div>
</section>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="~/Shop/css/pages/faq.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
