@model PageModel


<header class="page-hero about-hero">
    <img
        class="hero-image"
        src="~/Shop/images/heroes/hero-electrical-editorial.png"
        alt="کنترل تخصصی کیفیت و اصالت ساعت"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current">
                    <i class="bi bi-people"></i>
                    <span>درباره ما</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">داستان یک انتخاب معتبر</span>
        <h1>اصالت در محصول، <em>تعهد در رابطه</em></h1>
        <p>
            کمپانی علی‌رضا زارع با تمرکز بر تأمین ساعت‌های اورجینال، کنترل کیفی
            دقیق و خدمات پس از فروش پاسخ‌گو شکل گرفته است؛ چون اعتماد مشتری برای
            ما یک قرارداد بلندمدت است.
        </p>
        <div class="hero-trail">
            <span>ضمانت کتبی اصالت</span>
            <span>
                دو سال خدمات
            </span
            ><span>پشتیبانی مشتریان</span>
        </div>
    </div>
</header>
<main>
    <section class="page-section">
        <div class="container">
            <div class="story-grid">
                <div class="story-visual">
                    <img
                        src="~/Shop/images/products/tool-hammer-drill.png"
                        alt="ساعت اورجینال علی‌رضا زارع"/>
                    <div class="story-seal">
                        <span><strong>+۴۸K</strong><br/>سفارش موفق</span>
                    </div>
                </div>
                <div class="story-copy">
                    <span
                        class="page-kicker"
                        style="color: #95682f; border-color: #dbc6a5">
                        درباره مجموعه
                    </span
                    >
                    <h2>ساختاری حرفه‌ای برای یک خرید مطمئن</h2>
                    <p>
                        فعالیت مجموعه بر واردات، تأمین و عرضه ساعت‌های اورجینال مردانه و
                        زنانه متمرکز است. هر محصول پیش از تحویل از نظر اصالت، سلامت
                        ظاهری و عملکرد فنی بررسی می‌شود.
                    </p>
                    <p>
                        واحدهای فروش و پشتیبانی ما در بوشهر، از مرحله شناخت نیاز و
                        انتخاب مدل تا سرویس‌های پس از خرید همراه مشتریان حقیقی و سازمانی
                        هستند.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section" style="background: #f2ece3">
        <div class="container">
            <div class="section-title">
                <span>ارزش‌های ما</span>
                <h2>چیزی فراتر از فروش ساعت</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon">
                            <i class="bi bi-patch-check">
                            </i
                            >
                        </span>
                        <h3>اصالت بدون ابهام</h3>
                        <p>
                            ارائه ضمانت کتبی و بررسی دقیق مشخصات هر محصول پیش از تحویل.
                        </p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon">
                            <i class="bi bi-chat-heart"></i>
                        </span>
                        <h3>شفافیت در انتخاب</h3>
                        <p>ارائه اطلاعات دقیق محصول، مشخصات فنی و شرایط ضمانت.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon">
                            <i class="bi bi-tools"></i>
                        </span>
                        <h3>خدمات ماندگار</h3>
                        <p>پشتیبانی، تنظیم بند و راهنمای نگهداری حتی پس از خرید.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon">
                            <i class="bi bi-stars"></i>
                        </span>
                        <h3>انتخاب سخت‌گیرانه</h3>
                        <p>
                            ورود مدل‌هایی که از نظر کیفیت، طراحی و ارزش خرید تأیید
                            شده‌اند.
                        </p>
                    </article>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-5">
                    <div class="section-title">
                        <span>مسیر مجموعه</span>
                        <h2>رشد بر پایه اعتماد مشتریان</h2>
                        <p>
                            هر مرحله از توسعه مجموعه با حفظ کیفیت تأمین و پاسخ‌گویی همراه
                            بوده است.
                        </p>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="timeline">
                        <article class="timeline-item">
                            <small>شروع مسیر</small>
                            <h3>فروش تخصصی و پاسخ‌گویی حضوری</h3>
                            <p>
                                آغاز فعالیت با تمرکز بر شناخت دقیق محصول و نیاز مشتریان
                                بازار ساعت.
                            </p>
                        </article>
                        <article class="timeline-item">
                            <small>توسعه خدمات</small>
                            <h3>ایجاد شبکه پشتیبانی و کنترل کیفیت</h3>
                            <p>استانداردسازی بررسی محصول و گسترش خدمات پس از فروش.</p>
                        </article>
                        <article class="timeline-item">
                            <small>امروز</small>
                            <h3>تجربه یکپارچه حضوری و آنلاین</h3>
                            <p>
                                دسترسی سریع‌تر به محصولات رسمی، محتوای تخصصی و پشتیبانی
                                مستقیم.
                            </p>
                        </article>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-cta">
        <div class="container">
            <div class="cta-box">
                <div>
                    <h2>از نزدیک با مجموعه آشنا شوید</h2>
                    <p>
                        اطلاعات شعب و راه‌های ارتباط مستقیم با کارشناسان را مشاهده کنید.
                    </p>
                </div>
                <a href="Contact">
                    اطلاعات تماس
                    <i class="bi bi-arrow-left">
                    </i
                    >
                </a>
            </div>
        </div>
    </section>
</main>


@section Styles {
    <link href="Shop/css/pages/pages.css?v=44" rel="stylesheet"/>
}

@section Scripts {
    <script src="Shop/js/pages/page-content.js?v=1"></script>
}
