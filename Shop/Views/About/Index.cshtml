@model PageModel


<header class="page-hero about-hero">
    <img class="hero-image" src="~/Shop/images/banners/electrical-tools.png" alt="ابزارهای برقی و تجهیزات کارگاهی" width="2172" height="724" fetchpriority="high" />
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current">
                    <i class="bi bi-people"></i>
                    <span>درباره ما</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">داستان یک انتخاب معتبر</span>
        <h1>اصالت در محصول، <em>تعهد در رابطه</em></h1>
        <p>
            ابزار و قطعات فنی را با اطلاعات کاربردی مقایسه و متناسب با نیازتان انتخاب کنید.
        </p>
        <div class="hero-trail">
            <span>محصولات</span>
            <span>شرایط کالا</span>
            <span>پشتیبانی</span>
        </div>
    </div>
</header>
<main class="about-page">
    <section class="page-section about-intro-section">
        <div class="container">
            <div class="story-grid">
                <div class="story-visual">
                    <img
                        src="~/Shop/images/heroes/hero-electrical-service.png"
                        alt="کارشناس فنی در حال سرویس و بررسی تجهیزات برقی"
                        width="1916" height="821" loading="lazy" decoding="async" />
                    <div class="story-seal" aria-label="همراهی در تمام مراحل خرید">
                        <span><strong>از انتخاب</strong><br />تا پشتیبانی</span>
                    </div>
                </div>
                <div class="story-copy">
                    <span class="about-eyebrow">
                        معرفی رسمی ندا اولیائی
                    </span>
                    <h2>ابزار و قطعات برای انتخاب آگاهانه</h2>
                    <p>
                        <strong>ندا اولیائی</strong> فروشگاهی در حوزهٔ ابزار برقی، تجهیزات اندازه‌گیری و قطعات فنی است. در صفحهٔ هر محصول می‌توانید مشخصات و اطلاعات موجود را بررسی کنید و برای جزئیات تکمیلی با مجموعه تماس بگیرید.
                    </p>
                    <p>
                        شرایط قیمت، موجودی، ارسال و ضمانت ممکن است بر اساس کالا و سفارش تفاوت داشته باشد؛ اطلاعات قابل‌اعلام و راه‌های پیگیری در صفحات مربوط درج شده‌اند.
                    </p>
                    <a class="article-link" asp-controller="Contact" asp-action="Index">
                        راه‌های ارتباطی با ما <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section about-values-section">
        <div class="container">
            <div class="section-title">
                <span class="page-kicker about-section-kicker">ارزش‌های ما</span>
                <h2>چیزی فراتر از فروش ابزار</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></span>
                        <h3>اصالت بدون ابهام</h3>
                        <p>
                            بررسی اطلاعات و شرایط درج‌شده برای هر کالا پیش از تصمیم‌گیری.
                        </p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon"><i class="bi bi-chat-heart" aria-hidden="true"></i></span>
                        <h3>شفافیت در انتخاب</h3>
                        <p>ارائه اطلاعات دقیق محصول، مشخصات فنی و شرایط ضمانت.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                        <h3>خدمات ماندگار</h3>
                        <p>برای پرسش دربارهٔ مشخصات، سفارش یا شرایط خدمات از راه‌های تماس استفاده کنید.</p>
                    </article>
                </div>
                <div class="col-md-6 col-lg-3">
                    <article class="glass-card value-card">
                        <span class="value-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                        <h3>انتخاب سخت‌گیرانه</h3>
                        <p>
                            مقایسهٔ مدل‌ها بر اساس کاربرد، مشخصات فنی و نیاز واقعی کاربر.
                        </p>
                    </article>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section about-journey-section">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-5">
                    <div class="section-title">
                        <span class="page-kicker about-section-kicker">تعهد ما در هر مرحله</span>
                        <h2>همراهی از انتخاب تا دریافت کالا</h2>
                        <p>
                            تجربهٔ خرید خوب فقط به انتخاب محصول ختم نمی‌شود؛ اطلاعات روشن و پشتیبانی در ادامه هم اهمیت دارد.
                        </p>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="timeline">
                        <article class="timeline-item">
                            <small>مرحلهٔ اول</small>
                            <h3>شناخت نیاز و انتخاب آگاهانه</h3>
                            <p>
                                مشخصات فنی، کاربرد و تفاوت مدل‌ها را بررسی کنید تا گزینه‌ای متناسب با نوع کارتان پیدا شود.
                            </p>
                        </article>
                        <article class="timeline-item">
                            <small>مرحلهٔ دوم</small>
                            <h3>خرید شفاف و اطلاعات کامل</h3>
                            <p>قیمت، موجودی، اقلام همراه و شرایط ضمانت را پیش از ثبت سفارش بررسی کنید.</p>
                        </article>
                        <article class="timeline-item">
                            <small>مرحلهٔ سوم</small>
                            <h3>پیگیری و پشتیبانی پس از خرید</h3>
                            <p>
                                برای پیگیری سفارش یا دریافت راهنمایی، راه‌های ارتباطی مجموعه در دسترس شماست.
                            </p>
                        </article>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="page-cta">
        <div class="container">
            <div class="cta-box">
                <div>
                    <h2>از نزدیک با مجموعه آشنا شوید</h2>
                    <p>
                        راه‌های ارتباط با مجموعه و مسیرهای پیگیری درخواست را مشاهده کنید.
                    </p>
                </div>
                <a asp-controller="Contact" asp-action="Index">
                    اطلاعات تماس
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
</main>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/about.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
