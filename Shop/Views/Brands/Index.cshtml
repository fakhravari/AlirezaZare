@model PageModel<IReadOnlyList<BrandProfileModel>>


<header class="page-hero brands-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-award" aria-hidden="true"></i>
                    <span>برندهای ابزار و تجهیزات</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">آشنایی با سازندگان</span>
        <h1>برندهای ابزار و <em>تجهیزات فنی</em></h1>
        <p>
            برندهای درج‌شده در کاتالوگ را بر اساس گروه محصول و نیاز کاری بررسی کنید.
        </p>
        <div class="hero-trail">
            <span>دسته‌بندی برندها</span>
            <span>معرفی گروه‌های محصول</span>
            <span>راهنمای انتخاب</span>
        </div>
    </div>
</header>
<main>
    <section class="page-section brands-catalogue">
        <div class="container">
            <div class="section-title brands-heading">
                <div>
                    <span>کاتالوگ برندها</span>
                    <h2>مرور برندها بر اساس <em>گروه کالا</em></h2>
                </div>
                <p>برای مشاهده مدل‌های موجود، برند موردنظر خود را انتخاب کنید.</p>
            </div>
<div class="flow-cards brands-grid">
                @foreach (BrandProfileModel brand in Model.Data)
                {
                    <article class="flow-card brand-card ui-surface-card">
                        <span class="brand-logo-frame">
                            @if (!string.IsNullOrWhiteSpace(brand.LogoFile))
                            {
                                <img class="brand-logo-image" src="@Url.Content($"~/Shop/images/brands/{brand.LogoFile}")" alt="لوگوی @brand.PersianName" loading="lazy" decoding="async"/>
                            }
                            else
                            {
                                <span class="brand-wordmark">@brand.Name.ToUpperInvariant()</span>
                            }
                        </span>
                        <h2>@brand.Name <small>@brand.PersianName</small></h2>
                        <p>@brand.Focus</p>
                        <div class="brand-card-actions">
                            <a class="brand-action brand-action-store" href="@Url.Content($"~/search?brand={brand.Slug}")">
                                <i class="bi bi-shop" aria-hidden="true"></i><span>مشاهده فروشگاه</span>
                            </a>
                            <a class="brand-action brand-action-details" href="@Url.Content($"~/brands/{brand.Slug}")">
                                <i class="bi bi-info-circle" aria-hidden="true"></i><span>دربارهٔ برند</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
            <partial name="_RelatedLinks"/>
        </div>
    </section>
</main>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/brands.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
