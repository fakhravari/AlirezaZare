@model PageModel


<header class="page-hero brands-hero">
    <img
        class="hero-image"
        src="~/Shop/images/heroes/hero-electrical-editorial.png"
        alt="ابزارهای برقی و تجهیزات فنی"
        width="1536"
        height="1024"
        fetchpriority="high"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-award" aria-hidden="true"></i>
                    <span>برندهای ابزار و تجهیزات</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">انتخابی به وسعت جهان</span>
        <h1>برندهای ابزار، <em>برای کار دقیق و مطمئن</em></h1>
        <p>
            ابزارهای برندهای معتبر را بر اساس گروه محصول و نیاز کاری خود بررسی کنید.
        </p>
        <div class="hero-trail">
            <span>برندهای معتبر جهانی</span>
            <span>تضمین اصالت کالا</span>
            <span>پشتیبانی مشتریان</span>
        </div>
    </div>
</header>
<main>
    <section class="page-section brands-catalogue">
        <div class="container">
            <div class="section-title brands-heading">
                <div>
                    <span>کاتالوگ برندها</span>
                    <h2>انتخابی برای <em>هر سلیقه</em></h2>
                </div>
                <p>برای مشاهده مدل‌های موجود، برند موردنظر خود را انتخاب کنید.</p>
            </div>
            <div class="flow-cards brands-grid">
                <a class="flow-card brand-card ui-surface-card ui-surface-card--interactive" href="/Search?brand=bosch">
                    <span class="brand-logo-frame"><img class="brand-logo-image" src="/Shop/images/brands/bosch.svg" alt="لوگوی بوش" loading="lazy" decoding="async"></span>
                    <h2>Bosch <small>بوش</small></h2>
                    <p>مشاهده ابزارهای بوش <i class="bi bi-arrow-left-short" aria-hidden="true"></i></p>
                </a>
                <a class="flow-card brand-card ui-surface-card ui-surface-card--interactive" href="/Search?brand=makita">
                    <span class="brand-logo-frame"><img class="brand-logo-image" src="/Shop/images/brands/makita.svg" alt="لوگوی ماکیتا" loading="lazy" decoding="async"></span>
                    <h2>Makita <small>ماکیتا</small></h2>
                    <p>مشاهده ابزارهای ماکیتا <i class="bi bi-arrow-left-short" aria-hidden="true"></i></p>
                </a>
                <a class="flow-card brand-card ui-surface-card ui-surface-card--interactive" href="/Search?brand=dewalt">
                    <span class="brand-logo-frame"><img class="brand-logo-image" src="/Shop/images/brands/dewalt.svg" alt="لوگوی دیوالت" loading="lazy" decoding="async"></span>
                    <h2>DeWalt <small>دیوالت</small></h2>
                    <p>مشاهده ابزارهای دیوالت <i class="bi bi-arrow-left-short" aria-hidden="true"></i></p>
                </a>
                <a class="flow-card brand-card ui-surface-card ui-surface-card--interactive" href="/Search?brand=ronix">
                    <span class="brand-logo-frame"><img class="brand-logo-image" src="/Shop/images/brands/ronix.png" alt="لوگوی رونیکس" loading="lazy" decoding="async"></span>
                    <h2>Ronix <small>رونیکس</small></h2>
