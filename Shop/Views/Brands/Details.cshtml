@model PageModel<BrandProfileModel>
@{
    BrandProfileModel brand = Model.Data;
    string shopUrl = Url.Content($"~/search?brand={brand.Slug}");
    string[] focusItems = brand.Focus
        .Split('،', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
        .SelectMany(item => item.Split(" و ", StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        .ToArray();
}

<main class="brand-detail-page">
    <header class="page-hero brand-detail-hero">
        <div class="container">
            <nav class="article-breadcrumb" aria-label="مسیر صفحه">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span></a>
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <a href="@Url.Content("~/brands")"><i class="bi bi-award" aria-hidden="true"></i><span>برندها</span></a>
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">@brand.PersianName</span>
            </nav>
            <h1>برند <em>@brand.PersianName</em></h1>
            <p>محصولات @brand.PersianName را با توجه به نیاز کاری مقایسه کنید.</p>
            <div class="hero-trail" aria-label="راهنمای این صفحه">
                <span>برند</span>
                <span>محصولات</span>
                <span>انتخاب</span>
            </div>
            <div class="brand-detail-actions">
                <a class="brand-detail-primary" href="@shopUrl" aria-label="مشاهده محصولات @brand.PersianName"><i class="bi bi-shop" aria-hidden="true"></i><span>مشاهده محصولات<span class="brand-detail-action-context"> @brand.PersianName</span></span></a>
                <a class="brand-detail-secondary" href="@Url.Content("~/brands")" aria-label="بازگشت به همهٔ برندها"><i class="bi bi-grid" aria-hidden="true"></i><span>بازگشت<span class="brand-detail-action-context"> به همهٔ برندها</span></span></a>
            </div>
        </div>
    </header>

    <section class="brand-detail-content page-section" aria-labelledby="brandOverviewTitle">
        <div class="container">
            <div class="brand-detail-overview">
                <div class="brand-detail-overview-copy">
                    <span class="brand-detail-eyebrow"><i class="bi bi-bookmark-star" aria-hidden="true"></i>شناخت برند</span>
                    <h2 id="brandOverviewTitle">@brand.Name <em>و حوزهٔ تخصصی آن</em></h2>
                    @if (brand.SourceEditorial?.CompanyIntroductions is { Count: > 0 } introductions)
                    {
                        @foreach (string introduction in introductions)
                        {
                            <p>@introduction</p>
                        }
                    }
                    else
                    {
                        <p>@(brand.EditorialContent.Introduction is { Length: > 0 } introduction ? introduction : brand.Editorial ?? $"در این معرفی، {brand.PersianName} را از زاویهٔ {brand.Focus} بررسی می‌کنیم؛ مشخصات هر مدل را با نیاز کاری، سازگاری و اقلام همراه آن بسنجید.")</p>
                    }
                    <div class="brand-profile-facts">
                        <div>
                            <span class="brand-profile-fact-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                            <span class="brand-profile-fact-content">
                                <small>حوزهٔ فعالیت در این فروشگاه</small>
                                <span class="brand-focus-tags" aria-label="حوزه‌های فعالیت">
                                    @foreach (string focusItem in focusItems)
                                    {
                                        <span class="brand-focus-tag">@focusItem</span>
                                    }
                                </span>
                                @if (brand.FoundedYear.HasValue || !string.IsNullOrWhiteSpace(brand.SourceEditorial?.Country))
                                {
                                    <span class="brand-focus-meta" aria-label="اطلاعات برند">
                                        @if (brand.FoundedYear.HasValue)
                                        {
                                            <span><i class="bi bi-calendar3" aria-hidden="true"></i><small>از</small><strong>@brand.FoundedYear</strong></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(brand.SourceEditorial?.Country))
                                        {
                                            <span><i class="bi bi-globe2" aria-hidden="true"></i><small>مبدأ</small><strong>@brand.SourceEditorial.Country</strong></span>
                                        }
                                    </span>
                                }
                            </span>
                        </div>
                        <div>
                            <span class="brand-profile-fact-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                            <span><small>محصولات مرتبط در محصولات</small><strong data-brand-product-count data-brand-slug="@brand.Slug">در حال شمارش…</strong></span>
                        </div>
                    </div>
                    @if (brand.SourceEditorial?.Audience is { Length: > 0 } audience)
                    {
                        <div class="brand-editorial-audience">
                            <strong><i class="bi bi-people" aria-hidden="true"></i>مخاطبان اصلی</strong>
                            <p>@audience</p>
                        </div>
                    }
                    <p class="brand-profile-note">تنوع، مشخصات و اقلام همراه میان مدل‌های یک برند متفاوت است؛ پیش از خرید، صفحهٔ هر محصول را جداگانه بررسی کنید.</p>
                    @if (!string.IsNullOrWhiteSpace(brand.OfficialUrl))
                    {
                        <a class="brand-official-source" href="@brand.OfficialUrl" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>مشاهدهٔ معرفی در وب‌سایت رسمی @brand.Name
                        </a>
                    }
                </div>
            </div>

            @if (brand.SourceEditorial is { } sourceEditorial)
            {
                <section class="brand-source-content" aria-label="جزئیات معرفی برند">
                    @if (!string.IsNullOrWhiteSpace(sourceEditorial.Specialization))
                    {
                        <div class="brand-specialization-panel">
                            <span><i class="bi bi-tools" aria-hidden="true"></i>حوزهٔ تخصصی</span>
                            <p>@sourceEditorial.Specialization</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(sourceEditorial.FeaturedProducts))
                    {
                        <div class="brand-source-featured">
                            <span class="brand-detail-eyebrow"><i class="bi bi-stars" aria-hidden="true"></i>محصولات شاخص</span>
                            <p>@sourceEditorial.FeaturedProducts</p>
                        </div>
                    }
                    @if (sourceEditorial.ProductFamilies.Count > 0 || sourceEditorial.Strengths.Count > 0)
                    {
                        <div class="brand-source-lists">
                            @if (sourceEditorial.ProductFamilies.Count > 0)
                            {
                                <section class="brand-source-list" aria-labelledby="brandFamiliesTitle">
                                    <h2 id="brandFamiliesTitle"><i class="bi bi-grid" aria-hidden="true"></i>گروه‌های محصول</h2>
                                    <ul>
                                        @foreach (string family in sourceEditorial.ProductFamilies)
                                        {
                                            <li>@family</li>
                                        }
                                    </ul>
                                </section>
                            }
                            @if (sourceEditorial.Strengths.Count > 0)
                            {
                                <section class="brand-source-list" aria-labelledby="brandStrengthsTitle">
                                    <h2 id="brandStrengthsTitle"><i class="bi bi-patch-check" aria-hidden="true"></i>نکات برجسته</h2>
                                    <ul>
                                        @foreach (string strength in sourceEditorial.Strengths)
                                        {
                                            <li>@strength</li>
                                        }
                                    </ul>
                                </section>
                            }
                        </div>
                    }
                </section>
            }

            <section class="brand-selection-guide" aria-labelledby="brandGuideTitle">
                <header>
                    <span class="brand-detail-eyebrow brand-detail-eyebrow--guide"><i class="bi bi-check2-circle" aria-hidden="true"></i>راهنمای انتخاب</span>
                    <h2 id="brandGuideTitle">پیش از انتخاب محصول <em>چه چیزهایی را بررسی کنیم؟</em></h2>
                    <p>برای انتخابی متناسب با کارتان، این نکته‌ها را در مشخصات هر مدل در نظر بگیرید.</p>
                </header>
                <div class="brand-guide-grid">
                    @for (int index = 0; index < brand.Highlights.Count; index++)
                    {
                        <article>
                            <span class="brand-guide-number">۰@(index + 1)</span>
                            <span class="brand-guide-icon"><i class="bi @(index == 0 ? "bi-bullseye" : index == 1 ? "bi-list-check" : "bi-shield-check")" aria-hidden="true"></i></span>
                            <p>@brand.Highlights[index]</p>
                        </article>
                    }
                </div>
                @if (brand.SourceEditorial?.ShoppingAdvice is { Length: > 0 } shoppingAdvice)
                {
                    <p class="brand-source-shopping-advice"><i class="bi bi-lightbulb" aria-hidden="true"></i><span><strong>نکته‌های کاربردی برای انتخاب</strong>@shoppingAdvice</span></p>
                }
            </section>

            <aside class="brand-detail-cta">
                <span class="brand-detail-cta-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div>
                    <strong>محصول مناسب کارتان را پیدا کنید</strong>
                    <p>مدل‌های @brand.PersianName را ببینید و مشخصاتشان را با نیاز خود بسنجید.</p>
                </div>
                <a href="@shopUrl">مشاهده محصولات <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            </aside>
        </div>
    </section>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/brands.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/brand-product-count.js" asp-append-version="true"></script>
}
