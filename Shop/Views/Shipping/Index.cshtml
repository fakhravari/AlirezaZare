@model PageModel
@{
    var shippingSections = Model.ManagedContent?.Sections ?? [];
    var shippingIcons = new[] { "bi-clipboard2-check", "bi-box-seam", "bi-box2-heart" };
    var shippingFallback = new[]
    {
        (Heading: "هماهنگی سفارش", Body: "موجودی، نشانی مقصد و زمان آماده‌سازی را پیش از تأیید نهایی با فروشگاه بررسی کنید."),
        (Heading: "تعیین روش ارسال", Body: "روش ارسال، هزینه و زمان تقریبی تحویل متناسب با مقصد و شرایط سفارش اعلام می‌شود."),
        (Heading: "بررسی هنگام دریافت", Body: "سلامت بسته و تطابق اقلام را بررسی کنید و هرگونه مغایرت یا آسیب را به پشتیبانی اطلاع دهید.")
    };
}


<header class="page-hero about-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>شرایط ارسال</span>
                </span>
            </span>
        </nav>
        <h1>@(Model.ManagedContent?.Title ?? "شرایط ارسال")</h1>
        <p>
            @if (!string.IsNullOrWhiteSpace(Model.ManagedContent?.Description))
            {
                @Model.ManagedContent.Description
            }
            else
            {
                <text>روش، هزینه و زمان تحویل با توجه به مقصد و موجودی سفارش اعلام می‌شود.</text>
            }
        </p>
        <div class="hero-trail">
            <span>موجودی</span>
            <span>روش ارسال</span>
            <span>هزینه و زمان</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main shipping-page">
    <section class="shipping-shell" aria-labelledby="shippingProcessTitle">
        <header class="shipping-heading">
            <div>
                <span class="shipping-kicker"><i class="bi bi-truck" aria-hidden="true"></i> راهنمای ارسال</span>
                <h2 id="shippingProcessTitle">مسیر سفارش تا دریافت کالا</h2>
            </div>
            <p class="shipping-heading-note">
                <i class="bi bi-info-circle" aria-hidden="true"></i><span>جزئیات ارسال با توجه به موجودی کالا، مقصد و هماهنگی نهایی با فروشگاه مشخص می‌شود.</span>
            </p>
        </header>

        <ol class="shipping-steps">
            @for (var i = 0; i < Math.Max(shippingSections.Count, shippingSections.Count == 0 ? shippingFallback.Length : 0); i++)
            {
                var section = shippingSections.Count > 0 ? shippingSections[i] : null;
                var heading = section?.Heading ?? shippingFallback[i].Heading;
                var body = section?.Body ?? shippingFallback[i].Body;
                <li class="shipping-step">
                    <span class="shipping-step-top">
                        <span class="shipping-step-number">@((i + 1).ToString("D2", System.Globalization.CultureInfo.GetCultureInfo("fa-IR")))</span><i class="bi @(shippingIcons[i % shippingIcons.Length])" aria-hidden="true"></i>
                    </span>
                    <h3>@heading</h3>
                    @foreach (var paragraph in body.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <p>@paragraph</p>
                    }
                </li>
            }
        </ol>

        <div class="shipping-note">
            <span class="shipping-note-icon">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
            </span>
            <p>
                <strong>هزینه و زمان ارسال</strong><span>مبلغ و زمان ثابت نیست و پس از بررسی موجودی و مقصد، پیش از تأیید سفارش به شما اعلام می‌شود.</span>
            </p>
        </div>

        <div class="shipping-actions">
            <a class="shipping-action-primary" asp-controller="Contact" asp-action="Index">هماهنگی ارسال با پشتیبانی <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            <a class="shipping-action-secondary" asp-controller="Tracking" asp-action="Index"><i class="bi bi-box-seam" aria-hidden="true"></i> پیگیری سفارش</a>
        </div>
    </section>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="~/shop/css/pages/shipping.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="~/shop/js/pages/page-content.js" asp-append-version="true"></script>
}
