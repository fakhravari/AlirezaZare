@model PageModel


<header class="page-hero about-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>شرایط ارسال</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>شرایط ارسال</h1>
        <p>
            روش، هزینه و زمان تحویل با توجه به مقصد و موجودی سفارش اعلام می‌شود.
        </p>
        <div class="hero-trail">
            <span>موجودی</span>
            <span>روش ارسال</span>
            <span>هزینه و زمان</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main shipping-page">
    <section class="shipping-shell" aria-labelledby="shippingProcessTitle">
        <header class="shipping-heading">
            <div>
                <span class="shipping-kicker"><i class="bi bi-truck" aria-hidden="true"></i> راهنمای ارسال</span>
                <h2 id="shippingProcessTitle">مسیر سفارش تا دریافت کالا</h2>
            </div>
            <p class="shipping-heading-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>جزئیات ارسال با توجه به موجودی کالا، مقصد و هماهنگی نهایی با فروشگاه مشخص می‌شود.</span></p>
        </header>

        <ol class="shipping-steps">
            <li class="shipping-step">
                <span class="shipping-step-top"><span class="shipping-step-number">۰۱</span><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
                <h3>هماهنگی سفارش</h3>
                <p>موجودی، نشانی مقصد و زمان آماده‌سازی را پیش از تأیید نهایی با فروشگاه بررسی کنید.</p>
            </li>
            <li class="shipping-step">
                <span class="shipping-step-top"><span class="shipping-step-number">۰۲</span><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <h3>تعیین روش ارسال</h3>
                <p>روش ارسال، هزینه و زمان تقریبی تحویل متناسب با مقصد و شرایط سفارش اعلام می‌شود.</p>
            </li>
            <li class="shipping-step">
                <span class="shipping-step-top"><span class="shipping-step-number">۰۳</span><i class="bi bi-box2-heart" aria-hidden="true"></i></span>
                <h3>بررسی هنگام دریافت</h3>
                <p>سلامت بسته و تطابق اقلام را بررسی کنید و هرگونه مغایرت یا آسیب را به پشتیبانی اطلاع دهید.</p>
            </li>
        </ol>

        <div class="shipping-note">
            <span class="shipping-note-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
            <p><strong>هزینه و زمان ارسال</strong><span>مبلغ و زمان ثابت نیست و پس از بررسی موجودی و مقصد، پیش از تأیید سفارش به شما اعلام می‌شود.</span></p>
        </div>

        <div class="shipping-actions">
            <a class="shipping-action-primary" asp-controller="Contact" asp-action="Index">هماهنگی ارسال با پشتیبانی <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            <a class="shipping-action-secondary" asp-controller="Tracking" asp-action="Index"><i class="bi bi-box-seam" aria-hidden="true"></i> پیگیری سفارش</a>
        </div>
    </section>
</main>
<section class="shipping-related-section" aria-label="صفحات مرتبط با ارسال">
    <div class="container">
        <partial name="_RelatedLinks"/>
    </div>
</section>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="~/Shop/css/pages/shipping.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
