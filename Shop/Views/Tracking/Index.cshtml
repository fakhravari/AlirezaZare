@model PageModel


<header class="page-hero about-hero">
    <div class="container">
        <nav class="article-breadcrumb tracking-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span>پیگیری سفارش</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>پیگیری سفارش</h1>
        <p>
            کد سفارش و شماره همراه ثبت‌شده را برای پیگیری آماده کنید.
            پشتیبانی در ساعات کاری پاسخ‌گو است.
        </p>
        <div class="hero-trail">
            <span>کد سفارش</span>
            <span>شماره همراه</span>
            <span>پشتیبانی</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main tracking-page">
    <div class="flow-grid tracking-layout">
        <form class="flow-card tracking-card tracking-form-card" id="trackingForm">
            <div class="tracking-card-heading">
                <span class="tracking-card-icon">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                </span>
                <div>
                    <span class="tracking-eyebrow"><i class="bi bi-search" aria-hidden="true"></i>پیگیری آنلاین سفارش</span>
                    <h2>استعلام وضعیت سفارش</h2>
                    <p>کد سفارش و شماره همراه ثبت‌شده در خرید را وارد کنید.</p>
                </div>
            </div>
            <label class="tracking-field">
                <span>کد سفارش</span>
                <span class="tracking-input">
                    <input required name="order" autocomplete="off" placeholder="مثلاً HN-۱۴۰۵۰۶۲۱"><i class="bi bi-receipt" aria-hidden="true"></i>
                </span>
            </label>
            <label class="tracking-field">
                <span>شماره همراه خریدار</span>
                <span class="tracking-input">
                    <input required type="tel" name="phone" inputmode="numeric" pattern="[0-9۰-۹٠-٩]{11}" placeholder="۰۹۱۲۱۲۳۴۵۶۷"><i class="bi bi-phone" aria-hidden="true"></i>
                </span>
            </label>
            <button class="flow-button tracking-submit">
                <span>بررسی وضعیت</span><i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>
            <p id="trackingStatus" role="status"></p>
        </form>
        <aside class="flow-card tracking-card tracking-support-card">
            <span class="tracking-support-orbit" aria-hidden="true"></span>
            <div class="tracking-support-copy">
                <span class="tracking-card-icon">
                    <i class="bi bi-headset" aria-hidden="true"></i>
                </span>
                <span class="tracking-eyebrow"><i class="bi bi-chat-dots" aria-hidden="true"></i>پشتیبانی سفارش</span>
                <h2>برای پیگیری واقعی تماس بگیرید</h2>
                <p>این نسخه به سامانه سفارش متصل نیست؛ برای پیگیری، کد سفارش را به پشتیبانی بدهید.</p>
                <ul class="tracking-support-points">
                    <li><i class="bi bi-shield-check" aria-hidden="true"></i> بررسی دقیق وضعیت سفارش</li><li><i class="bi bi-clock-history" aria-hidden="true"></i> پاسخ‌گویی در ساعات کاری</li>
                </ul>
                <a class="flow-button tracking-support-action" href="tel:03969455457">
                    <span>تماس با پشتیبانی</span><i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
        </aside>
    </div>
</main>
<section class="tracking-related-section" aria-label="صفحات مرتبط با پیگیری سفارش">
    <div class="container">
        <partial name="_RelatedLinks"/>
    </div>
</section>


@section Styles {
    <link href="~/Shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="~/Shop/css/pages/tracking.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
}
