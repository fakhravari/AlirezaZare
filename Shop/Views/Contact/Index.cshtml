@model PageModel


<header class="page-hero contact-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current">
                    <i class="bi bi-headset"></i>
                    <span>ارتباط با ما</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">تماس با ندا اولیائی</span>
        <h1>برای خرید و پشتیبانی <em>کنار شماییم</em></h1>
        <p>
            برای خرید، پیگیری سفارش یا خدمات پس از فروش با ما تماس بگیرید.
        </p>
        <div class="hero-trail">
            <span>پیش از خرید</span>
            <span>سفارش</span>
            <span>خدمات</span>
        </div>
    </div>
</header>
<main>
    <section class="page-section contact-section" aria-label="راه‌های تماس و ارسال درخواست">
        <div class="container">
            <div class="contact-layout">
                <aside class="contact-panel">
                    <span class="page-kicker">راه‌های ارتباطی</span>
                    <h2>از کجا شروع کنیم؟</h2>
                    <p>
                        موضوع درخواستتان را انتخاب کنید تا پیام یا تماس شما به مسیر
                        مناسب هدایت شود.
                    </p>
                    <a class="contact-method" href="tel:03969455457" aria-label="تماس مستقیم با شماره 03969455457">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <span>
                            <small>تماس مستقیم</small>
                            <strong dir="ltr">03969455457</strong>
                        </span>
                        <i class="bi bi-arrow-up-left contact-method-action" aria-hidden="true"></i>
                    </a>
                    <a class="contact-method" href="tel:03969455457" aria-label="تماس با پشتیبانی به شماره 03969455457">
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <span>
                            <small>پشتیبانی و پیگیری سفارش</small>
                            <strong dir="ltr">03969455457</strong>
                        </span>
                        <i class="bi bi-arrow-up-left contact-method-action" aria-hidden="true"></i>
                    </a>
                    <a class="contact-method" href="mailto:neda.oliyai67@gmail.com" aria-label="ارسال ایمیل به neda.oliyai67@gmail.com">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <span>
                            <small>ایمیل مجموعه</small>
                            <strong dir="ltr">neda.oliyai67@gmail.com</strong>
                        </span>
                        <i class="bi bi-arrow-up-left contact-method-action" aria-hidden="true"></i>
                    </a>
                    <div class="contact-panel-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <p>برای پیگیری سفارش، شماره سفارش را در متن پیام بنویسید.</p>
                    </div>
                </aside>
                <div class="glass-card contact-form">
                    <div class="section-title">
                        <span class="page-kicker">فرم ارتباط با ما</span>
                        <h2>پیام خود را برای ما بفرستید</h2>
                        <p class="contact-form-intro">ارسال پیام از این فرم هنوز فعال نیست. برای ارتباط با ما از تلفن یا ایمیل درج‌شده استفاده کنید.</p>
                    </div>
                    <form id="contactForm" novalidate>
                        <div class="form-grid">
                            <div class="field">
                                <label for="contactName">نام و نام خانوادگی</label>
                                <input id="contactName" name="name" autocomplete="name" required placeholder="نام شما" aria-describedby="contactNameError"/>
                                <span id="contactNameError" class="field-validation-valid" role="alert"></span>
                            </div>
                            <div class="field">
                                <label for="contactPhone">شماره موبایل</label>
                                <input
                                    id="contactPhone"
                                    name="phone"
                                    type="tel"
                                    autocomplete="tel"
                                    required
                                    placeholder="۰۹۱۲۱۲۳۴۵۶۷"
                                    inputmode="numeric"
                                    maxlength="11"
                                    aria-describedby="contactPhoneError"/>
                                <span id="contactPhoneError" class="field-validation-valid" role="alert"></span>
                            </div>
                            <div class="field full">
                                <label for="contactSubject">موضوع درخواست</label>
                                <select id="contactSubject" required aria-describedby="contactSubjectError">
                                    <option value="">موضوع درخواست را انتخاب کنید</option>
                                    <option value="order">پیگیری سفارش</option>
                                    <option value="consultation">مشاوره پیش از خرید</option>
                                    <option value="after-sales">خدمات پس از فروش</option>
                                    <option value="business">همکاری سازمانی</option>
                                    <option value="other">سایر درخواست‌ها</option>
                                </select>
                                <span id="contactSubjectError" class="field-validation-valid" role="alert"></span>
                            </div>
                            <div class="field full">
                                <label for="contactMessage">متن پیام</label>
                                <textarea
                                    id="contactMessage"
                                    name="message"
                                    required
                                    minlength="10"
                                    aria-describedby="contactMessageError"
                                    placeholder="شرح درخواست، مدل کالا یا شماره سفارش را بنویسید."></textarea>
                                <span id="contactMessageError" class="field-validation-valid" role="alert"></span>
                            </div>
                            <div class="field full">
                                <button class="submit-btn contact-submit" type="submit">
                                    <span>بررسی اطلاعات</span><i class="bi bi-send" aria-hidden="true"></i>
                                </button>
                                <div id="contactStatus" class="contact-form-status" role="status" aria-live="polite" hidden></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
    <section class="page-section contact-shortcuts">
        <div class="container">
            <div class="contact-shortcuts-heading">
                <div>
                    <span class="page-kicker">دسترسی سریع</span>
                    <h2>درخواست شما کدام بخش را مربوط می‌شود؟</h2>
                </div>
                <p class="contact-shortcuts-note"><i class="bi bi-compass" aria-hidden="true"></i><span>برای رسیدن سریع‌تر به اطلاعات موردنیاز، یکی از مسیرهای زیر را انتخاب کنید.</span></p>
            </div>
            <div class="contact-shortcuts-grid">
                <a class="contact-shortcut-card" asp-controller="Tracking" asp-action="Index">
                    <span class="contact-shortcut-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                    <span><strong>پیگیری سفارش</strong><small>بررسی وضعیت و مراحل ارسال سفارش</small></span>
                    <i class="bi bi-arrow-left contact-shortcut-arrow" aria-hidden="true"></i>
                </a>
                <a class="contact-shortcut-card" asp-controller="Warranty" asp-action="Index">
                    <span class="contact-shortcut-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                    <span><strong>ضمانت و خدمات</strong><small>آشنایی با شرایط ضمانت و خدمات پس از فروش</small></span>
                    <i class="bi bi-arrow-left contact-shortcut-arrow" aria-hidden="true"></i>
                </a>
                <a class="contact-shortcut-card" asp-controller="Faq" asp-action="Index">
                    <span class="contact-shortcut-icon"><i class="bi bi-question-circle" aria-hidden="true"></i></span>
                    <span><strong>سوالات متداول</strong><small>پاسخ پرسش‌های رایج درباره خرید و پشتیبانی</small></span>
                    <i class="bi bi-arrow-left contact-shortcut-arrow" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>
</main>


@section Styles {
    <link href="~/Shop/css/pages/contact.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/form-confirm-dialog.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/form-confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/contact.js" asp-append-version="true"></script>
}
