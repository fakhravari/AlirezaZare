@model PageModel

<header class="page-hero about-hero legal-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i><span>حریم خصوصی</span>
                </span>
            </span>
        </nav>
        <h1>حریم خصوصی</h1>
        <p>نحوهٔ نگهداری اطلاعات و تنظیمات استفاده از فروشگاه را بخوانید.</p>
        <div class="hero-trail">
            <span>اطلاعات حساب</span><span>تنظیمات مرورگر</span><span>حفاظت از داده‌ها</span>
        </div>
    </div>
</header>

<main class="flow-main container legal-main">
    <article class="flow-card legal-document privacy-document">
        <div class="privacy-intro">
            <span class="privacy-intro-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <div>
                <span class="privacy-intro-label">راهنمای حریم خصوصی</span>
                <h2>اطلاعات شما، روشن و قابل‌فهم</h2>
                <p>با یک نگاه، محل نگهداری اطلاعات مرورگر، وضعیت فرم‌ها و راه مدیریت داده‌های ذخیره‌شده را مرور کنید.</p>
            </div>
        </div>
        <section class="legal-section">
            <h2><i class="bi bi-database-lock" aria-hidden="true"></i> چه اطلاعاتی در مرورگر ذخیره می‌شود؟</h2>
            <p>برای کارکرد فروشگاه، اقلام سبد خرید، علاقه‌مندی‌ها، فهرست مقایسه و بعضی تنظیمات رابط کاربری در فضای ذخیره‌سازی مرورگر شما نگهداری می‌شوند. این اطلاعات به پاک‌کردن داده‌های سایت یا مرورگر وابسته‌اند و ممکن است با حذف آن‌ها از بین بروند.</p>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-ui-checks" aria-hidden="true"></i> اطلاعات فرم‌ها</h2>
            <p>در نسخه فعلی، فرم‌های حساب کاربری و تسویه‌حساب به سامانه ثبت سفارش، پرداخت بانکی یا ارسال ایمیل متصل نیستند. برای خرید واقعی، اطلاعات حساس بانکی یا رمزهای خود را در این نسخه وارد نکنید و با فروشگاه از راه‌های درج‌شده در صفحه تماس ارتباط بگیرید.</p>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-shield-check" aria-hidden="true"></i> استفاده و حفاظت از اطلاعات</h2>
            <p>در صورت فعال‌شدن خدمات واقعی، اطلاعات لازم برای پاسخ‌گویی، پیگیری سفارش و پشتیبانی فقط برای همان هدف استفاده خواهد شد؛ جز در مواردی که ارائه اطلاعات به موجب قانون لازم باشد. جزئیات سامانه‌ها و طرف‌های پردازش پیش از فعال‌شدن این خدمات در همین صفحه اعلام می‌شود.</p>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-sliders" aria-hidden="true"></i> مدیریت اطلاعات</h2>
            <p>برای پاک‌کردن فهرست‌های ذخیره‌شده، داده‌های این وب‌سایت را از تنظیمات مرورگر حذف کنید. برای پرسش درباره حریم خصوصی یا درخواست‌های مربوط به اطلاعات، از صفحه تماس با ما استفاده کنید.</p>
        </section>
        <p class="legal-updated"><i class="bi bi-calendar-check" aria-hidden="true"></i><time datetime="2026-10-19">آخرین بازبینی: ۲۷ مهر ۱۴۰۵</time></p>
        <div class="legal-actions">
            <a class="flow-button" asp-controller="Contact" asp-action="Index">تماس درباره حریم خصوصی <i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            <a class="ui-inline-action" asp-controller="Legal" asp-action="Terms"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> شرایط استفاده</a>
        </div>
    </article>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
}
