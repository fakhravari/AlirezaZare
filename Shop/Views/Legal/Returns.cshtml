@model PageModel

<header class="page-hero about-hero legal-hero">
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span>بازگرداندن کالا</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">راهنمای انصراف و پیگیری</span>
        <h1>رویه بازگرداندن کالا</h1>
        <p>مراحل ثبت و پیگیری درخواست بازگشت یا مغایرت کالا را ببینید.</p>
        <div class="hero-trail">
            <span>ثبت درخواست</span><span>بررسی شرایط</span><span>هماهنگی بازگشت</span>
        </div>
    </div>
</header>

<main class="flow-main container legal-main">
    <article class="flow-card legal-document returns-document">
        <div class="returns-intro">
            <span class="returns-intro-icon"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
            <div>
                <span class="returns-intro-label">راهنمای بازگشت کالا</span>
                <h2>مسیر پیگیری، روشن و مرحله‌به‌مرحله</h2>
                <p>شرایط انصراف، آماده‌سازی کالا و پیگیری مغایرت را پیش از هر اقدامی مرور کنید و برای هماهنگی با فروشگاه در ارتباط باشید.</p>
            </div>
        </div>
        <section class="legal-section">
            <h2><i class="bi bi-calendar2-check" aria-hidden="true"></i> مهلت انصراف از خرید از راه دور</h2>
            <p>بر اساس مواد ۳۷ و ۳۸ قانون تجارت الکترونیکی، در معاملهٔ از راه دور مصرف‌کننده دست‌کم هفت روز کاری برای انصراف، بدون ارائهٔ دلیل و بدون جریمه فرصت دارد. در خرید کالا، این مهلت از روز تحویل آغاز می‌شود و اعمال آن پس از ارائهٔ اطلاعات الزامی معامله امکان‌پذیر است. برخی کالاها و خدمات طبق قانون و مقررات مربوط از حق انصراف مستثنا هستند؛ تشخیص مورد، تابع همان مقررات است.</p>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-box-seam" aria-hidden="true"></i> پیش از بازگرداندن کالا</h2>
            <ul>
                <li>پیش از ارسال کالا با فروشگاه تماس بگیرید و شماره سفارش یا فاکتور را اعلام کنید.</li>
                <li>تا دریافت راهنمایی، بسته‌بندی، متعلقات و مدارک خرید را نگه دارید و کالا را به نشانی تأییدنشده نفرستید.</li>
                <li>در اعمال حق انصراف، هزینهٔ بازگرداندن کالا می‌تواند بر عهدهٔ مصرف‌کننده باشد. اگر کالای ارسال‌شده با موضوع سفارش متفاوت باشد، هزینهٔ بازگشت مطابق مادهٔ ۴۱ قانون تجارت الکترونیکی بر عهدهٔ تأمین‌کننده است.</li>
            </ul>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-exclamation-circle" aria-hidden="true"></i> کالای معیوب یا مغایر با سفارش</h2>
            <p>اگر کالا آسیب‌دیده، ناقص یا مغایر با سفارش به دستتان رسید، برای ثبت و بررسی موضوع با پشتیبانی تماس بگیرید و شمارهٔ فاکتور و شرح مشکل را ارائه کنید. تا پیش از هماهنگی، کالا را به نشانی تأییدنشده نفرستید. حقوق قانونی مصرف‌کننده، از جمله مقررات مربوط به ارسال کالای متفاوت با سفارش، محفوظ است.</p>
        </section>
        <section class="legal-section">
            <h2><i class="bi bi-cash-coin" aria-hidden="true"></i> بازپرداخت</h2>
            <p>در معاملهٔ واقعی، پس از استفاده از حق انصراف، تأمین‌کننده مکلف است مبلغ دریافتی را مطابق مادهٔ ۳۸ قانون تجارت الکترونیکی فوراً به مصرف‌کننده بازگرداند. در نسخهٔ فعلی این وب‌سایت پرداخت آنلاین فعال نیست، بنابراین وجهی از طریق سایت دریافت یا بازپرداخت نمی‌شود.</p>
        </section>
        <p class="legal-updated"><i class="bi bi-calendar-check" aria-hidden="true"></i><time datetime="2026-10-19">آخرین بازبینی: ۲۷ مهر ۱۴۰۵</time></p>
        <div class="legal-actions">
            <a class="flow-button" asp-controller="Contact" asp-action="Index">تماس برای پیگیری <i class="bi bi-arrow-left" aria-hidden="true"></i></a><a class="ui-inline-action" asp-controller="Faq" asp-action="Index">پرسش‌های متداول</a>
        </div>
    </article>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
}
