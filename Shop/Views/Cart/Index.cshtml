@model PageModel


<header class="page-hero cart-page-hero">
    <div class="container">
        <nav class="cart-breadcrumb" aria-label="مسیر صفحه">
        <ol>
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                </a>
            </li>
            <li class="cart-breadcrumb-current">
                <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page"><i class="bi bi-bag" aria-hidden="true"></i>سبد خرید</span>
            </li>
        </ol>
    </nav>
        <span class="page-kicker">مرور انتخاب‌ها</span>
        <h1>سبد خرید</h1>
        <p>یک قدم نزدیک‌تر به انتخاب شما</p>
        <div class="hero-trail" aria-label="مزایای خرید">
            <span>بررسی اقلام</span>
            <span>تطبیق نشانی</span>
            <span>اطلاع از شرایط تحویل</span>
        </div>
    </div>
</header>
<main class="flow-main container cart-page-main">
    <section class="cart-address-section">
        <div class="invoice-section-title">
            <i class="bi bi-geo-alt"></i>
            <div>
                <h2>آدرس تحویل سفارش</h2>
                <p>آدرس موردنظر را پیش از مشاهده پیش‌فاکتور انتخاب کنید.</p>
            </div>
            <span class="address-selected-badge" aria-hidden="true">
                <i class="bi bi-check2-circle"></i> انتخاب‌شده
            </span>
        </div><label for="addressSelect">آدرس انتخابی</label>
        <div class="address-picker">
            <div class="address-select-wrap">
                <select id="addressSelect" aria-describedby="addressPreview">
                    <option value="">آدرسی ثبت نشده است</option>
                </select><i class="bi bi-chevron-down" aria-hidden="true"></i>
            </div>
            <button id="newAddress" type="button" aria-label="تعریف آدرس جدید" title="تعریف آدرس جدید">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div id="addressPreview" class="address-preview" aria-live="polite"></div>
        <p id="addressStatus" role="status"></p>
    </section>
    <section class="cart-payment-section" aria-labelledby="paymentMethodTitle">
        <div class="invoice-section-title">
            <i class="bi bi-credit-card"></i>
            <div>
                <h2 id="paymentMethodTitle">نحوه پرداخت</h2>
                <p>درگاه موردنظر را برای پرداخت سفارش انتخاب کنید.</p>
            </div>
        </div>
        <div class="payment-methods" role="radiogroup" aria-labelledby="paymentMethodTitle">
            <label class="payment-method">
                <input type="radio" name="paymentMethod" value="zarinpal" checked required>
                <span class="payment-method-icon">
                    <img src="~/Shop/images/payments/zarinpal.svg" asp-append-version="true" alt="" width="42" height="42" loading="lazy">
                </span>
                <span>
                    <strong>زرین‌پال</strong><small>درگاه نمایشی؛ پرداخت فعال نیست</small>
                </span>
                <i class="bi bi-check-circle-fill payment-method-check" aria-hidden="true"></i>
            </label>
            <label class="payment-method is-disabled" aria-disabled="true">
                <input type="radio" name="paymentMethod" value="snappay" disabled>
                <span class="payment-method-icon">
                    <img src="~/Shop/images/payments/snappay.svg" asp-append-version="true" alt="" width="42" height="42" loading="lazy">
                </span>
                <span>
                    <strong>اسنپ‌پی</strong><small>به‌زودی فعال می‌شود</small>
                </span>
                <span class="payment-method-soon">به‌زودی</span>
            </label>
        </div>
        <p id="paymentMethodStatus" class="payment-method-status" role="status"></p>
    </section>
    <div id="cartView"><section class="cart-empty-state"><div class="cart-empty-copy"><span class="cart-empty-kicker">سبد خرید</span><h2>سبد خرید شما خالی است</h2><p>کالایی به سبد اضافه نشده است. برای مرور محصولات یا راهنمای انتخاب از پیوندهای زیر استفاده کنید.</p><div class="cart-empty-actions"><a class="flow-button" asp-controller="Product" asp-action="List">مرور محصولات</a><a class="ui-inline-action" asp-controller="Magazine" asp-action="Index">مطالعهٔ راهنماها</a></div></div></section></div>
    <dialog id="addressDialog" class="address-dialog" aria-labelledby="addressDialogTitle">
        <div class="address-dialog-heading">
            <div class="address-dialog-title">
                <span class="address-dialog-icon">
                    <i class="bi bi-geo-alt"></i>
                </span>
                <div>
                    <span class="address-dialog-kicker">اطلاعات تحویل سفارش</span>
                    <h2 id="addressDialogTitle">تعریف آدرس جدید</h2>
                    <p>مشخصات گیرنده و محل تحویل را با دقت وارد کنید.</p>
                </div>
            </div>
            <button class="site-modal-close" id="closeAddress" type="button" aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <partial name="_AddressForm"/>
    </dialog>
    <partial name="_RelatedLinks"/>
</main>

<partial name="_PurchaseBenefits"/>

@section Styles {
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/checkout.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/Shop/css/pages/form-confirm-dialog.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/Shop/js/pages/page-content.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/iran-places.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/address-fields.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/checkout.js" asp-append-version="true"></script>
    <script src="~/Shop/js/pages/form-confirm-dialog.js" asp-append-version="true"></script>
}
