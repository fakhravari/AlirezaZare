@model PageModel

<header class="page-hero cart-page-hero checkout-page-hero">
    <div class="container">
        <nav class="cart-breadcrumb" aria-label="مسیر صفحه">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door" aria-hidden="true"></i><span>خانه</span>
                    </a>
                </li>
                <li class="cart-breadcrumb-current">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page"><i class="bi bi-receipt" aria-hidden="true"></i>پرداخت سفارش</span>
                </li>
            </ol>
        </nav>
        <h1>پرداخت سفارش</h1>
        <p>سفارش شما ثبت شده است؛ اطلاعات آن را بررسی و پرداخت کنید.</p>
        <div class="hero-trail" aria-label="مراحل سفارش">
            <span>بررسی اقلام</span>
            <span>تأیید آدرس</span>
            <span>پرداخت نهایی</span>
        </div>
    </div>
</header>

<main class="flow-main container invoice-page" data-address-id="@ViewData["CheckoutAddressId"]" data-payment-method="@ViewData["CheckoutPaymentMethod"]">
    <div class="flow-grid" id="checkoutPanel">
        <section class="flow-card">
            <div class="invoice-section-title">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <h2>آدرس انتخابی</h2>
                    <p>نشانی ثبت‌شده برای سفارش</p>
                </div>
            </div>
            <div id="checkoutAddressPreview" class="address-preview checkout-address-preview" aria-live="polite"></div>
            <div class="invoice-section-title invoice-payment-title">
                <i class="bi bi-credit-card"></i>
                <div>
                    <h2>نحوه پرداخت</h2>
                    <p id="checkoutPaymentMethod">درگاه انتخاب‌شده در سبد خرید</p>
                </div>
            </div>
            <div class="invoice-section-title invoice-products-title">
                <i class="bi bi-bag-check"></i>
                <h2>اقلام سفارش</h2>
            </div>
            <div id="savedOrderItems">
                <p class="flow-empty">در حال دریافت سفارش...</p>
            </div>
        </section>
        <aside class="flow-card cart-summary">
            <div id="savedOrderSummary">
                <div class="cart-summary-heading">
                    <h2>خلاصهٔ سفارش</h2>
                </div>
                <p>در حال دریافت مبلغ سفارش...</p>
            </div>
            <p class="cart-shipping-note">هزینه ارسال پس از تأیید فروشگاه مشخص می‌شود.</p><button id="finalPayment" type="button" class="flow-button cart-checkout-link" disabled>پرداخت سفارش <i class="bi bi-arrow-left" aria-hidden="true"></i></button>
            <p class="invoice-demo-note">در صورت در دسترس نبودن درگاه، سفارش در حساب شما در انتظار پرداخت باقی می‌ماند.</p>
            <p id="paymentStatus" role="status"></p>
        </aside>
    </div>

</main>

<partial name="_PurchaseBenefits"/>

@section Styles {
    <link href="~/shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/checkout.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/page-content.js" asp-append-version="true"></script>
    <script src="~/shop/js/pages/checkout.js" asp-append-version="true"></script>
}
