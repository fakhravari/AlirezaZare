@using System.Globalization
@using Shop.Models
@model PageModel<MagazineIndexViewModel>
@{
    var posts = Model.Data.Posts;
    string PersianDigits(int value) => string.Concat(value.ToString(CultureInfo.InvariantCulture).Select(digit => digit is >= '0' and <= '9' ? (char)('\u06F0' + digit - '0') : digit));
}
<header class="page-hero editorial-hero">
    <img class="hero-image" src="~/shop/images/heroes/hero-electrical-editorial.png" alt="مجله تخصصی برق و ابزار ندا اولیائی"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i><span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-journal-richtext"></i><span>مجله</span>
                </span>
            </span>
        </nav>
        <h1>مجله برق و <em>ابزار</em></h1>
        <p>راهنماهای کاربردی برای انتخاب، استفاده و نگهداری ابزار و تجهیزات فنی.</p>
        <div class="hero-trail" aria-label="موضوعات مجله">
            <span>راهنمای خرید</span>
            <span>دانش فنی</span>
            <span>ایمنی و نگهداری</span>
        </div>
    </div>
</header>
<main class="journal-page">
    <section class="container journal-archive" aria-labelledby="archive-title">
        <aside class="journal-categories" aria-label="دسته‌بندی مطالب">
            <div class="journal-categories-scroll ui-scrollbar ui-scrollbar--navy">
                <h2>دسته‌بندی مجله</h2>
                <button type="button" class="is-active journal-all" data-journal-filter="all" aria-pressed="true"><span class="journal-all-label"><i class="bi bi-grid" aria-hidden="true"></i> همه مطالب</span><span class="journal-category-count">@PersianDigits(Model.Data.TotalCount)</span></button>
                <div class="journal-branch">
                    <button type="button" data-journal-filter="buying" aria-pressed="false"><i class="bi bi-cart-check" aria-hidden="true"></i><span>راهنمای خرید</span><span class="journal-category-count">@PersianDigits(Model.Data.BuyingCount)</span></button>
                </div>
                <div class="journal-branch">
                    <button type="button" data-journal-filter="education" aria-pressed="false"><i class="bi bi-mortarboard" aria-hidden="true"></i><span>آموزش تخصصی</span><span class="journal-category-count">@PersianDigits(Model.Data.EducationCount)</span></button>
                </div>
                <div class="journal-branch journal-branch--areas">
                    <button type="button" data-journal-filter="safety" aria-pressed="false"><i class="bi bi-shield-check" aria-hidden="true"></i><span>ایمنی و نگهداری</span><span class="journal-category-count">@PersianDigits(Model.Data.SafetyCount)</span></button>
                    <div class="journal-children" aria-label="حوزه‌های مجله">
                        <button type="button" data-journal-filter="area-tools" aria-pressed="false"><i class="bi bi-tools" aria-hidden="true"></i><span>ابزار و تجهیزات</span><span class="journal-category-count">@PersianDigits(Model.Data.ToolsCount)</span></button>
                        <button type="button" data-journal-filter="area-electrical" aria-pressed="false"><i class="bi bi-lightning-charge" aria-hidden="true"></i><span>برق و اندازه‌گیری</span><span class="journal-category-count">@PersianDigits(Model.Data.ElectricalCount)</span></button>
                        <button type="button" data-journal-filter="area-workshop" aria-pressed="false"><i class="bi bi-lightbulb" aria-hidden="true"></i><span>روشنایی و کارگاه</span><span class="journal-category-count">@PersianDigits(Model.Data.WorkshopCount)</span></button>
                    </div>
                </div>
            </div>
        </aside>
        <div class="journal-results">
            <div class="journal-results-heading">
                <h2 id="archive-title" tabindex="-1">راهنماهای ابزار و تجهیزات</h2><span id="journal-count" class="journal-count-badge" role="status" aria-live="polite">@PersianDigits(Model.Data.TotalCount) مطلب</span>
            </div>
            <div class="journal-grid">

                @foreach (var post in posts)
                {
                    <article class="journal-post" data-branch="@post.Branch" data-topic="@post.Topic" data-area="@post.Area">
                        <a asp-controller="Magazine" asp-action="Details" asp-route-slug="@post.Slug">
                            <div class="journal-post-image">
                                <img src="@Url.Content("~/" + post.Image)" alt="@post.Title" loading="lazy"/>
                                <span class="journal-kicker">@post.Category</span>
                            </div>
                            <div class="journal-post-copy">
                                <h3>@post.Title</h3>
                                <div class="journal-post-meta">
                                    @if (!string.IsNullOrWhiteSpace(post.PublishedAt))
                                    {
                                        <span><i class="bi bi-calendar3" aria-hidden="true"></i>@post.PublishedAt</span>
                                    }
                                    <span><i class="bi bi-clock" aria-hidden="true"></i>@post.ReadMinutes دقیقه</span>
                                </div>
                            </div>
                        </a>
                    </article>

                }
            </div>
            <nav id="journal-pagination" class="journal-paging site-pagination" aria-label="صفحه‌بندی مطالب" hidden></nav>
        </div>
    </section>
</main>

@section Styles {
    <link href="~/shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/shop/css/pages/magazine-luxury.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts {
    <script src="~/shop/js/pages/magazine.js" asp-append-version="true"></script>
}
