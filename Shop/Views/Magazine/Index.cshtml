            <h2>دسته‌بندی مجله</h2>
            <button type="button" class="is-active journal-all" data-journal-filter="all" aria-pressed="true">همه مطالب <span>@postCount</span></button>
            <div class="journal-branch">
                <button type="button" data-journal-filter="buying" aria-pressed="false"><i class="bi bi-compass" aria-hidden="true"></i> راهنمای خرید</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="choose-watch" aria-pressed="false">چگونه ساعت مناسب انتخاب کنیم؟</button>
                    <button type="button" data-journal-filter="gift-watch" aria-pressed="false">بهترین ساعت برای هدیه</button>
                    <button type="button" data-journal-filter="budget-watch" aria-pressed="false">انتخاب ساعت بر اساس بودجه</button>
                    <button type="button" data-journal-filter="formal-choice" aria-pressed="false">انتخاب ساعت برای استایل رسمی</button>
                    <button type="button" data-journal-filter="daily-watch" aria-pressed="false">انتخاب ساعت برای استفاده روزمره</button>
                </div>
            </div>
            <div class="journal-branch">
                <button type="button" data-journal-filter="education" aria-pressed="false"><i class="bi bi-mortarboard" aria-hidden="true"></i> آموزش</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="watch-movements" aria-pressed="false">انواع موتور ساعت</button>
                    <button type="button" data-journal-filter="quartz-automatic" aria-pressed="false">تفاوت کوارتز و اتوماتیک</button>
                    <button type="button" data-journal-filter="watch-care" aria-pressed="false">نحوه نگهداری ساعت</button>
                    <button type="button" data-journal-filter="water-resistance" aria-pressed="false">مفهوم مقاومت در برابر آب</button>
                    <button type="button" data-journal-filter="watch-glass" aria-pressed="false">تفاوت انواع شیشه ساعت</button>
                    <button type="button" data-journal-filter="case-size" aria-pressed="false">راهنمای اندازه قاب</button>
                </div>
            </div>
            <div class="journal-branch">
                <button type="button" data-journal-filter="brands" aria-pressed="false"><i class="bi bi-award" aria-hidden="true"></i> برندشناسی</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="brand-history" aria-pressed="false">تاریخچه برندها</button>
                    <button type="button" data-journal-filter="brand-introduction" aria-pressed="false">معرفی برندها</button>
                    <button type="button" data-journal-filter="brand-comparison" aria-pressed="false">مقایسه برندها</button>
                    <button type="button" data-journal-filter="best-brand-models" aria-pressed="false">بهترین مدل‌های هر برند</button>
                </div>
            </div>
            <div class="journal-branch">
                <button type="button" data-journal-filter="comparison" aria-pressed="false"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> مقایسه</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="model-comparison" aria-pressed="false">مقایسه مدل‌ها</button>
                    <button type="button" data-journal-filter="compare-brands" aria-pressed="false">مقایسه برندها</button>
                    <button type="button" data-journal-filter="movement-comparison" aria-pressed="false">مقایسه موتورهای ساعت</button>
                    <button type="button" data-journal-filter="price-comparison" aria-pressed="false">مقایسه بازه‌های قیمتی</button>
                </div>
            </div>
            <div class="journal-branch">
                <button type="button" data-journal-filter="authenticity" aria-pressed="false"><i class="bi bi-patch-check" aria-hidden="true"></i> تشخیص و اصالت</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="original-watch" aria-pressed="false">تشخیص ساعت اصل</button>
                    <button type="button" data-journal-filter="buying-tips" aria-pressed="false">نکات خرید ساعت</button>
                    <button type="button" data-journal-filter="buying-mistakes" aria-pressed="false">اشتباهات رایج هنگام خرید</button>
                </div>
            </div>
            <div class="journal-branch">
                <button type="button" data-journal-filter="style" aria-pressed="false"><i class="bi bi-stars" aria-hidden="true"></i> سبک و استایل</button>
                <div class="journal-children">
                    <button type="button" data-journal-filter="formal-watch" aria-pressed="false">ساعت مناسب لباس رسمی</button>
                    <button type="button" data-journal-filter="sport-watch" aria-pressed="false">ساعت مناسب استایل اسپرت</button>
                    <button type="button" data-journal-filter="gift-style" aria-pressed="false">ساعت مناسب هدیه</button>
                    <button type="button" data-journal-filter="age-occasion" aria-pressed="false">انتخاب ساعت براساس سن و موقعیت</button>
                </div>
            </div>
            </div>
        </aside>
        <div class="journal-results">
            <div class="journal-results-heading"><h2 id="archive-title" tabindex="-1">همه نوشته‌های مجله</h2><span id="journal-count" class="journal-count-badge" role="status" aria-live="polite">@posts.Length مطلب</span></div>
            <div class="journal-grid">
                @{ var postIndex = 0; }
                @foreach (var post in posts)
                {
                    var publishedAt = DateTime.Today.AddDays(-(postIndex * 3 + 1));
                    var readingMinutes = 4 + postIndex % 5;
                    <article class="journal-post" data-branch="@post.Branch" data-topic="@post.Topic">
                        <a asp-controller="Magazine" asp-action="Details" asp-route-slug="@post.Slug">
                            <div class="journal-post-image"><img src="@Url.Content("~/Shop/images/" + (post.Image.StartsWith("slider-") ? "sliders/" : "products/") + post.Image)" alt="@post.Title" loading="lazy" /></div>
                            <div class="journal-post-copy"><span class="journal-kicker">@post.Category</span><h3>@post.Title</h3><p>@post.Summary</p><div class="journal-post-meta"><span><i class="bi bi-calendar3"></i>@publishedAt.ToString("yyyy/MM/dd", System.Globalization.CultureInfo.InvariantCulture)</span><span><i class="bi bi-clock"></i>@readingMinutes دقیقه مطالعه</span></div><span class="journal-read">خواندن مطلب <i class="bi bi-arrow-left" aria-hidden="true"></i></span></div>
                        </a>
                    </article>
                    postIndex++;
                }
            </div>
            <nav id="journal-pagination" class="journal-paging site-pagination" aria-label="صفحه‌بندی مطالب" hidden></nav>
        </div>
    </section>
    <section class="container journal-connect" aria-label="همراه مجله باشید">
        <div class="journal-subscribe">
            <span class="journal-connect-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></span>
            <div>
                <span class="journal-kicker">نامه مجله</span>
                <h2>فرصتی برای بیشتر دانستن</h2>
                <p>راهنماهای انتخاب و مراقبت از ساعت، در یک خبرنامه کوتاه.</p>
            </div>
            <div class="journal-subscribe-action">
                <span class="journal-soon">به‌زودی</span>
                <p>عضویت در خبرنامه هنوز فعال نشده است.</p>
            </div>
        </div>
    </section>
</main>
@section Styles {
    <link href="~/Shop/css/pages/pages.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/Shop/css/pages/magazine-luxury.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/Shop/js/pages/magazine.js" asp-append-version="true"></script>
}
