@model PageModel


<header class="page-hero about-hero">
    <img class="hero-image"
         src="@Url.Content("~/ClockTemplate/images/heroes/hero-electrical-service.png")"
         alt="موتور مکانیکی ساعت، ذره‌بین و کارت ضمانت" width="1536" height="1024" fetchpriority="high"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>ضمانت اصالت</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>ضمانت اصالت</h1>
        <p>
            هنگام تحویل ساعت، فاکتور، مشخصات مدل و کارت ضمانت را بررسی و نگهداری کنید.
            جزئیات پوشش و مدت خدمات هر محصول در مدارک همان ساعت و با تأیید فروشگاه مشخص می‌شود.
        </p>
        <div class="hero-trail">
            <span>بررسی مدارک محصول</span>
            <span>شرایط مختص هر مدل</span>
            <span>پشتیبانی خدمات پس از فروش</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main">
    <div class="flow-grid">
        <img class="flow-photo" src="ClockTemplate/images/products/tool-led-worklight.png" alt="جزئیات ساخت ساعت">
        <article class="flow-card">
            <h2>مدارک محصول را بررسی کنید</h2>
            <p>فاکتور، مدل و شماره مرجع ساعت و کارت ضمانت را هنگام تحویل بررسی و نگهداری کنید.</p>
            <h2>شرایط خدمات هر مدل</h2>
            <p>مدت ضمانت، موارد تحت پوشش و شرایط سرویس باید بر اساس کارت ضمانت همان محصول و تأیید فروشگاه مشخص شود.</p>
            <h2>درخواست خدمات</h2>
            <p>برای بررسی محصول، شرح مشکل و مشخصات خرید را با پشتیبانی در میان بگذارید.</p><a class="flow-button" href="Contact">ارتباط با خدمات مشتریان <i class="bi bi-arrow-left"></i></a>
        </article>
    </div>
    <partial name="_RelatedLinks" />
</main>


@section Styles {
    <link href="ClockTemplate/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="ClockTemplate/js/pages/page-content.js?v=1"></script>
}

