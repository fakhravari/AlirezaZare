@model PageModel


<header class="page-hero about-hero">
    <img class="hero-image"
         src="@Url.Content("~/ClockTemplate/images/heroes/hero-tracking.webp")"
         alt="بسته سفارش ساعت و نمایش مسیر پیگیری" width="1536" height="1024" fetchpriority="high"/>
    <div class="container">
        <nav class="article-breadcrumb tracking-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    <span>پیگیری سفارش</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>پیگیری سفارش</h1>
        <p>
            برای اطلاع از وضعیت سفارشتان، کد سفارش و شماره همراه ثبت‌شده را آماده کنید.
            پشتیبانی در ساعات کاری برای بررسی و راهنمایی شما پاسخ‌گو است.
        </p>
        <div class="hero-trail">
            <span>کد سفارش را آماده کنید</span>
            <span>شماره همراه خریدار</span>
            <span>پیگیری از پشتیبانی</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main tracking-page">
    <div class="flow-grid tracking-layout">
        <form class="flow-card tracking-card tracking-form-card" id="trackingForm">
            <div class="tracking-card-heading">
                <span class="tracking-card-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                <div><span class="tracking-eyebrow">پیگیری آنلاین سفارش</span><h2>استعلام وضعیت سفارش</h2><p>کد سفارش و شماره همراه ثبت‌شده در خرید را وارد کنید.</p></div>
            </div>
            <label class="tracking-field"><span>کد سفارش</span><span class="tracking-input"><input required name="order" autocomplete="off" placeholder="مثلاً HN-۱۴۰۵۰۶۲۱"><i class="bi bi-receipt" aria-hidden="true"></i></span></label>
            <label class="tracking-field"><span>شماره همراه خریدار</span><span class="tracking-input"><input required type="tel" name="phone" inputmode="numeric" pattern="[0-9۰-۹٠-٩]{11}" placeholder="۰۹۱۲۱۲۳۴۵۶۷"><i class="bi bi-phone" aria-hidden="true"></i></span></label>
            <button class="flow-button tracking-submit"><span>بررسی وضعیت</span><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
            <p id="trackingStatus" role="status"></p>
        </form>
        <aside class="flow-card tracking-card tracking-support-card">
            <span class="tracking-support-orbit" aria-hidden="true"></span>
            <div class="tracking-support-copy">
                <span class="tracking-card-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
                <span class="tracking-eyebrow">پشتیبانی سفارش</span>
                <h2>برای پیگیری واقعی تماس بگیرید</h2>
                <p>استعلام آنلاین در نسخه نمایشی متصل نیست. کد سفارش و مشخصات خرید را آماده کنید تا سریع‌تر راهنمایی‌تان کنیم.</p>
                <ul class="tracking-support-points"><li><i class="bi bi-shield-check" aria-hidden="true"></i> بررسی دقیق وضعیت سفارش</li><li><i class="bi bi-clock-history" aria-hidden="true"></i> پاسخ‌گویی در ساعات کاری</li></ul>
                <a class="flow-button tracking-support-action" href="tel:+989177764324"><span>تماس با پشتیبانی</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
            </div>
        </aside>
    </div>
    <partial name="_RelatedLinks" />
</main>


@section Styles {
    <link href="ClockTemplate/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
    <link href="ClockTemplate/css/pages/tracking.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="ClockTemplate/js/pages/page-content.js?v=1"></script>
}
