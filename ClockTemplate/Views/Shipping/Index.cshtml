@model PageModel


<header class="page-hero about-hero">
    <img class="hero-image"
         src="@Url.Content("~/ClockTemplate/images/heroes/hero-electrical-service.png")"
         alt="بسته‌بندی محافظ ساعت برای ارسال" width="1536" height="1024" fetchpriority="high"/>
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>شرایط ارسال</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">خدمات مشتریان</span>
        <h1>شرایط ارسال</h1>
        <p>
            از آماده‌سازی سفارش تا رسیدن ساعت به دست شما، روش ارسال، هزینه و زمان تحویل
            با توجه به مقصد و موجودی محصول هنگام تأیید سفارش مشخص می‌شود.
        </p>
        <div class="hero-trail">
            <span>بررسی موجودی پیش از ارسال</span>
            <span>هماهنگی روش و هزینه</span>
            <span>بررسی بسته هنگام تحویل</span>
        </div>
    </div>
</header>
<main class="flow-main container customer-service-main">
    <div class="flow-cards">
        <article class="flow-card">
            <i class="bi bi-box-seam"></i>
            <h2>آماده‌سازی سفارش</h2>
            <p>پیش از نهایی کردن خرید، موجودی محصول و زمان آماده‌سازی را با پشتیبانی بررسی کنید.</p>
        </article>
        <article class="flow-card">
            <i class="bi bi-truck"></i>
            <h2>روش و هزینه ارسال</h2>
            <p>روش ارسال، هزینه و زمان تحویل متناسب با مقصد، هنگام تأیید سفارش توسط فروشگاه اعلام می‌شود.</p>
        </article>
        <article class="flow-card">
            <i class="bi bi-clipboard-check"></i>
            <h2>هنگام دریافت</h2>
            <p>سلامت بسته‌بندی و تطابق محصول با سفارش را بررسی کنید و در صورت وجود مشکل با پشتیبانی تماس بگیرید.</p>
        </article>
    </div><a class="flow-button" href="Tracking">پیگیری سفارش <i class="bi bi-arrow-left"></i></a>
    <partial name="_RelatedLinks" />
</main>


@section Styles {
    <link href="ClockTemplate/css/pages/pages.css" asp-append-version="true" rel="stylesheet"/>
}

@section Scripts {
    <script src="ClockTemplate/js/pages/page-content.js?v=1"></script>
}
