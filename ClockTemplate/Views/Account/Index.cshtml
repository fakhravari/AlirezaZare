        <section id="addresses" class="account-section">
            <div class="account-section-heading">
                <h2>آدرس‌های من</h2><button id="newAddress" class="flow-button" type="button"><i class="bi bi-plus-lg"></i> آدرس جدید</button>
            </div>
            <div id="addressList"></div>
        </section>
        <section id="favorites" class="account-section">
            <h2>لیست علاقه‌مندی‌ها</h2>
            <div id="favoritesView"></div>
        </section>
        <section id="questions" class="account-section">
            <h2>دیدگاه‌ها و پرسش‌ها</h2>
            <form id="questionForm" class="flow-card">
                <label for="questionProduct">محصول<select id="questionProduct" name="product" required></select></label>
                <label>
                    نوع پیام
                    <select name="kind">
                        <option>پرسش</option><option>دیدگاه</option>
                    </select>
                </label><label>متن پیام<textarea name="message" maxlength="2000" rows="4" required placeholder="پرسش یا تجربه خود را بنویسید"></textarea></label><button class="flow-button">ذخیره پیش‌نویس</button>
                <p>پیش‌نویس فقط برای شما ذخیره می‌شود؛ برای دریافت پاسخ از فروشگاه با پشتیبانی تماس بگیرید.</p>
            </form>
            <div id="questionList"></div>
        </section>
        <p id="accountStatus" role="status"></p>
    </div>
</div>
<dialog id="addressDialog" class="address-dialog" aria-labelledby="addressDialogTitle">
    <div class="address-dialog-heading">
        <div class="address-dialog-title">
            <span class="address-dialog-icon">
                <i class="bi bi-geo-alt"></i>
            </span>
            <div>
                <span class="address-dialog-kicker">اطلاعات تحویل سفارش</span>
                <h2 id="addressDialogTitle">تعریف آدرس جدید</h2>
                <p>مشخصات گیرنده و محل تحویل را با دقت وارد کنید.</p>
            </div>
        </div>
        <button class="site-modal-close" id="closeAddress" type="button" aria-label="بستن">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <partial name="_AddressForm" />
</dialog>
<dialog id="profileEditDialog" class="shared-login-modal profile-edit-dialog" aria-labelledby="profileEditDialogTitle">
    <button class="login-close" type="button" data-profile-edit-close aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    <div class="login-brand"><span><i class="bi bi-person"></i></span><div><strong>کمپانی علی‌رضا زارع</strong><small>مدیریت اطلاعات حساب کاربری</small></div></div>
    <div class="login-step">
        <span class="profile-edit-kicker">اطلاعات شخصی</span>
        <h2 id="profileEditDialogTitle">ویرایش پروفایل</h2>
        <p>اطلاعات شخصی خود را برای تجربه خرید بهتر به‌روز کنید.</p>
        <form id="profileEditModalForm" class="profile-edit-form" autocomplete="off" novalidate>
            <label>نام<span class="login-input"><input name="firstName" value="محمدحسین" required maxlength="50" /><i class="bi bi-person" aria-hidden="true"></i></span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="firstName"></small></label>
            <label>نام خانوادگی<span class="login-input"><input name="lastName" value="فخراوری" required maxlength="50" /><i class="bi bi-person" aria-hidden="true"></i></span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="lastName"></small></label>
            <fieldset class="profile-edit-gender"><legend>جنسیت</legend><div><label><input type="radio" name="gender" value="male" checked /><span>آقا</span></label><label><input type="radio" name="gender" value="female" /><span>خانم</span></label></div><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="gender"></small></fieldset>
            <label>ایمیل<span class="login-input"><input name="email" type="email" placeholder="example@email.com" dir="ltr" /><i class="bi bi-envelope" aria-hidden="true"></i></span><small class="profile-edit-validation field-validation-valid" data-profile-edit-error="email"></small></label>
            <label class="profile-edit-full">شماره موبایل <small>قابل تغییر نیست</small><span class="login-input"><input name="phone" value="۰۹۱۷۷۷۶۴۳۲۴" type="tel" dir="ltr" readonly aria-readonly="true" /><i class="bi bi-phone" aria-hidden="true"></i></span></label>
            <button class="profile-edit-full" type="submit">ذخیره تغییرات <i class="bi bi-check2"></i></button>
        </form>
    </div>
</dialog>
<partial name="_RelatedLinks" />
</main>


@section Styles {
    <link href="ClockTemplate/css/pages/pages.css?v=12" rel="stylesheet"/>
    <link href="ClockTemplate/css/pages/checkout.css?v=2" rel="stylesheet">
    <link href="ClockTemplate/css/pages/account-page.css" rel="stylesheet" asp-append-version="true">
}

@section Scripts {
    <script src="ClockTemplate/js/pages/page-content.js?v=1"></script>
    <script src="ClockTemplate/js/pages/iran-places.js"></script>
    <script src="ClockTemplate/js/pages/address-fields.js"></script>
    <script src="ClockTemplate/js/pages/account-page.js" asp-append-version="true"></script>
    <script src="ClockTemplate/js/pages/orders-pagination.js" asp-append-version="true"></script>
    <script>
      (() => {
        const dialog = document.getElementById('profileEditDialog');
        const form = document.getElementById('profileEditModalForm');
        if (!dialog || !form) return;
        const setError = (name, message) => {
          const host = form.querySelector(`[data-profile-edit-error="${name}"]`);
          const control = form.querySelector(`[name="${name}"]`);
          host.textContent = message;
          host.className = `profile-edit-validation ${message ? 'field-validation-error' : 'field-validation-valid'}`;
          if (name === 'gender') form.querySelector('.profile-edit-gender').classList.toggle('is-invalid', Boolean(message));
          else control.classList.toggle('input-validation-error', Boolean(message));
        };
        const validate = () => {
          const firstName = form.elements.firstName.value.trim();
          const lastName = form.elements.lastName.value.trim();
          const email = form.elements.email;
          const gender = form.querySelector('[name="gender"]:checked');
          setError('firstName', firstName ? '' : 'نام را وارد کنید.');
          setError('lastName', lastName ? '' : 'نام خانوادگی را وارد کنید.');
          setError('email', !email.value || email.validity.valid ? '' : 'ایمیل را با قالب صحیح وارد کنید.');
          setError('gender', gender ? '' : 'جنسیت را انتخاب کنید.');
          return firstName && lastName && (!email.value || email.validity.valid) && gender;
        };
        document.querySelectorAll('[data-profile-edit-trigger]').forEach(trigger => trigger.addEventListener('click', event => { event.preventDefault(); dialog.showModal(); }));
        document.querySelectorAll('[data-profile-edit-close]').forEach(close => close.addEventListener('click', () => dialog.close()));
        form.addEventListener('input', validate);
        form.addEventListener('change', validate);
        form.addEventListener('submit', event => { event.preventDefault(); if (!validate()) return; dialog.close(); });
      })();
    </script>
}
