<header class="page-hero editorial-hero">
    <img class="hero-image" src="~/ClockTemplate/images/sliders/slider-navy-steel.webp" alt="گالری ساعت علی‌رضا زارع" />
    <div class="container">
        <nav class="article-breadcrumb" aria-label="مسیر صفحه">
            <a class="breadcrumb-home" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>خانه</span>
            </a>
            <span class="breadcrumb-step">
                <i class="breadcrumb-separator bi bi-chevron-left" aria-hidden="true"></i>
                <span class="breadcrumb-current" aria-current="page">
                    <i class="bi bi-images" aria-hidden="true"></i>
                    <span>گالری</span>
                </span>
            </span>
        </nav>
        <span class="page-kicker">روایت تصویری علی‌رضا زارع</span>
        <h1>گالری <em>ساعت و استایل</em></h1>
        <p>قاب‌ها، رنگ‌ها و جزئیاتی که هر ساعت را به یک انتخاب شخصی تبدیل می‌کنند.</p>
        <a class="gallery-hero-action" href="#galleryPosts">مشاهده پست‌ها <i class="bi bi-arrow-down-left"></i></a>
    </div>
</header>

<main class="gallery-page">
    <section class="container gallery-intro" aria-labelledby="galleryTitle">
        <div><span>مجله تصویری</span><h2 id="galleryTitle">داستان هر ساعت، <em>در یک قاب</em></h2></div>
        <p>منتخبی از تصاویر محصولات، پیشنهادهای استایل و نگاه نزدیک به جزئیات؛ برای اینکه پیش از انتخاب، ساعت را بهتر ببینید.</p>
    </section>
    <section class="container gallery-categories" aria-label="دسته‌بندی گالری">
        <button class="is-active gallery-category-all" type="button" data-gallery-filter="all" aria-pressed="true">
            <i class="bi bi-grid-3x3-gap"></i>
            <span><b>همه آثار</b><small>@galleryPosts.Length.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))</small></span>
        </button>
        @foreach (var category in galleryCategories)
        {
            var categoryCount = galleryPosts.Count(post => post.Key == category.Key);
            <button type="button" data-gallery-filter="@category.Key" aria-pressed="false">
                <i class="bi @category.Icon"></i>
                <span><b>@category.Title</b><small>@categoryCount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))</small></span>
            </button>
        }
    </section>
    <div class="container gallery-results-head"><strong id="galleryResultTitle">همه آثار گالری</strong><span id="galleryResultCount" aria-live="polite"><b>@galleryPosts.Length.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fa-IR"))</b><small>اثر</small></span></div>
    <section class="container gallery-grid" id="galleryPosts" aria-label="پست‌های گالری">
        @for (var index = 0; index < galleryPosts.Length; index++)
        {
            var post = galleryPosts[index];
            var highlight = (index % 4) switch
            {
                0 => new { Text = "تازه", Icon = "bi-sparkles" },
                1 => new { Text = "منتخب", Icon = "bi-stars" },
                2 => new { Text = "پربازدید", Icon = "bi-fire" },
                _ => new { Text = "پیشنهاد ما", Icon = "bi-heart" }
            };
            var cardBadgeText = post.Video is not null ? $"ویدئو {highlight.Text}" : highlight.Text;
            var cardBadgeClass = post.Video is not null ? "gallery-post-badge-video" : "gallery-post-badge-highlight";
            <article class="gallery-post @post.Size" data-gallery-category="@post.Key">
                @if (post.Video is not null)
                {
                    <button class="gallery-media-trigger" type="button"
                            data-gallery-video="@Url.Content("~/ClockTemplate/videos/" + post.Video)"
                            data-gallery-poster="@Url.Content("~/ClockTemplate/images/" + post.Image)"
                            data-gallery-title="@post.Title"
                            aria-label="پخش ویدئو: @post.Title">
                        <img src="@Url.Content("~/ClockTemplate/images/" + post.Image)" alt="" loading="lazy" />
                        <span class="gallery-post-shade"></span>
                        <span class="gallery-post-badges" aria-hidden="true">
                            <span class="gallery-post-badge @cardBadgeClass">@cardBadgeText</span>
                        </span>
                        <span class="gallery-video-icon" aria-hidden="true"><i class="bi bi-play-fill"></i></span>
                        <span class="gallery-post-copy"><small>@post.Category</small><strong>@post.Title</strong><span class="gallery-post-features"><span><i class="bi bi-camera-reels"></i> ویدئو</span><span><i class="bi bi-stars"></i> منتخب</span></span></span>
                    </button>
                }
                else
                {
                    <a href="@post.Link">
                        <img src="@Url.Content("~/ClockTemplate/images/" + post.Image)" alt="@post.Title" loading="lazy" />
                        <span class="gallery-post-shade"></span>
                        <span class="gallery-post-badges" aria-hidden="true">
                            <span class="gallery-post-badge @cardBadgeClass">@cardBadgeText</span>
                        </span>
                        <span class="gallery-post-copy"><small>@post.Category</small><strong>@post.Title</strong><span class="gallery-post-features"><span><i class="bi bi-eye"></i> مشاهده جزئیات</span><span><i class="bi bi-bookmark-star"></i> منتخب</span></span></span>
                    </a>
                }
            </article>
        }
    </section>
    <nav class="container gallery-pagination" id="galleryPagination" aria-label="صفحه‌بندی گالری">
        <button type="button" class="gallery-page-arrow" data-gallery-page="previous" aria-label="صفحه قبل">
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </button>
        <div class="gallery-page-numbers" id="galleryPageNumbers"></div>
        <button type="button" class="gallery-page-arrow" data-gallery-page="next" aria-label="صفحه بعد">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </button>
    </nav>
    <section class="container gallery-cta">
        <div><span>انتخاب نزدیک‌تر</span><h2>ساعت موردعلاقه‌تان را پیدا کردید؟</h2><p>مدل‌های موجود و جزئیات هر محصول را در فروشگاه ببینید.</p></div>
        <div><a href="Search">مشاهده فروشگاه</a></div>
    </section>
</main>

<dialog class="gallery-player" id="galleryPlayer" aria-labelledby="galleryPlayerTitle">
    <div class="gallery-player-shell">
        <header class="gallery-player-head">
            <div><span>HN VISUAL JOURNAL</span><h2 id="galleryPlayerTitle">نمایش ویدئو</h2></div>
            <button type="button" data-player-close aria-label="بستن پخش‌کننده"><i class="bi bi-x-lg"></i></button>
        </header>
        <div class="gallery-player-stage">
            <video id="galleryVideo" preload="metadata" playsinline></video>
            <button class="gallery-player-center" type="button" data-player-toggle aria-label="پخش ویدئو"><i class="bi bi-play-fill"></i></button>
        </div>
        <div class="gallery-player-controls">
            <button type="button" data-player-toggle aria-label="پخش و توقف"><i class="bi bi-play-fill"></i></button>
            <span id="galleryPlayerCurrent">۰:۰۰</span>
            <input id="galleryPlayerProgress" type="range" min="0" max="100" value="0" step="0.1" aria-label="موقعیت پخش" />
            <span id="galleryPlayerDuration">۰:۰۰</span>
            <button type="button" data-player-mute aria-label="قطع و وصل صدا"><i class="bi bi-volume-up"></i></button>
            <button type="button" data-player-fullscreen aria-label="نمایش تمام‌صفحه"><i class="bi bi-arrows-fullscreen"></i></button>
        </div>
    </div>
</dialog>

@section Styles {
    <link href="~/ClockTemplate/css/pages/pages.css" rel="stylesheet" asp-append-version="true" />
    <link href="ClockTemplate/css/pages/gallery.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="ClockTemplate/js/pages/gallery.js" asp-append-version="true"></script>
}

