<div
    class="modal fade login-modal"
    id="loginModal"
    tabindex="-1"
    aria-labelledby="loginModalTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-scrollbar ui-scrollbar--navy">
            <button
                type="button"
                class="login-close"
                data-bs-dismiss="modal"
                aria-label="بستن">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="login-brand">
                <span>هـ</span>
                <div>
                    <strong>
                        کمپانی علی‌رضا زارع
                    </strong
                    ><small>ورود به حساب کاربری</small>
                </div>
            </div>
            <div class="login-step" id="phoneStep">
                <h2 id="loginModalTitle">شماره موبایل خود را وارد کنید</h2>
                <p>
                    برای ورود یا ساخت حساب، کد تأیید به شماره موبایل شما ارسال می‌شود.
                </p>
                <form id="phoneForm">
                    <label for="loginPhone">شماره موبایل</label>
                    <div class="login-input">
                        <i class="bi bi-phone">
                        </i
                        >
                        <input
                            id="loginPhone"
                            type="tel"
                            inputmode="numeric"
                            maxlength="11"
                            placeholder="۰۹۱۲۱۲۳۴۵۶۷"
                            autocomplete="tel"
                            required/>
                    </div>
                    <small class="login-error" id="phoneError">
                    </small
                    >
                    <button type="submit">
                        ادامه <i class="bi bi-arrow-left"></i>
                    </button>
                </form>
            </div>
            <div class="login-step d-none" id="otpStep">
                <button type="button" class="login-back" id="loginBack">
                    <i class="bi bi-arrow-right"></i> تغییر شماره
                </button>
                <h2>کد تأیید را وارد کنید</h2>
                <p>
                    کد سه‌رقمی ارسال‌شده به <strong id="sentPhone"></strong> را وارد
                    کنید.
                </p>
                <form id="otpForm">
                    <label for="loginOtp">
                        کد تأیید
                    </label
                    >
                    <input
                        class="otp-input"
                        id="loginOtp"
                        type="text"
                        inputmode="numeric"
                        maxlength="3"
                        placeholder="ـ ـ ـ"
                        autocomplete="one-time-code"
                        required/>
                    <small class="login-error" id="otpError">
                    </small
                    >
                    <button type="submit">
                        تأیید و ورود <i class="bi bi-check2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
