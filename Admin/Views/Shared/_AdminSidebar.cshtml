            <div class="menu-item @(string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) && string.Equals(userSection, "permissions", StringComparison.OrdinalIgnoreCase) ? "active" : "")" hidden="@(!canAdminPermissions)">
                <a class="menu-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-section="permissions" data-admin-nav><span class="menu-icon"><i class="fa fa-list-check" aria-hidden="true"></i></span><span class="menu-text">درخت مجوز نقش‌ها</span></a>
