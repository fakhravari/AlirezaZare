@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    string? area = ViewContext.RouteData.Values["area"]?.ToString();
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    string? feature = ViewData["FeatureId"]?.ToString();
    string? userSection = Context.Request.Query["section"].ToString();
    string? contentSection = ViewData["ContentSection"]?.ToString();
    string movementSection = ViewData["MovementSection"]?.ToString() ?? "stock";
    bool inStore = string.Equals(area, "Store", StringComparison.OrdinalIgnoreCase);
    bool inWarehouse = string.Equals(area, "Warehouse", StringComparison.OrdinalIgnoreCase);
    bool isHome = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase) && string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase);
    bool IsFeature(string id) => string.Equals(feature, id, StringComparison.OrdinalIgnoreCase);
    bool Can(string permission) => User.IsInRole("system.full-access") || User.HasClaim("admin_permission", permission);
    bool canCatalog = Can("Store:Catalog:Products") || Can("Store:Catalog:Categories") || Can("Store:Catalog:Brands") || Can("Store:Catalog:Attributes") || Can("Store:Catalog:Badges");
    bool canStoreSales = User.IsInRole("system.full-access") || Can("Store:Features:Index:promotions");
    bool canStorePeople = User.IsInRole("system.full-access") || Can("Store:Features:Index:reviews") || Can("Store:Features:Index:testimonials") || Can("Store:Features:Index:questions") || Can("Store:Features:Index:contact-messages") || Can("Store:Features:Index:account-messages") || Can("Store:Features:Index:newsletter-subscribers");
    bool canStoreReports = Can("Store:Features:Index:reports");
    bool canOverview = Can("Admin:Home:Index") || Can("Store:Dashboard:Index") || Can("Warehouse:Dashboard:Index");
    bool canStore = User.IsInRole("system.full-access") || Can("Store:Dashboard:Index") || canCatalog || canStoreSales || canStorePeople || canStoreReports;
    bool canWarehouseOperations = new[] { "order-confirmation", "receipts", "dispatches", "transfers", "returns", "stocktake", "adjustments" }.Any(id => Can($"Warehouse:Features:Index:{id}"));
    bool canWarehouseSettings = new[] { "references", "units", "product-units", "variant-names", "variants", "document-types", "sales-plan-mapping", "stock-owners" }.Any(id => Can($"Warehouse:Features:Index:{id}"));
    bool canWarehouseStructure = Can("Warehouse:Warehouses:Index") || Can("Warehouse:Features:Index:companies");
    bool canWarehouseReports = Can("Warehouse:Features:Index:movements") || Can("Warehouse:Stock:Index");
    bool canWarehouse = Can("Warehouse:Dashboard:Index") || Can("Warehouse:Features:Index:order-confirmation") || Can("Warehouse:Features:Index:movements") || canWarehouseOperations || Can("Warehouse:Stock:Index");
    bool catalogOpen = inStore && string.Equals(controller, "Catalog", StringComparison.OrdinalIgnoreCase);
    bool salesOpen = inStore && (string.Equals(controller, "Orders", StringComparison.OrdinalIgnoreCase) || IsFeature("orders") || IsFeature("paid-orders-dispatch"));
    bool promotionsOpen = inStore && IsFeature("promotions");
    bool operationsOpen = inWarehouse && new[] { "order-confirmation", "receipts", "dispatches", "transfers", "returns", "stocktake", "adjustments" }.Contains(feature ?? "", StringComparer.OrdinalIgnoreCase);
    bool warehouseStructureOpen = inWarehouse && (string.Equals(controller, "Warehouses", StringComparison.OrdinalIgnoreCase) || IsFeature("companies"));
    bool systemDefinitionsOpen = inWarehouse && (warehouseStructureOpen || new[] { "references", "units", "product-units", "variant-names", "variants", "document-types", "sales-plan-mapping", "stock-owners" }.Contains(feature ?? "", StringComparer.OrdinalIgnoreCase));
    bool reportsOpen = inWarehouse && (IsFeature("movements") || string.Equals(controller, "Stock", StringComparison.OrdinalIgnoreCase));
    bool systemAccessOpen = string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase);
    bool systemProblemsOpen = string.Equals(controller, "SystemProblems", StringComparison.OrdinalIgnoreCase);
    bool systemMenuOpen = systemAccessOpen || systemDefinitionsOpen || systemProblemsOpen;
    bool canAdminUsers = Can("Admin:Users:Index:users");
    bool canAdminRoles = Can("Admin:Users:Index:roles");
    bool canAdminPermissions = Can("Admin:Users:Index:permissions");
    bool canSystemAccess = canAdminUsers || canAdminRoles || canAdminPermissions;
    bool siteSettingsOpen = string.Equals(controller, "SiteSettings", StringComparison.OrdinalIgnoreCase);
    bool sliderOpen = siteSettingsOpen && string.Equals(action, "Slider", StringComparison.OrdinalIgnoreCase);
    bool contentMenuOpen = IsFeature("content") || sliderOpen;
}
<aside id="sidebar" class="app-sidebar" data-bs-theme="dark" aria-label="ناوبری پنل">
<div class="app-sidebar-content" data-scrollbar="true" data-height="100%">
<nav class="menu" aria-label="منوی مدیریت">
<div class="menu-profile">
        <div class="menu-profile-link">
        <div class="menu-profile-cover with-shadow"></div>
        <div class="menu-profile-image">
            <span class="w-100 h-100 d-flex align-items-center justify-content-center rounded-circle bg-teal text-white fw-bold fs-5">ش</span>
        </div>
        <div class="menu-profile-info">
            <div class="fw-semibold">فروشگاه فخراوری</div>
            <small>سامانهٔ مدیریت یکپارچه</small>
        </div>
    </div>
</div>

@if (canOverview)
{
<div class="menu-header">نمای کلی</div>
}
<div class="menu-item @(isHome ? "active" : "")" hidden="@(!Can("Admin:Home:Index"))">
    <a class="menu-link" asp-area="Admin" asp-controller="Home" asp-action="Index" data-admin-nav>
        <span class="menu-icon">
            <i class="fa fa-gauge-high" aria-hidden="true"></i>
        </span>
        <span class="menu-text">پیشخوان مدیریت</span>
    </a>
</div>
<details class="admin-sidebar-group" open="@systemMenuOpen" hidden="@(!canSystemAccess && !canWarehouseStructure && !canWarehouseSettings && !User.IsInRole("system.full-access"))">
    <summary class="menu-header">مدیریت سامانه</summary>
@if (canSystemAccess)
{
    <div class="menu-item has-sub @(systemAccessOpen ? "active expand" : "")">
        <a href="#system-access" class="menu-link" aria-expanded="@(systemAccessOpen ? "true" : "false")">
            <span class="menu-icon"><i class="fa fa-users-gear" aria-hidden="true"></i></span>
            <span class="menu-text">کاربران، نقش‌ها و مجوزها</span><span class="menu-caret"></span>
        </a>
        <div id="system-access" class="menu-submenu">
            <div class="menu-item @(string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase) && !new[] { "roles", "permissions" }.Contains(userSection ?? "", StringComparer.OrdinalIgnoreCase) ? "active" : "")" hidden="@(!canAdminUsers)">
                <a class="menu-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-section="users" data-admin-nav><span class="menu-icon"><i class="fa fa-user" aria-hidden="true"></i></span><span class="menu-text">کاربران پنل</span></a>
            </div>
            <div class="menu-item @(string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) && string.Equals(userSection, "permissions", StringComparison.OrdinalIgnoreCase) ? "active" : "")" hidden="@(!canAdminPermissions)">
                <a class="menu-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-section="permissions" data-admin-nav><span class="menu-icon"><i class="fa fa-list-check" aria-hidden="true"></i></span><span class="menu-text">مجوزهای نقش‌ها</span></a>
            </div>
            <div class="menu-item @(string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase) && string.Equals(userSection, "roles", StringComparison.OrdinalIgnoreCase) ? "active" : "")" hidden="@(!canAdminRoles)">
                <a class="menu-link" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-section="roles" data-admin-nav><span class="menu-icon"><i class="fa fa-user-tag" aria-hidden="true"></i></span><span class="menu-text">نقش‌ها</span></a>
            </div>
        </div>
    </div>
}

@if (User.IsInRole("system.full-access"))
{
    <div class="menu-item @(systemProblemsOpen ? "active" : "")"><a class="menu-link" asp-area="Admin" asp-controller="SystemProblems" asp-action="Index" data-admin-nav><span class="menu-icon"><i class="fa fa-triangle-exclamation" aria-hidden="true"></i></span><span class="menu-text">مشکلات سیستمی</span></a></div>
    <div class="menu-item @(siteSettingsOpen && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
        <a class="menu-link" asp-area="Admin" asp-controller="SiteSettings" asp-action="Index" data-admin-nav>
            <span class="menu-icon"><i class="fa fa-sliders" aria-hidden="true"></i></span><span class="menu-text">تنظیمات عمومی</span>
        </a>
    </div>
    <div class="menu-item @(IsFeature("geography") ? "active" : "")">
        <a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="geography" data-admin-nav>
            <span class="menu-icon"><i class="fa fa-earth-asia" aria-hidden="true"></i></span><span class="menu-text">کشورها، استان‌ها و شهرها</span>
        </a>
    </div>
}

