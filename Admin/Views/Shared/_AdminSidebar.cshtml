@{
    string? area = ViewContext.RouteData.Values["area"]?.ToString();
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    string? feature = ViewData["FeatureId"]?.ToString();
    string? userSection = Context.Request.Query["section"].ToString();
    bool inStore = string.Equals(area, "Store", StringComparison.OrdinalIgnoreCase);
    bool inWarehouse = string.Equals(area, "Warehouse", StringComparison.OrdinalIgnoreCase);
    bool isHome = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase)
        && string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase);
    bool IsFeature(string id) => string.Equals(feature, id, StringComparison.OrdinalIgnoreCase);
    bool Can(string permission) => User.IsInRole("system.full-access") || User.HasClaim("admin_permission", permission);
    bool canCatalog = Can("Store:Catalog:Products") || Can("Store:Catalog:Categories") || Can("Store:Catalog:Brands") || Can("Store:Catalog:Attributes");
    bool canStoreSales = User.IsInRole("system.full-access") || Can("Store:Features:Index:promotions");
    bool canStorePeople = User.IsInRole("system.full-access") || Can("Store:Features:Index:reviews") || Can("Store:Features:Index:questions") || Can("Store:Features:Index:contact-messages") || Can("Store:Features:Index:account-messages");
    bool canOverview = Can("Admin:Home:Index") || Can("Store:Dashboard:Index") || Can("Warehouse:Dashboard:Index");
    bool canStore = User.IsInRole("system.full-access") || Can("Store:Dashboard:Index") || canCatalog || canStoreSales || canStorePeople;
    bool canWarehouseOperations = new[] { "receipts", "dispatches", "transfers", "returns", "stocktake", "adjustments" }.Any(id => Can($"Warehouse:Features:Index:{id}"));
    bool canWarehouseSettings = new[] { "references", "units", "product-units", "variants", "document-types", "sales-plan-mapping", "stock-owners" }.Any(id => Can($"Warehouse:Features:Index:{id}"));
    bool canWarehouse = Can("Warehouse:Dashboard:Index") || Can("Warehouse:Features:Index:order-confirmation") || Can("Warehouse:Features:Index:companies") || Can("Warehouse:Warehouses:Index") || Can("Warehouse:Features:Index:movements") || canWarehouseOperations || canWarehouseSettings || Can("Warehouse:Stock:Index");
    bool catalogOpen = inStore && string.Equals(controller, "Catalog", StringComparison.OrdinalIgnoreCase);
    bool salesOpen = inStore && (new[] { "Orders", "Promotions" }.Contains(controller, StringComparer.OrdinalIgnoreCase) || IsFeature("orders") || IsFeature("promotions") || IsFeature("paid-orders-dispatch"));
    bool operationsOpen = inWarehouse && new[] { "receipts", "dispatches", "transfers", "returns", "stocktake", "adjustments" }.Contains(feature ?? "", StringComparer.OrdinalIgnoreCase);
    bool reportsOpen = inWarehouse && IsFeature("movements");
    bool systemAccessOpen = string.Equals(controller, "Users", StringComparison.OrdinalIgnoreCase);
    bool canAdminUsers = Can("Admin:Users:Index:users");
    bool canAdminRoles = Can("Admin:Users:Index:roles");
    bool canAdminPermissions = Can("Admin:Users:Index:permissions");
    bool canSystemAccess = canAdminUsers || canAdminRoles || canAdminPermissions;
    bool siteSettingsOpen = string.Equals(controller, "SiteSettings", StringComparison.OrdinalIgnoreCase);
}
