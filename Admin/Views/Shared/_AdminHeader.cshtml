@{
    var displayName = User.FindFirst("display_name")?.Value?.Trim();
    if (string.IsNullOrWhiteSpace(displayName)) displayName = User.Identity?.Name ?? "کاربر پنل";
    var avatarInitial = displayName.FirstOrDefault();
}
<header id="header" class="app-header">
    <div class="navbar-header">
        <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index" data-admin-nav>
            <span class="navbar-logo" aria-hidden="true"></span>
            <span class="fw-bold">مدیریت</span>
            <small class="ms-1 text-secondary d-none d-lg-inline">فروشگاه و انبار</small>
        </a>
        <button type="button" class="navbar-mobile-toggler ms-3" data-toggle="app-sidebar-mobile" aria-label="باز کردن منوی اصلی">
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
    </div>
    <div class="navbar-nav">
        <div class="navbar-item d-none d-md-flex flex-column justify-content-center admin-header-context">
            <span class="admin-header-context__label small text-muted">@ViewData["AreaTitle"]</span>
            <span class="admin-header-context__title fw-semibold">@ViewData["Title"]</span>
        </div>
        <div class="navbar-item">
            <a class="navbar-link d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Home" asp-action="Index" data-admin-nav>
                <i class="fa fa-house" aria-hidden="true"></i>
                <span class="d-none d-sm-inline">نمای کلی</span>
            </a>
        </div>
        <div class="navbar-item navbar-user dropdown">
            <button type="button" class="navbar-link dropdown-toggle d-flex align-items-center admin-header-profile" data-bs-toggle="dropdown" aria-expanded="false" aria-label="حساب @displayName">
                <span class="admin-header-profile__avatar" aria-hidden="true">@avatarInitial</span>
                <span class="d-none d-sm-inline">@displayName</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end me-1" dir="rtl">
                <div class="dropdown-header text-end">
                    <span class="d-block fw-semibold">@displayName</span>
                    <small class="text-muted">حساب مدیریت</small>
                </div>
                <div class="dropdown-divider"></div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="dropdown-item text-danger" type="submit">
                        <i class="fa fa-arrow-right-from-bracket ms-2" aria-hidden="true"></i>
                        خروج از پنل
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
