@{ string cdnBaseUrl = ViewData["MediaCdnBaseUrl"] as string ?? ""; }
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#20252b"/>
    <meta name="media-cdn-base-url" content="@(cdnBaseUrl)"/>
    <title>@ViewData["Title"] - مدیریت فروشگاه</title>
    <link rel="stylesheet" href="~/color_admin/assets/css/vendor.min.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/color_admin/assets/css/default/app-rtl.min.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/color_admin/assets/css/persian-font.css" asp-append-version="true"/>
</head>
<body>
<div id="loader" class="app-loader">
    <span class="spinner"></span>
</div>
<div id="app" class="app app-header-fixed app-sidebar-fixed">
    @await Html.PartialAsync("_AdminHeader")
    @await Html.PartialAsync("_AdminSidebar")
    <div class="app-sidebar-bg" data-bs-theme="dark"></div>
    <div class="app-sidebar-mobile-backdrop">
        <a href="#content" data-dismiss="app-sidebar-mobile" class="stretched-link" aria-label="بستن منو"></a>
    </div>
    <main id="content" class="app-content" tabindex="-1">
        @RenderBody()
    </main>
    <div id="admin-toast-region" class="toast-container position-fixed top-0 start-0 p-3" aria-live="polite" aria-atomic="true"></div>
    <div class="modal fade" id="admin-record-modal" tabindex="-1" aria-labelledby="admin-record-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="d-block text-muted small mb-1">نمایش اطلاعات</span>
                        <h2 class="modal-title fs-5" id="admin-record-title">جزئیات رکورد</h2>
                    </div>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body" data-admin-record-body></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>
    <a href="#app" class="btn btn-icon btn-circle btn-theme btn-scroll-to-top" data-toggle="scroll-to-top" aria-label="بازگشت به بالا">
        <i class="fa fa-angle-up" aria-hidden="true"></i>
    </a>
</div>

<script src="~/color_admin/assets/js/vendor.min.js" asp-append-version="true"></script>
<script src="~/color_admin/assets/js/app.min.js" asp-append-version="true"></script>
<script src="~/js/admin-ui.js" asp-append-version="true"></script>
<script src="~/js/admin-data.js" asp-append-version="true"></script>
<script src="~/js/admin-paid-orders-dispatch.js" asp-append-version="true"></script>
<script src="~/js/admin-users.js" asp-append-version="true"></script>
<script src="~/js/admin-documents.js" asp-append-version="true"></script>
<script src="~/js/admin-definitions.js" asp-append-version="true"></script>
<script src="~/js/admin-movements.js" asp-append-version="true"></script>
<script src="~/js/admin-feedback.js" asp-append-version="true"></script>
<script src="~/js/admin-variant-prices.js" asp-append-version="true"></script>
<script src="~/js/admin-geography.js" asp-append-version="true"></script>
<script src="~/js/admin-shell.js" asp-append-version="true"></script>
</body>
</html>
