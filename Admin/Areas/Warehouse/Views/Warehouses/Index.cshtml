<div class="admin-page" data-admin-page="warehouses" data-admin-api="/api/admin/warehouse/warehouses">
    @await Html.PartialAsync("_AdminPageIntro", ((string)ViewData["Title"]!, "فهرست انبارهای ثبت‌شده در دیتابیس."))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">فهرست انبارها</h2>
            <div class="panel-heading-btn">
                <button class="btn btn-xs btn-icon btn-default" type="button" data-admin-refresh aria-label="بارگذاری دوباره">
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3" data-admin-filter>
                <label class="visually-hidden" for="warehouse-search">جست‌وجوی انبار</label>
                <input id="warehouse-search" class="form-control" type="search" name="q" placeholder="نام انبار یا شرکت" autocomplete="off"/>
                <button class="btn btn-primary" type="submit"><i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>جست‌وجو</button>
                <button class="btn btn-default" type="button" data-admin-reset-filter>پاک‌کردن فیلتر</button>
                <span class="admin-record-count ms-auto small text-muted" data-admin-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite">در حال خواندن داده از دیتابیس…</div>
            <div class="table-responsive admin-table-wrap">
                <table class="table table-striped table-hover align-middle mb-0" data-admin-datatable>
                    <thead>
                    <tr>
                        <th scope="col">کد</th><th scope="col">نام انبار</th><th scope="col">شرکت</th><th scope="col">کاربری فروش</th><th scope="col">وضعیت</th><th scope="col">عملیات</th>
                    </tr>
                    </thead>
                    <tbody data-admin-results></tbody>
                </table>
            </div>
            <div class="admin-empty-state d-none p-4 text-center text-muted small" data-admin-empty>انبار ثبت‌شده‌ای پیدا نشد.</div>
            <p class="admin-readonly-note alert alert-info small d-flex align-items-start gap-2 mt-3"><i class="fa fa-lock" aria-hidden="true"></i> این صفحه فعلاً دادهٔ انبار را نمایش می‌دهد؛ ثبت و ویرایش انبار به API مدیریتی نیاز دارد.</p>
        </div>
    </section>
</div>
