@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-definitions data-api="@ViewData["ApiUrl"]" data-definition-section="@Model.FeatureId" data-full-access="@(User.IsInRole("system.full-access") ? "true" : "false")" data-can-create="@(User.HasClaim("admin_permission", "Warehouse:DefinitionsApi:Create") ? "true" : "false")" data-can-edit="@(User.HasClaim("admin_permission", "Warehouse:DefinitionsApi:Save") ? "true" : "false")" data-can-deactivate="@(User.HasClaim("admin_permission", "Warehouse:DefinitionsApi:Deactivate") ? "true" : "false")" data-can-delete="@(User.IsInRole("system.full-access") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    @if (Model.FeatureId == "sales-plan-mapping")
    {
        <section class="panel panel-inverse">
            <div class="panel-heading">
                <h2 class="panel-title">اتصال مالک کالا به انبار شرکت</h2>
            </div>
            <div class="panel-body">
                <div class="admin-data-status small text-muted" data-definition-status role="status" aria-live="polite">در حال بارگذاری…</div>
                <form data-mapping-form data-admin-confirm="اتصال طرح فروش به انبار ذخیره شود؟" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="mapping-company">شرکت</label><select class="form-select" id="mapping-company" name="companyId" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="mapping-warehouse">انبار</label><select class="form-select" id="mapping-warehouse" name="warehouseId" required></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="mapping-plan">مالک کالا یا طرح فروش</label><select class="form-select" id="mapping-plan" name="salesPlanId" required></select>
                    </div>
                    <div class="col-12">
                <button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk" aria-hidden="true"></i>ذخیرهٔ اتصال</button>
                    </div>
                </form>
                <div class="table-responsive mt-3"><table class="table table-striped" data-admin-datatable><thead><tr><th>شرکت / انبار</th><th>مالک / طرح</th><th>عملیات</th></tr></thead><tbody data-mapping-rows></tbody></table></div>
            </div>
        </section>
    }
    else
    {
        @if (Model.FeatureId == "warehouses")
        {
            <section class="panel panel-inverse">
                <div class="panel-heading"><h2 class="panel-title">نام انبارها</h2></div>
                <div class="panel-body">
                    <form class="d-flex flex-wrap gap-2 mb-3" data-warehouse-type-form data-admin-confirm="نام انبار ذخیره شود؟">
                        <label class="visually-hidden" for="warehouse-type-name">نام انبار</label>
                        <input id="warehouse-type-name" class="form-control" name="name" maxlength="200" required placeholder="نام انبار" />
                        <button class="btn btn-primary" type="submit">افزودن نام انبار</button>
                        <button class="btn btn-default" type="button" data-warehouse-type-cancel hidden>انصراف از ویرایش</button>
                    </form>
                    <p class="small text-muted">تغییر نام انبار در همهٔ تخصیص‌های مرتبط با آن اعمال می‌شود.</p>
                    <ul class="list-group" data-warehouse-types></ul>
                </div>
            </section>
        }
        @if (Model.FeatureId == "references")
        {
            <section class="panel panel-inverse">
                <div class="panel-heading"><h2 class="panel-title">تعریف مرجع</h2></div>
                <div class="panel-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <p class="mb-0">برای ثبت شخص، سازمان، انبار یا مرجع دیگر، اطلاعات مرجع جدید را وارد کنید.</p>
                    <button type="button" class="btn btn-primary" data-definition-create><i class="fa fa-plus me-1" aria-hidden="true"></i>تعریف مرجع جدید</button>
                </div>
            </section>
        }
        <section class="panel panel-inverse">
            <div class="panel-heading">
                <h2 class="panel-title">@(Model.FeatureId == "warehouses" ? "تخصیص انبار به شرکت" : Model.FeatureId == "references" ? "مراجع ثبت‌شده" : Model.FeatureId == "units" ? "درخت گروه‌های واحد و واحدها" : "فهرست تعریف‌ها")</h2>
                <div class="panel-heading-btn">
                    @if (Model.FeatureId != "references")
                    {
                        <button type="button" class="btn btn-primary btn-sm" data-definition-create><i class="fa fa-plus me-1" aria-hidden="true"></i>@(Model.FeatureId == "warehouses" ? "افزودن تخصیص" : Model.FeatureId == "units" ? "افزودن واحد" : "افزودن")</button>
                    }
                </div>
            </div>
            <div class="panel-body">
                @if (Model.FeatureId == "references")
                {
                    <div class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
                        <label class="visually-hidden" for="warehouse-reference-type-filter">فیلتر بر اساس نوع مرجع</label>
                        <select id="warehouse-reference-type-filter" class="form-select" data-reference-type-filter>
                            <option value="">همهٔ مراجع</option>
                            <option value="Person">شخص</option>
                            <option value="Organization">سازمان</option>
                            <option value="Warehouse">انبار</option>
                            <option value="Other">سایر</option>
                        </select>
                    </div>
                }
                <div class="admin-data-status small text-muted" data-definition-status role="status" aria-live="polite">در حال بارگذاری…</div>
                @if (Model.FeatureId == "units")
                {
                    <div class="border rounded p-3 mb-3">
                        <h3 class="h6">مدیریت گروه واحدها</h3>
                        <form class="row g-2 align-items-end" data-unit-group-form>
                            <input type="hidden" name="id" value="" />
                            <div class="col-12 col-md-5"><label class="form-label" for="unit-group-name">نام گروه</label><input id="unit-group-name" class="form-control" name="name" maxlength="100" required /></div>
                            <div class="col-12 col-md-4"><label class="form-label" for="unit-group-name-en">نام انگلیسی</label><input id="unit-group-name-en" class="form-control" name="nameEn" maxlength="100" /></div>
                            <div class="col-6 col-md-1"><label class="form-label" for="unit-group-sort">ترتیب</label><input id="unit-group-sort" class="form-control" name="sortOrder" type="number" min="0" step="1" value="0" required /></div>
                            <div class="col-6 col-md-2 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">افزودن گروه</button><button class="btn btn-default" type="button" data-unit-group-cancel hidden>انصراف</button></div>
                        </form>
                        <p class="small text-muted mt-2 mb-0">واحدهای قبلی در گروه «سایر واحدها» قرار می‌گیرند؛ از فرم ویرایش واحد می‌توانید آن‌ها را به گروه مناسب منتقل کنید.</p>
                    </div>
                    <div class="admin-permission-tree overflow-auto border rounded" data-unit-tree aria-label="درخت گروه‌های واحد و واحدها"></div>
                }
                else if (Model.FeatureId == "product-units")
                {
                    <div class="list-group" data-product-unit-tree aria-label="درخت واحدهای کالا"></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle" data-admin-datatable>
                            <thead data-definition-head></thead><tbody data-definition-rows></tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
</div>
<div class="modal fade" id="admin-definition-modal" tabindex="-1" aria-labelledby="admin-definition-title" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" data-definition-form data-admin-confirm="تعریف انبار ذخیره شود؟">
            @Html.AntiForgeryToken()<input type="hidden" name="id"/>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="admin-definition-title">افزودن تعریف</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" data-definition-fields></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal"><i class="fa fa-xmark" aria-hidden="true"></i>انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk" aria-hidden="true"></i>ذخیره</button>
            </div>
        </form>
    </div>
</div>
