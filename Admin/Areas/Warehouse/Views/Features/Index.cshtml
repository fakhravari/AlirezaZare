@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-page="feature">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse admin-feature-panel">
        <div class="panel-heading">
            <h2 class="panel-title">دامنهٔ این بخش</h2>
        </div>
        <div class="panel-body">
            <ul class="admin-capability-list">
                @foreach (string capability in Model.Capabilities)
                {
                    <li>
                        <i class="fa fa-check" aria-hidden="true"></i>@capability
                    </li>
                }
            </ul>
            <div class="alert alert-warning mb-0" role="status">
                <strong>وضعیت اتصال:</strong> @Model.DataStatus
                <span class="d-block mt-2">این صفحه دادهٔ نمونه نمایش نمی‌دهد و تا تکمیل API مجاز، عملیات نوشتن در آن فعال نیست.</span>
            </div>
        </div>
    </section>
</div>