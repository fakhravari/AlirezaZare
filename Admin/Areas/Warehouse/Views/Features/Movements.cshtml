@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-movements data-mode="@ViewData["MovementSection"]" data-api="@ViewData["ApiUrl"]">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title" data-movement-title>@Model.Title</h2>
        </div>
        <div class="panel-body">
            @if ((string?)ViewData["MovementSection"] == "audit")
            {
                <p>تاریخچهٔ تغییر سندهای انبار را بررسی کنید.</p>
            }
            else
            {
                <p>مانده و خلاصهٔ گردش بر اساس سندهای قطعی مؤثر بر موجودی، برای هر کالا، تنوع، انبار و طرح محاسبه می‌شوند.</p>
            }
            <form class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3" data-movement-filter>
                <label class="visually-hidden" for="movement-product">کالا</label><select class="form-select" id="movement-product" name="productId" data-remote-product-url="@ViewData["ApiUrl"]/products"><option value="">همهٔ کالاها</option></select><label class="visually-hidden" for="movement-search">جست‌وجوی متنی</label><input class="form-control" id="movement-search" name="search" placeholder="جست‌وجوی متنی"/><label class="visually-hidden" for="movement-warehouse">انبار</label>
                <select class="form-select" name="warehouseId" id="movement-warehouse">
                    <option value="">همهٔ انبارهای مجاز</option>
                </select><label class="visually-hidden" for="movement-plan">طرح یا مالک کالا</label><input class="form-control" id="movement-plan" name="salesPlan" maxlength="100" placeholder="نام یا کد طرح"/><label class="visually-hidden" for="movement-from">از تاریخ</label><input class="form-control" type="date" name="from" id="movement-from"/><label class="visually-hidden" for="movement-to">تا تاریخ</label><input class="form-control" type="date" name="to" id="movement-to"/><button class="btn btn-primary" type="submit">جست‌وجو</button><button class="btn btn-default" type="reset" data-movement-reset>پاک‌کردن</button>
            </form>
            <div class="admin-data-status small text-muted" data-movement-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" data-admin-datatable data-admin-table-mode="server">
                    <thead data-movement-head>
                    <tr>
                        <th>تاریخ</th><th>شماره</th><th>نوع سند</th><th>انبار</th><th>طرح</th><th>کالا / تنوع</th><th>مقدار سند</th><th>مقدار گردش</th><th>مانده به واحد اصلی</th><th>وضعیت</th><th>دلیل</th>
                    </tr>
                    </thead><tbody data-movement-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3" data-movement-pagination hidden>
                <button class="btn btn-default btn-sm" type="button" data-movement-page="-1">قبلی</button><span data-movement-page-label></span><button class="btn btn-default btn-sm" type="button" data-movement-page="1">بعدی</button>
            </div>
            @if ((string?)ViewData["MovementSection"] == "audit")
            {
                <p class="text-muted small mt-2">فیلتر کالا و طرح در تاریخچهٔ تغییر سند اعمال نمی‌شوند.</p>
            }
            else if ((string?)ViewData["MovementSection"] == "summary")
            {
                <p class="text-muted small mt-2">ماندهٔ اول دوره پیش از تاریخ شروع و ماندهٔ پایان تا تاریخ پایان است؛ مقادیر بر حسب واحد اصلی کالا هستند.</p>
            }
        </div>
    </section>
</div>
