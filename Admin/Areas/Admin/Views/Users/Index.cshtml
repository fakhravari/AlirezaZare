@{
    ViewData["Title"] = "کاربران سیستم و دسترسی‌ها";
    ViewData["AreaTitle"] = "مدیریت سامانه";
}
<div class="admin-page" data-admin-users data-api="/api/admin/users">
    @await Html.PartialAsync("_AdminPageIntro", ("کاربران سیستم", "حساب‌های مستقل پنل، نقش‌های مجوز و محدودهٔ دسترسی انبار."))
    @Html.AntiForgeryToken()
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">کاربران پنل</h2>
            <div class="panel-heading-btn">
                <button class="btn btn-primary btn-sm" type="button" data-user-create><i class="fa fa-user-plus me-1" aria-hidden="true"></i>افزودن کاربر</button>
            </div>
        </div>
        <div class="panel-body">
            <div class="admin-data-status small text-muted" data-users-status role="status" aria-live="polite">در حال بارگذاری کاربران…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                    <tr>
                        <th>کاربر</th><th>نقش‌ها</th><th>دسترسی انبار</th><th>وضعیت</th><th>آخرین ورود</th>
                        <th>
                            <span class="visually-hidden">عملیات</span>
                        </th>
                    </tr>
                    </thead><tbody data-users-rows></tbody>
                </table>
            </div>
        </div>
    </section>
    <section class="panel panel-inverse mt-4">
        <div class="panel-heading">
            <h2 class="panel-title">درخت مجوز نقش‌ها</h2>
        </div>
        <div class="panel-body">
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label for="admin-role-select" class="form-label">نقش</label><select id="admin-role-select" class="form-select" data-role-select></select>
                </div>
                <div class="col-md-4">
                    <label for="admin-role-name" class="form-label">نام نقش</label><input id="admin-role-name" class="form-control" maxlength="160" data-role-name/>
                </div>
                <div class="col-md-2">
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" data-role-active/><span class="form-check-label">فعال</span>
                    </label>
                </div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-theme" type="button" data-role-save>ذخیره</button>
                </div>
            </div>
            <form class="row g-2 align-items-end mb-4" data-role-create-form>
                <div class="col-md-4">
                    <label class="form-label" for="new-role-key">کلید نقش</label><input class="form-control" id="new-role-key" name="roleKey" pattern="[A-Za-z0-9._-]{2,100}" required/>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="new-role-name">نام نقش</label><input class="form-control" id="new-role-name" name="name" maxlength="160" required/>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary w-100" type="submit">ایجاد نقش</button>
                </div>
            </form>
            <div data-permission-tree class="admin-permission-tree overflow-auto border rounded p-3"></div>
        </div>
    </section>
</div>

<div class="modal fade" id="admin-user-modal" tabindex="-1" aria-labelledby="admin-user-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <form data-user-form>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="admin-user-modal-title">کاربر سیستم</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id"/>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="system-user-name">نام کاربری</label><input class="form-control" id="system-user-name" name="userName" maxlength="100" required autocomplete="off"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="system-user-display">نام نمایشی</label><input class="form-control" id="system-user-display" name="displayName" maxlength="160" required/>
                        </div>
                        <div class="col-md-8" data-new-password>
                            <label class="form-label" for="system-user-password">گذرواژهٔ اولیه</label><input class="form-control" id="system-user-password" name="password" type="password" minlength="12" maxlength="200" autocomplete="new-password"/>
                            <small class="form-text">گذرواژه باید بین ۱۲ تا ۲۰۰ نویسه باشد.</small>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <label class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="isActive" checked/><span class="form-check-label">کاربر فعال</span>
                            </label>
                        </div>
                    </div>
                    <fieldset class="mt-4">
                        <legend class="fs-6">نقش‌ها</legend>
                        <div class="row g-2" data-user-roles></div>
                    </fieldset>
                    <fieldset class="mt-4">
                        <legend class="fs-6">انبارهای مجاز</legend>
                        <p class="text-muted small">برای نقش مدیر کل، دسترسی به همهٔ انبارها برقرار است.</p>
                        <div class="row g-2" data-user-warehouses></div>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>
