@{
    ViewData["Title"] = "نقش‌های کاربران پنل";
    ViewData["AreaTitle"] = "مدیریت سامانه";
}
<div class="admin-page" data-admin-users data-admin-users-page="roles" data-api="/api/admin/users">
    @await Html.PartialAsync("_AdminPageIntro", ("نقش‌های کاربران پنل", "نقش‌ها را تعریف و نام و وضعیت آن‌ها را مدیریت کنید؛ مجوزهای هر نقش را در صفحهٔ جداگانهٔ مجوزهای نقش‌ها تنظیم کنید."))
    @Html.AntiForgeryToken()
    <section class="panel panel-inverse mt-4">
        <div class="panel-heading d-flex align-items-center justify-content-between">
            <h2 class="panel-title">فهرست نقش‌ها</h2>
            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#admin-role-create-modal">
                <i class="fa fa-plus" aria-hidden="true"></i> ایجاد نقش
            </button>
        </div>
        <div class="panel-body">
            <div class="admin-data-status small text-muted" data-users-status role="status" aria-live="polite">در حال بارگذاری نقش‌ها…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" data-admin-datatable>
                    <thead>
                    <tr>
                        <th>نام نقش</th><th>کلید</th><th>کاربران</th><th>وضعیت</th><th>عملیات</th>
                    </tr>
                    </thead>
                    <tbody data-role-rows></tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="admin-role-create-modal" tabindex="-1" aria-labelledby="admin-role-create-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-role-create-form data-admin-confirm="نقش جدید ساخته شود؟">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="admin-role-create-title">ایجاد نقش</h2>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="new-role-key">کلید نقش</label>
                    <input class="form-control" id="new-role-key" name="roleKey" pattern="[A-Za-z0-9._-]{2,100}" required/>
                    <div class="form-text">کلید یکتا و شامل حروف لاتین، عدد، نقطه، خط تیره یا زیرخط باشد.</div>
                </div>
                <div>
                    <label class="form-label" for="new-role-name">نام نقش</label>
                    <input class="form-control" id="new-role-name" name="name" maxlength="160" required/>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" type="button" data-bs-dismiss="modal">انصراف</button>
                <button class="btn btn-primary" type="submit"><i class="fa fa-plus" aria-hidden="true"></i> ایجاد نقش</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="admin-role-edit-modal" tabindex="-1" aria-labelledby="admin-role-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" data-role-edit-form data-admin-confirm="تغییرات نقش ذخیره شوند؟">
            <input type="hidden" name="id"/>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="admin-role-edit-title">ویرایش نقش</h2>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="edit-role-name">نام نقش</label>
                    <input class="form-control" id="edit-role-name" name="name" maxlength="160" required/>
                </div>
                <label class="form-check">
                    <input data-admin-switch role="switch" class="form-check-input" type="checkbox" name="isActive"/>
                    <span class="form-check-label">نقش فعال باشد</span>
                </label>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" type="button" data-bs-dismiss="modal">انصراف</button>
                <button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk" aria-hidden="true"></i> ذخیرهٔ نقش</button>
            </div>
        </form>
    </div>
</div>