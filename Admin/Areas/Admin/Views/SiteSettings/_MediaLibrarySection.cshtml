@model (string Kind, string Title, string Description)
@{
    var fileId = $"media-file-{Model.Kind}";
}
<section class="panel panel-default mb-0" data-media-library data-media-library-kind="@Model.Kind" aria-labelledby="media-title-@Model.Kind">
    <div class="panel-heading">
        <h3 id="media-title-@Model.Kind" class="panel-title">@Model.Title</h3>
        <div class="panel-heading-btn"><button class="btn btn-default btn-sm" type="button" data-media-library-refresh>بازخوانی فهرست</button></div>
    </div>
    <div class="panel-body">
        <form class="visually-hidden" data-media-library-token>@Html.AntiForgeryToken()</form>
        <p class="text-muted">@Model.Description</p>
        <form data-media-upload-form enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="kind" value="@Model.Kind" />
            @if (Model.Kind == "slider")
            {
                <label for="media-slot-slider" class="form-label mt-2">اسلاید</label>
                <select id="media-slot-slider" name="slideKey" class="form-select">
                    <option value="electrical-tools-banner">ابزار دقیق</option>
                    <option value="electrical-components-banner">قطعات</option>
                    <option value="electrical-lighting-banner">روشنایی</option>
                    <option value="electrical-tools-pro-banner">ابزار حرفه‌ای</option>
                    <option value="electrical-components-pro-banner">قطعات حرفه‌ای</option>
                    <option value="electrical-measurement-banner">اندازه‌گیری</option>
                </select>
                <label for="media-variant-slider" class="form-label mt-2">نمایش در</label>
                <select id="media-variant-slider" name="variant" class="form-select">
                    <option value="desktop">دسکتاپ</option>
                    <option value="mobile">موبایل</option>
                </select>
            }
            <label for="@fileId" class="form-label">فایل تصویر</label>
            <input id="@fileId" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required />
            <small class="form-text text-muted d-block mt-2">JPEG، PNG یا WebP تا ۱۰ مگابایت؛ نسخهٔ کوچک نیز ساخته می‌شود.</small>
            <button type="submit" class="btn btn-primary mt-3"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>بارگذاری @Model.Title</button>
            <div class="mt-2" data-media-upload-result role="status" aria-live="polite"></div>
        </form>
        <div class="admin-media-library mt-4" data-media-library-items aria-live="polite"></div>
        <p class="admin-data-status small text-muted mt-2" data-media-library-status role="status" aria-live="polite">در حال دریافت رسانه‌های موجود…</p>
    </div>
</section>
