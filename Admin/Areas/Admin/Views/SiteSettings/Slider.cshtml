@{
    ViewData["Title"] = "اسلایدر فروشگاه";
    ViewData["AreaTitle"] = "سامانهٔ مدیریت";
}
<div class="admin-page">
    @await Html.PartialAsync("_AdminPageIntro", ("اسلایدر فروشگاه", "بنرهای موبایل و دسکتاپ را جداگانه ثبت و مدیریت کنید."))
    <section class="panel panel-default" data-media-library data-media-library-kind="slider" aria-labelledby="slider-library-title">
        <div class="panel-heading">
            <h2 id="slider-library-title" class="panel-title">مدیریت بنرها</h2>
            <div class="panel-heading-btn"><button class="btn btn-default btn-sm" type="button" data-media-library-refresh>بازخوانی فهرست</button></div>
        </div>
        <div class="panel-body">
            <form class="visually-hidden" data-media-library-token>@Html.AntiForgeryToken()</form>
            <p class="text-muted">برای هر دستگاه، تصویر، عنوان و نشانی بنر را جدا ثبت کنید. تصویر با نسبت اصلی نمایش داده می‌شود و می‌توانید بعداً عنوان و نشانی را ویرایش کنید.</p>
            <div class="admin-slider-devices">
                @foreach (var device in new[] { (Key: "mobile", Label: "موبایل", Icon: "fa-mobile-screen", Mobile: true, Desktop: false), (Key: "desktop", Label: "دسکتاپ", Icon: "fa-desktop", Mobile: false, Desktop: true) })
                {
                    var titleId = $"slider-{device.Key}-title";
                    var urlId = $"slider-{device.Key}-url";
                    var fileId = $"slider-{device.Key}-file";
                    <section class="admin-slider-device" aria-labelledby="slider-@device.Key-heading">
                        <div class="admin-slider-device__heading">
                            <span class="admin-slider-device__icon" aria-hidden="true"><i class="fa @device.Icon"></i></span>
                            <div><h3 id="slider-@device.Key-heading">بنرهای @device.Label</h3><p class="text-muted mb-0">بنرهای فعال برای @device.Label</p></div>
                            <span class="badge bg-secondary" data-slider-count="@device.Key">۰ بنر</span>
                        </div>
                        <form class="admin-slider-upload" data-media-upload-form data-admin-confirm="بنر @device.Label بارگذاری شود؟" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="kind" value="slider" />
                            <input type="hidden" name="showOnMobile" value="@device.Mobile.ToString().ToLowerInvariant()" />
                            <input type="hidden" name="showOnDesktop" value="@device.Desktop.ToString().ToLowerInvariant()" />
                            <div class="admin-slider-upload__fields">
                                <div><label class="form-label" for="@titleId">عنوان بنر</label><input id="@titleId" name="title" class="form-control" maxlength="200" required placeholder="مثلاً پیشنهادهای ویژه"></div>
                                <div><label class="form-label" for="@urlId">نشانی مقصد</label><input id="@urlId" name="url" class="form-control" dir="ltr" maxlength="1000" required placeholder="/products یا نشانی کامل"></div>
                                <div class="admin-slider-upload__file"><label class="form-label" for="@fileId">تصویر @device.Label</label><input id="@fileId" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required><small class="form-text text-muted">JPEG، PNG یا WebP؛ حداکثر ۱۰ مگابایت</small></div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3"><button type="submit" class="btn btn-primary"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>ثبت بنر @device.Label</button><span data-media-upload-result class="small text-muted" role="status" aria-live="polite"></span></div>
                        </form>
                        <div class="admin-slider-device__items" data-slider-items="@device.Key" aria-live="polite"></div>
                    </section>
                }
            </div>
            <p class="admin-data-status small text-muted mt-3" data-media-library-status role="status" aria-live="polite">در حال دریافت بنرها…</p>
        </div>
    </section>
</div>
