@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-home-testimonials data-api="/api/admin/store/home-testimonials?feature=testimonials" data-can-edit="@(User.IsInRole("system.full-access") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    @Html.AntiForgeryToken()
    @if (User.IsInRole("system.full-access"))
    {
        <section class="panel panel-inverse">
            <div class="panel-heading"><h2 class="panel-title">افزودن و ویرایش دیدگاه</h2></div>
            <div class="panel-body">
                <p>این دیدگاه‌ها فقط برای ویترین صفحهٔ نخست ثبت می‌شوند.</p>
                <form data-home-testimonial-editor>
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label" for="testimonial-product">محصول</label><select class="form-select" id="testimonial-product" name="productId" required><option value="">انتخاب محصول</option></select></div>
                        <div class="col-md-6"><label class="form-label" for="testimonial-name">نام نمایشی</label><input class="form-control" id="testimonial-name" name="displayName" maxlength="80" required /></div>
                        <div class="col-12"><label class="form-label" for="testimonial-text">متن دیدگاه</label><textarea class="form-control" id="testimonial-text" name="feedbackText" maxlength="800" rows="3" required></textarea></div>
                        <div class="col-md-6"><label class="form-label" for="testimonial-image">تصویر دیدگاه (اختیاری)</label><input class="form-control" id="testimonial-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" /><small class="text-muted">JPEG، PNG یا WebP، حداکثر ۱۰ مگابایت</small></div>
                        <div class="col-md-6" data-home-testimonial-remove-image hidden><label><input class="form-check-input" type="checkbox" name="removeImage" /> حذف تصویر فعلی</label></div>
                        <div class="col-md-3"><label class="form-label" for="testimonial-rating">امتیاز از ۵</label><input class="form-control" id="testimonial-rating" name="rating" type="number" min="1" max="5" value="5" required /></div>
                        <div class="col-md-3"><label class="form-label" for="testimonial-order">ترتیب نمایش</label><input class="form-control" id="testimonial-order" name="sortOrder" type="number" min="0" max="9999" value="0" required /></div>
                        <div class="col-md-3 d-flex align-items-end"><label><input class="form-check-input" type="checkbox" name="isActive" checked /> نمایش در صفحهٔ نخست</label></div>
                    </div>
                    <div class="d-flex gap-2 mt-3"><button class="btn btn-primary" type="submit" data-home-testimonial-submit>افزودن دیدگاه</button><button class="btn btn-default" type="reset">دیدگاه جدید</button></div>
                </form>
            </div>
        </section>
    }
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">دیدگاه‌های ویترین</h2></div>
        <div class="panel-body">
            <p class="admin-data-status small text-muted" data-home-testimonial-status role="status" aria-live="polite">در حال بارگذاری…</p>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 home-testimonial-table">
                    <thead><tr><th>نمایش</th><th>تصویر</th><th>دیدگاه</th><th>محصول</th><th>تاریخ</th><th>عملیات</th></tr></thead>
                    <tbody data-home-testimonial-rows></tbody>
                </table>
            </div>
        </div>
    </section>
</div>
