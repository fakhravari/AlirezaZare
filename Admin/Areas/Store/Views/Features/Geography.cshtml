@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-geography>
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse"><div class="panel-heading"><h2 class="panel-title">تعاریف جغرافیایی</h2></div><div class="panel-body">
        <div class="nav nav-tabs" role="tablist" aria-label="تعاریف جغرافیایی">
            <button type="button" class="nav-link active" role="tab" id="geo-tab-countries" aria-controls="geo-panel" aria-selected="true" tabindex="0" data-geo-tab="countries">کشورها</button>
            <button type="button" class="nav-link" role="tab" id="geo-tab-provinces" aria-controls="geo-panel" aria-selected="false" tabindex="-1" data-geo-tab="provinces">استان‌ها</button>
            <button type="button" class="nav-link" role="tab" id="geo-tab-cities" aria-controls="geo-panel" aria-selected="false" tabindex="-1" data-geo-tab="cities">شهرها</button>
        </div>
        <div class="pt-3" role="tabpanel" id="geo-panel" aria-labelledby="geo-tab-countries" data-geo-panel>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                <div class="flex-grow-1"><label class="form-label" for="geo-search">جست‌وجو</label><input class="form-control" type="search" id="geo-search" data-geo-search /></div>
                <button class="btn btn-primary" type="button" data-geo-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن</button>
            </div>
            <p role="status" aria-live="polite" data-geo-status></p>
            <button type="button" class="btn btn-default btn-sm mb-3" data-geo-retry hidden>تلاش دوباره برای دریافت فهرست</button>
            <div class="table-responsive"><table class="table table-striped table-hover" data-admin-datatable data-admin-table-search="false"><thead><tr><th>نام فارسی</th><th>نام انگلیسی</th><th>وابستگی / کد</th><th>عملیات</th></tr></thead><tbody data-geo-rows></tbody></table></div>
        </div>
    </div></section>

    <div class="modal fade" tabindex="-1" aria-labelledby="geo-modal-title" aria-hidden="true" data-geo-modal>
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <form class="modal-content" data-geo-form data-admin-confirm="اطلاعات ناحیهٔ جغرافیایی ذخیره شود؟">
                @Html.AntiForgeryToken()<input type="hidden" name="id" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="geo-modal-title" data-geo-modal-title>افزودن</h2>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6" data-geo-country hidden>
                            <label class="form-label" for="geo-country-search">جست‌وجوی کشور</label>
                            <input class="form-control mb-2" type="search" id="geo-country-search" data-geo-country-search autocomplete="off" aria-controls="geo-country" />
                            <label class="form-label" for="geo-country">کشور</label>
                            <select class="form-select" id="geo-country" name="countryId"></select>
                        </div>
                        <div class="col-md-6" data-geo-province hidden>
                            <label class="form-label" for="geo-province-search">جست‌وجوی استان</label>
                            <input class="form-control mb-2" type="search" id="geo-province-search" data-geo-province-search autocomplete="off" aria-controls="geo-province" />
                            <label class="form-label" for="geo-province">استان</label>
                            <select class="form-select" id="geo-province" name="provinceId"></select>
                        </div>
                        <div class="col-md-6"><label class="form-label" for="geo-name">نام فارسی</label><input class="form-control" id="geo-name" name="nameFa" required maxlength="200" /></div>
                        <div class="col-md-6"><label class="form-label" for="geo-name-en">نام انگلیسی</label><input class="form-control" id="geo-name-en" name="nameEn" required maxlength="200" /></div>
                        <div class="col-md-6" data-geo-code><label class="form-label" for="geo-code">کد کشور</label><input class="form-control" id="geo-code" name="code" maxlength="8" /></div>
                        <div class="col-md-6" data-geo-flag><label class="form-label" for="geo-flag">مسیر تصویر پرچم</label><input class="form-control" id="geo-flag" name="flagPath" maxlength="500" placeholder="content/countries/flags/..." /><small class="text-muted">مسیر فایل بارگذاری‌شده یا نشانی کامل تصویر</small></div>
                        <div class="col-md-6" data-geo-coordinates hidden><label class="form-label" for="geo-latitude">عرض جغرافیایی</label><input class="form-control" id="geo-latitude" name="latitude" type="number" min="-90" max="90" step="0.00000001" /></div>
                        <div class="col-md-6" data-geo-coordinates hidden><label class="form-label" for="geo-longitude">طول جغرافیایی</label><input class="form-control" id="geo-longitude" name="longitude" type="number" min="-180" max="180" step="0.00000001" /></div>
                        <div class="col-12" data-geo-center hidden><div class="form-check"><input class="form-check-input" id="geo-center" name="isProvinceCenter" type="checkbox" /><label class="form-check-label" for="geo-center">مرکز استان</label></div></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button>
                    <button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>
