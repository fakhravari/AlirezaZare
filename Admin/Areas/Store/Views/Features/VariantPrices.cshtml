@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-store-variant-prices data-api="@ViewData["ApiUrl"]" data-can-edit="@(User.IsInRole("system.full-access") || User.HasClaim("admin_permission", "Store:Features:Index:promotions") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", ("قیمت تنوع‌ها در طرح فروش", "برای هر تنوع انبار و هر طرح، قیمت فروش مستقل تعیین کنید. در صورت حذف قیمت اختصاصی، قیمت پایهٔ همان کالا و طرح استفاده می‌شود."))
    @Html.AntiForgeryToken()
    @if (User.IsInRole("system.full-access"))
    {
        <section class="panel panel-inverse">
            <div class="panel-heading"><h2 class="panel-title">بازه و نمایش طرح فروش</h2></div>
            <div class="panel-body">
                <p>طرح تازه به‌صورت پیش‌نویس ساخته و به انبارهای فروش متصل می‌شود. برای عرضه، آن را منتشر کنید؛ طرح‌های دارای سابقه فقط غیرفعال می‌شوند.</p>
                <form class="border rounded p-3 mb-3" data-plan-create>
                    <h3 class="h5">ایجاد طرح فروش</h3>
                    <div class="row g-2"><div class="col-md-3"><label class="form-label" for="new-plan-key">کلید یکتا</label><input id="new-plan-key" class="form-control" name="key" maxlength="64" pattern="[a-z0-9][a-z0-9-]*" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-code">کد</label><input id="new-plan-code" class="form-control" name="code" maxlength="64" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-name">نام</label><input id="new-plan-name" class="form-control" name="displayName" maxlength="200" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-type">نوع</label><input id="new-plan-type" class="form-control" name="planType" maxlength="30" required /></div></div>
                    <button class="btn btn-success mt-3" type="submit"><i class="fa fa-file-circle-plus me-1" aria-hidden="true"></i>ساخت پیش‌نویس</button>
                </form>
                <form data-plan-settings>
                    <div class="mb-3"><label class="form-label" for="plan-settings-id">طرح فروش</label><select id="plan-settings-id" class="form-select" name="id" required></select></div>
                    <div class="row g-2 mb-3"><div class="col-md-4"><label class="form-label" for="plan-settings-code">کد</label><input id="plan-settings-code" class="form-control" name="code" maxlength="64" /></div><div class="col-md-4"><label class="form-label" for="plan-settings-name">نام طرح</label><input id="plan-settings-name" class="form-control" name="displayName" maxlength="200" /></div><div class="col-md-4"><label class="form-label" for="plan-settings-type">نوع</label><input id="plan-settings-type" class="form-control" name="planType" maxlength="30" /></div></div>
                    <button class="btn btn-default mb-3" type="button" data-plan-details-save><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ مشخصات</button>
                    <button class="btn btn-success mb-3" type="button" data-plan-publish><i class="fa fa-paper-plane me-1" aria-hidden="true"></i>انتشار طرح</button>
                    <button class="btn btn-warning mb-3" type="button" data-plan-unpublish><i class="fa fa-eye-slash me-1" aria-hidden="true"></i>خروج از فروش</button>
                    <button class="btn btn-danger mb-3" type="button" data-plan-delete><i class="fa fa-trash-can me-1" aria-hidden="true"></i>حذف طرح بدون سابقه</button>
                    <div class="mb-3"><label class="form-label" for="plan-settings-start">شروع (UTC)</label><input id="plan-settings-start" class="form-control" name="startsAtUtc" type="datetime-local" step="1" /></div>
                    <div class="mb-3"><label class="form-label" for="plan-settings-end">پایان (UTC)</label><input id="plan-settings-end" class="form-control" name="endsAtUtc" type="datetime-local" step="1" /></div>
                    <div class="mb-3"><label class="form-label" for="plan-settings-label">برچسب</label><input id="plan-settings-label" class="form-control" name="label" maxlength="100" /></div>
                    <div class="form-check mb-3"><input id="plan-settings-countdown" class="form-check-input" name="showCountdown" type="checkbox" /><label class="form-check-label" for="plan-settings-countdown">نمایش شمارش معکوس</label></div>
                    <button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ تنظیمات طرح</button>
                    <div class="admin-data-status mt-2 small text-muted" data-plan-status role="status" aria-live="polite">در حال دریافت طرح‌ها…</div>
                </form>
            </div>
        </section>
    }
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">پیشنهادهای کالا در طرح‌های ویژه</h2><div class="panel-heading-btn"><button type="button" class="btn btn-xs btn-icon btn-default" data-offer-refresh aria-label="بارگذاری دوبارهٔ پیشنهادها"><i class="fa fa-rotate" aria-hidden="true"></i></button></div></div>
        <div class="panel-body">
            <p>قیمت پیش از تخفیف به تومان است. پیشنهاد تازه با متعلقات فعال و قیمت پایهٔ آن‌ها ساخته می‌شود؛ پس از ذخیره، قیمت و مجازبودن متعلقات آن قابل تنظیم است.</p>
            <form class="admin-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2 mb-3" data-offer-filter>
                <label class="visually-hidden" for="offer-search">جست‌وجوی پیشنهاد</label>
                <input class="form-control" id="offer-search" type="search" maxlength="100"
                       placeholder="جست‌وجوی کالا، کد یا طرح" />
                <span class="admin-record-count ms-auto small text-muted" data-offer-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-offer-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle"
                       data-admin-datatable data-admin-table-mode="server">
                    <thead>
                    <tr>
                        <th scope="col">کالا</th>
                        <th scope="col">طرح</th>
                        <th scope="col">قیمت پیش از تخفیف (تومان)</th>
                        <th scope="col">تخفیف (%)</th>
                        <th scope="col">سقف خرید</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                    </thead>
                    <tbody data-offer-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3"
                 data-offer-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-offer-page="-1">قبلی</button>
                <span data-offer-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-offer-page="1">بعدی</button>
            </div>
        </div>
    </section>
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">قیمت تنوع و طرح</h2>
            <div class="panel-heading-btn">
                <button type="button" class="btn btn-xs btn-icon btn-default" data-price-refresh aria-label="بارگذاری دوباره">
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2 mb-3" data-price-filter>
                <label class="visually-hidden" for="variant-price-search">جست‌وجو</label>
                <input class="form-control" id="variant-price-search" type="search" maxlength="100"
                       placeholder="جست‌وجوی کالا، تنوع یا طرح" autocomplete="off">
                <span class="admin-record-count ms-auto small text-muted" data-price-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-price-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" data-admin-datatable data-admin-table-mode="server">
                    <thead>
                    <tr>
                        <th scope="col">کالا</th><th scope="col">تنوع انبار</th><th scope="col">طرح فروش</th><th scope="col">قیمت (تومان)</th><th scope="col">تخفیف (%)</th><th scope="col">وضعیت</th><th scope="col">عملیات</th>
                    </tr>
                    </thead><tbody data-price-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3"
                 data-price-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-price-page="-1">قبلی</button>
                <span data-price-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-price-page="1">بعدی</button>
            </div>
        </div>
    </section>
    <section class="panel panel-inverse mt-3" aria-labelledby="price-history-title">
        <div class="panel-heading d-flex align-items-center justify-content-between"><h2 class="panel-title" id="price-history-title">تاریخچهٔ قیمت</h2><button type="button" class="btn btn-xs btn-icon btn-default" data-price-history-refresh aria-label="بارگذاری تاریخچه"><i class="fa fa-clock-rotate-left" aria-hidden="true"></i></button></div>
        <div class="panel-body"><div class="small text-muted mb-2" data-price-history-status role="status" aria-live="polite">در حال دریافت تاریخچه…</div><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>شناسه</th><th>کالا</th><th>طرح</th><th>نوع</th><th>مبلغ</th><th>وضعیت</th><th>زمان ثبت</th><th>نسخهٔ قبل</th></tr></thead><tbody data-price-history-rows></tbody></table></div></div>
    </section>
</div>
<div class="modal fade" id="offer-specifications-modal" tabindex="-1" aria-labelledby="offer-specifications-title" aria-hidden="true">
    <div class="modal-dialog modal-lg"><form class="modal-content" data-offer-specifications-form>
        <div class="modal-header"><h2 class="modal-title fs-5" id="offer-specifications-title">مشخصات نمایشی پیشنهاد</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body"><p data-offer-specifications-name></p><label class="form-label" for="offer-specifications-text">هر خط: عنوان مشخصه | مقدار این طرح</label><textarea id="offer-specifications-text" class="form-control" name="specifications" rows="8"></textarea><div class="admin-data-status mt-2 small text-muted" data-offer-specifications-status role="status" aria-live="polite"></div></div>
        <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
    </form></div>
</div>
<div class="modal fade" id="offer-accessories-modal" tabindex="-1" aria-labelledby="offer-accessories-title" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="offer-accessories-title">متعلقات پیشنهاد</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body"><p data-offer-accessories-name></p><p>متعلقهٔ اجباری همواره مجاز است؛ قیمت هر متعلقه به تومان و برای همین طرح است.</p>
            <div data-offer-accessories-status role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table align-middle" data-admin-datatable><thead><tr><th scope="col">متعلقه</th><th scope="col">قیمت پایه</th><th scope="col">قیمت در طرح</th><th scope="col">مجاز</th><th scope="col">عملیات</th></tr></thead><tbody data-offer-accessories-rows></tbody></table></div>
        </div><div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">بستن</button></div>
    </div></div>
</div>
