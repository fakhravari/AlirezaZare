@model Shop.Admin.Models.FeaturePageViewModel
@{
    string promotionSection = ViewData["PromotionSection"]?.ToString() ?? "offers";
    string sectionTitle = promotionSection switch
    {
        "plans" => "مدیریت طرح‌های فروش",
        "offers" => "پیشنهادهای کالا و تخفیف",
        "variant-prices" => "قیمت تنوع‌ها",
        "history" => "تاریخچهٔ قیمت",
        _ => Model.Title
    };
    string sectionDescription = promotionSection switch
    {
        "plans" => "ساخت طرح، تنظیم بازهٔ اجرا و مدیریت انتشار طرح‌های فروش.",
        "offers" => "مدیریت قیمت، تخفیف، ظرفیت خرید و متعلقات پیشنهادهای کالا.",
        "variant-prices" => "تنظیم قیمت و تخفیف اختصاصی هر تنوع انبار در طرح فروش.",
        "history" => "بازبینی نسخه‌های ثبت‌شدهٔ قیمت کالاها و طرح‌های فروش.",
        _ => Model.Description
    };
}
<div class="admin-page" data-store-variant-prices data-api="@ViewData["ApiUrl"]" data-can-edit="@(User.IsInRole("system.full-access") || User.HasClaim("admin_permission", "Store:Features:Index:promotions") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", (sectionTitle, sectionDescription))
    @Html.AntiForgeryToken()
    @if (promotionSection == "plans" && User.IsInRole("system.full-access"))
    {
        <section class="panel panel-inverse admin-sales-plans">
            <div class="panel-heading"><h2 class="panel-title">مدیریت طرح‌های فروش</h2></div>
            <div class="panel-body admin-sales-plans__body">
                <div class="admin-sales-plans__section">
                <h3 class="admin-sales-plans__title"><i class="fa fa-magnifying-glass" aria-hidden="true"></i> جست‌وجوی طرح</h3>
                <form class="admin-sales-plans__filter" data-plan-filter>
                    <label class="visually-hidden" for="plan-product-search">جست‌وجوی کالا</label><input id="plan-product-search" class="form-control" type="search" name="q" maxlength="100" placeholder="نام یا کد کالای دارای قیمت در طرح" />
                    <label for="plan-filter-from">از تاریخ اجرای طرح</label><input id="plan-filter-from" class="form-control" type="date" name="from" />
                    <label for="plan-filter-to">تا تاریخ اجرای طرح</label><input id="plan-filter-to" class="form-control" type="date" name="to" />
                    <button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="reset">پاک‌کردن</button>
                </form>
                <p class="admin-sales-plans__help">طرح‌های هم‌پوشان با بازه نمایش داده می‌شوند؛ طرح بدون تاریخ، باز در نظر گرفته می‌شود.</p>
                </div>
                <details class="admin-sales-plans__section admin-sales-plans__create">
                <summary class="admin-sales-plans__title"><i class="fa fa-circle-plus" aria-hidden="true"></i> ایجاد طرح فروش جدید</summary>
                <p class="admin-sales-plans__help">طرح جدید به‌صورت پیش‌نویس ساخته می‌شود؛ پس از تنظیم، آن را منتشر کنید.</p>
                <form data-plan-create data-admin-confirm="طرح فروش جدید ساخته شود؟">
                    <div class="row g-2"><div class="col-md-3"><label class="form-label" for="new-plan-key">کلید یکتا</label><input id="new-plan-key" class="form-control" name="key" maxlength="64" pattern="[a-z0-9][a-z0-9-]*" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-code">کد</label><input id="new-plan-code" class="form-control" name="code" maxlength="64" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-name">نام</label><input id="new-plan-name" class="form-control" name="displayName" maxlength="200" required /></div><div class="col-md-3"><label class="form-label" for="new-plan-type">نوع</label><input id="new-plan-type" class="form-control" name="planType" maxlength="30" required /></div></div>
                    <button class="btn btn-success mt-3" type="submit"><i class="fa fa-file-circle-plus me-1" aria-hidden="true"></i>ساخت پیش‌نویس</button>
                </form>
                </details>
                <form class="admin-sales-plans__section" data-plan-settings data-admin-confirm="تنظیمات طرح فروش ذخیره شود؟">
                    <div class="admin-sales-plans__heading"><h3 class="admin-sales-plans__title"><i class="fa fa-sliders" aria-hidden="true"></i> ویرایش و انتشار طرح</h3><span class="admin-sales-plans__badge" data-plan-publication hidden></span></div>
                    <div class="mb-3"><label class="form-label" for="plan-settings-id">طرح فروش</label><select id="plan-settings-id" class="form-select" name="id" required></select></div>
                    <h4 class="admin-sales-plans__subtitle">مشخصات طرح</h4>
                    <div class="row g-2 mb-3"><div class="col-md-4"><label class="form-label" for="plan-settings-code">کد</label><input id="plan-settings-code" class="form-control" name="code" maxlength="64" /></div><div class="col-md-4"><label class="form-label" for="plan-settings-name">نام طرح</label><input id="plan-settings-name" class="form-control" name="displayName" maxlength="200" /></div><div class="col-md-4"><label class="form-label" for="plan-settings-type">نوع</label><input id="plan-settings-type" class="form-control" name="planType" maxlength="30" /></div></div>
                    <button class="btn btn-default mb-3" type="button" data-plan-details-save data-admin-confirm="مشخصات طرح فروش ذخیره شود؟"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ مشخصات</button>
                    <h4 class="admin-sales-plans__subtitle">زمان و نمایش</h4>
                    <div class="row g-2 mb-3"><div class="col-md-6"><label class="form-label" for="plan-settings-start">شروع (UTC)</label><input id="plan-settings-start" class="form-control" name="startsAtUtc" type="datetime-local" step="1" /></div>
                    <div class="col-md-6"><label class="form-label" for="plan-settings-end">پایان (UTC)</label><input id="plan-settings-end" class="form-control" name="endsAtUtc" type="datetime-local" step="1" /></div></div>
                    <div class="mb-3"><label class="form-label" for="plan-settings-label">برچسب</label><input id="plan-settings-label" class="form-control" name="label" maxlength="100" /></div>
                    <div class="form-check mb-3"><input data-admin-switch role="switch" id="plan-settings-countdown" class="form-check-input" name="showCountdown" type="checkbox" /><label class="form-check-label" for="plan-settings-countdown">نمایش شمارش معکوس</label></div>
                    <button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ تنظیمات طرح</button>
                    <div class="admin-sales-plans__publication"><h4 class="admin-sales-plans__subtitle">انتشار و حذف</h4><p class="admin-sales-plans__help">برای عرضه، طرح را منتشر کنید؛ طرح‌های دارای سابقه فقط غیرفعال می‌شوند.</p><div class="admin-sales-plans__actions">
                    <button class="btn btn-success" type="button" data-plan-publish data-admin-confirm="طرح فروش منتشر شود؟"><i class="fa fa-paper-plane me-1" aria-hidden="true"></i>انتشار طرح</button>
                    <button class="btn btn-warning" type="button" data-plan-unpublish data-admin-confirm="طرح از فروش خارج شود؟"><i class="fa fa-eye-slash me-1" aria-hidden="true"></i>خروج از فروش</button>
                    <button class="btn btn-danger" type="button" data-plan-delete data-admin-confirm="طرح فروش حذف شود؟"><i class="fa fa-trash-can me-1" aria-hidden="true"></i>حذف طرح بدون سابقه</button></div></div>
                    <div class="admin-data-status mt-2 small text-muted" data-plan-status role="status" aria-live="polite">در حال دریافت طرح‌ها…</div>
                </form>
            </div>
        </section>
    }
    @if (promotionSection == "offers")
    {
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">پیشنهادهای کالا در طرح‌های ویژه</h2><div class="panel-heading-btn"><button type="button" class="btn btn-xs btn-icon btn-default" data-offer-refresh aria-label="بارگذاری دوبارهٔ پیشنهادها"><i class="fa fa-rotate" aria-hidden="true"></i></button></div></div>
        <div class="panel-body">
            <p>قیمت پیش از تخفیف به تومان است. پیشنهاد تازه با متعلقات فعال و قیمت پایهٔ آن‌ها ساخته می‌شود؛ پس از ذخیره، قیمت و مجازبودن متعلقات آن قابل تنظیم است.</p>
            <form class="admin-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2 mb-3" data-offer-filter>
                <label class="visually-hidden" for="offer-search">جست‌وجوی پیشنهاد</label>
                <select class="form-select" id="offer-search" name="productIds" multiple data-product-filter aria-label="انتخاب کالا با نام یا کد"></select>
                <label for="offer-from">از تاریخ ثبت قیمت</label><input id="offer-from" class="form-control" type="date" name="from" />
                <label for="offer-to">تا تاریخ ثبت قیمت</label><input id="offer-to" class="form-control" type="date" name="to" />
                <button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="reset">پاک‌کردن</button>
                <span class="admin-record-count ms-auto small text-muted" data-offer-count aria-live="polite"></span>
            </form>
            <p class="small text-muted">فیلتر تاریخ فقط پیشنهادهایی را نشان می‌دهد که قیمت آن‌ها ثبت شده است. قیمت تنوع‌های انبار از بخش قیمت تنوع‌ها مدیریت می‌شود.</p>
            <div class="admin-data-status small text-muted" data-offer-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle"
                       data-admin-datatable data-admin-table-mode="server">
                    <thead>
                    <tr>
                        <th scope="col">کالا</th>
                        <th scope="col">طرح</th>
                        <th scope="col">قیمت پیش از تخفیف (تومان)</th>
                        <th scope="col">تخفیف (%)</th>
                        <th scope="col">مبلغ نهایی (تومان)</th>
                        <th scope="col">سقف خرید</th>
                        <th scope="col">وضعیت</th>
                        <th scope="col">عملیات</th>
                    </tr>
                    </thead>
                    <tbody data-offer-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3"
                 data-offer-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-offer-page="-1">قبلی</button>
                <span data-offer-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-offer-page="1">بعدی</button>
            </div>
        </div>
    </section>
    }
    @if (promotionSection == "variant-prices")
    {
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">قیمت تنوع و طرح</h2>
            <div class="panel-heading-btn">
                <button type="button" class="btn btn-xs btn-icon btn-default" data-price-refresh aria-label="بارگذاری دوباره">
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2 mb-3" data-price-filter>
                <label class="visually-hidden" for="variant-price-search">جست‌وجو</label>
                <select class="form-select" id="variant-price-search" name="productIds" multiple data-product-filter aria-label="انتخاب کالا با نام یا کد"></select>
                <label for="variant-price-plan">طرح فروش</label>
                <select class="form-select" id="variant-price-plan" name="salesPlanId" data-price-plan-filter><option value="">همهٔ طرح‌ها</option></select>
                <label for="variant-price-from">از تاریخ ثبت قیمت</label><input id="variant-price-from" class="form-control" type="date" name="from" />
                <label for="variant-price-to">تا تاریخ ثبت قیمت</label><input id="variant-price-to" class="form-control" type="date" name="to" />
                <button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="reset">پاک‌کردن</button>
                <span class="admin-record-count ms-auto small text-muted" data-price-count aria-live="polite"></span>
            </form>
            <p class="small text-muted">فیلتر تاریخ فقط تنوع‌هایی را نشان می‌دهد که قیمت اختصاصی آن‌ها ثبت شده است.</p>
            <div class="admin-data-status small text-muted" data-price-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle" data-admin-datatable data-admin-table-mode="server">
                    <thead>
                    <tr>
                        <th scope="col">کالا</th><th scope="col">تنوع انبار</th><th scope="col">طرح فروش</th><th scope="col">مبلغ پیش از تخفیف (تومان)</th><th scope="col">تخفیف (%)</th><th scope="col">مبلغ نهایی (تومان)</th><th scope="col">وضعیت</th><th scope="col">عملیات</th>
                    </tr>
                    </thead><tbody data-price-rows></tbody>
                </table>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary" data-price-save-all data-admin-confirm="تغییرات قیمت تنوع‌ها ذخیره شود؟" disabled><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ همهٔ تغییرات</button>
                <span class="small text-muted ms-2" data-price-save-all-status role="status" aria-live="polite"></span>
            </div>
        </div>
    </section>
    }
    @if (promotionSection == "history")
    {
    <section class="panel panel-inverse mt-3" aria-labelledby="price-history-title">
        <div class="panel-heading d-flex align-items-center justify-content-between"><h2 class="panel-title" id="price-history-title">تاریخچهٔ قیمت</h2><button type="button" class="btn btn-xs btn-icon btn-default" data-price-history-refresh aria-label="بارگذاری تاریخچه"><i class="fa fa-clock-rotate-left" aria-hidden="true"></i></button></div>
        <div class="panel-body">
            <form class="admin-filter-bar mb-3 d-flex flex-wrap align-items-center gap-2" data-history-filter>
                <label class="visually-hidden" for="history-product-search">جست‌وجوی کالا</label><select id="history-product-search" class="form-select" name="productIds" multiple data-product-filter aria-label="انتخاب کالا با نام یا کد"></select>
                <label for="history-from">از تاریخ ثبت</label><input id="history-from" class="form-control" type="date" name="from" />
                <label for="history-to">تا تاریخ ثبت</label><input id="history-to" class="form-control" type="date" name="to" />
                <button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="reset">پاک‌کردن</button>
            </form>
            <div class="small text-muted mb-2" data-price-history-status role="status" aria-live="polite">در حال دریافت تاریخچه…</div><div class="table-responsive"><table class="table table-striped table-hover align-middle" data-admin-datatable data-admin-table-mode="server"><thead><tr><th scope="col">شناسه</th><th scope="col">کالا</th><th scope="col">طرح</th><th scope="col">نوع و شناسهٔ هدف</th><th scope="col">مبلغ پیش از تخفیف (تومان)</th><th scope="col">تخفیف (%)</th><th scope="col">مبلغ نهایی (تومان)</th><th scope="col">وضعیت</th><th scope="col">زمان ثبت</th><th scope="col">نسخهٔ قبل</th><th scope="col">شناسهٔ کاربر</th><th scope="col">دلیل تغییر</th></tr></thead><tbody data-price-history-rows></tbody></table></div>
        </div>
    </section>
    }
</div>
@if (promotionSection == "offers")
{
<div class="modal fade" id="offer-specifications-modal" tabindex="-1" aria-labelledby="offer-specifications-title" aria-hidden="true">
    <div class="modal-dialog modal-lg"><form class="modal-content" data-offer-specifications-form data-admin-confirm="مشخصات نمایشی پیشنهاد ذخیره شود؟">
        <div class="modal-header"><h2 class="modal-title fs-5" id="offer-specifications-title">مشخصات نمایشی پیشنهاد</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body"><p data-offer-specifications-name></p><label class="form-label" for="offer-specifications-text">هر خط: عنوان مشخصه | مقدار این طرح</label><textarea id="offer-specifications-text" class="form-control" name="specifications" rows="8"></textarea><div class="admin-data-status mt-2 small text-muted" data-offer-specifications-status role="status" aria-live="polite"></div></div>
        <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
    </form></div>
</div>
}
@if (promotionSection == "offers")
{
<div class="modal fade" id="offer-accessories-modal" tabindex="-1" aria-labelledby="offer-accessories-title" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="offer-accessories-title">متعلقات پیشنهاد</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body"><p data-offer-accessories-name></p><p>متعلقهٔ اجباری همواره مجاز است؛ قیمت هر متعلقه به تومان و برای همین طرح است.</p>
            <div data-offer-accessories-status role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table align-middle" data-admin-datatable><thead><tr><th scope="col">متعلقه</th><th scope="col">قیمت پایه (تومان)</th><th scope="col">قیمت در طرح (تومان)</th><th scope="col">مجاز</th><th scope="col">عملیات</th></tr></thead><tbody data-offer-accessories-rows></tbody></table></div>
        </div><div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">بستن</button></div>
    </div></div>
</div>
}
