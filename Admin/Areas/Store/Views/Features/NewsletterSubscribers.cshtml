@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-newsletter-subscribers data-api="/api/admin/store/newsletter-subscribers">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    @Html.AntiForgeryToken()

    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">اعضای خبرنامه</h2>
            <a class="btn btn-xs btn-default" data-newsletter-export href="/api/admin/store/newsletter-subscribers/export">خروجی Excel</a>
        </div>
        <div class="panel-body">
            <form data-newsletter-filter class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3">
                <label class="visually-hidden" for="newsletter-search">جست‌وجوی ایمیل</label>
                <input class="form-control" id="newsletter-search" name="q" type="search" maxlength="100" placeholder="جست‌وجوی ایمیل" />
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" name="includeUnsubscribed" value="true" />
                    لغوشده‌ها
                </label>
                <button class="btn btn-primary" type="submit">اعمال</button>
                <span class="admin-record-count ms-auto small text-muted" data-newsletter-status aria-live="polite"></span>
            </form>

            <div class="admin-data-status small text-muted" data-newsletter-load-status role="status" aria-live="polite"></div>
            <div class="table-responsive admin-table-wrap">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead><tr><th>ایمیل</th><th>تاریخ عضویت</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                    <tbody data-newsletter-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3" data-newsletter-pagination hidden>
                <button class="btn btn-default btn-sm" type="button" data-newsletter-page="-1">قبلی</button>
                <span data-newsletter-page-label></span>
                <button class="btn btn-default btn-sm" type="button" data-newsletter-page="1">بعدی</button>
            </div>
        </div>
    </section>
</div>
