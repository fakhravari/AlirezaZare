@model Shop.Admin.Models.FeaturePageViewModel
@{
    string section = ViewData["ContentSection"]?.ToString() ?? "faq";
    string title = ViewData["Title"]?.ToString() ?? "پرسش‌های متداول";
    string description = section switch
    {
        "magazine" => "مقاله‌های مجله را ایجاد، ویرایش و منتشر کنید.",
        "pages" => "عنوان و محتوای صفحه‌های خدماتی را ویرایش و منتشر کنید.",
        _ => "پرسش‌ها و پاسخ‌های متداول را ویرایش و منتشر کنید."
    };
}
<div class="admin-page" data-admin-page="@(section == "faq" ? "faq" : section == "magazine" ? "content-magazine" : "content-pages")" data-admin-api="/api/admin/store/faq">
    @await Html.PartialAsync("_AdminPageIntro", (title, description))
    @if (section == "faq")
    {
        <section class="panel panel-inverse">
            <div class="panel-heading">
                <h2 class="panel-title">پرسش‌های متداول</h2>
                <div class="panel-heading-btn">
                    <button class="btn btn-primary btn-sm" type="button" data-faq-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن پرسش</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite">در حال دریافت پرسش‌ها…</div>
                <div class="table-responsive admin-table-wrap">
                    <table class="table table-striped table-hover align-middle" data-admin-datatable>
                        <thead>
                        <tr>
                            <th scope="col">پرسش</th><th scope="col">ترتیب</th><th scope="col">وضعیت</th><th scope="col">عملیات</th>
                        </tr>
                        </thead><tbody data-faq-rows></tbody>
                    </table>
                </div>
                <p class="admin-editor-help small text-muted">پرسش‌های منتشرنشده در سایت نمایش داده نمی‌شوند. عنوان، معرفی و بخش‌های صفحه در پنل صفحه‌های خدماتی قابل ویرایش است.</p>
            </div>
        </section>
    }
    else if (section == "magazine")
    {
        <section class="panel panel-inverse" data-magazine-admin data-api="/api/admin/store/magazine">
            <div class="panel-heading">
                <h2 class="panel-title">مقاله‌های مجله</h2>
                <div class="panel-heading-btn">
                    <button class="btn btn-primary btn-sm" type="button" data-mag-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن مقاله</button>
                </div>
            </div>
            <div class="panel-body">
                <div class="admin-data-status small text-muted" data-mag-status role="status" aria-live="polite">در حال دریافت مقاله‌ها…</div>
                <div class="table-responsive">
                    <table class="table table-striped" data-admin-datatable>
                        <thead>
                        <tr>
                            <th>عنوان</th><th>نشانی</th><th>بخش‌ها</th><th>انتشار</th><th>عملیات</th>
                        </tr>
                        </thead><tbody data-mag-rows></tbody>
                    </table>
                </div>
                <p class="admin-editor-help small text-muted">برای هر مقاله عنوان، نشانی، اطلاعات نویسنده و بخش‌های متن را ویرایش کنید. پیش‌نمایش عمومی بعد از انتشار در دسترس است.</p>
            </div>
        </section>
    }
    else
    {
        <section class="panel panel-inverse" data-service-pages data-api="/api/admin/store/content/pages">
            <div class="panel-heading">
                <h2 class="panel-title">صفحه‌های خدماتی</h2>
            </div>
            <div class="panel-body">
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label" for="service-page-filter">فیلتر بر اساس خدمت</label>
                        <select class="form-select" id="service-page-filter" data-service-page-filter>
                            <option value="">همهٔ خدمت‌ها</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex justify-content-md-center">
                        <span class="admin-data-status small text-muted" data-service-page-status role="status" aria-live="polite">در حال دریافت صفحه‌ها…</span>
                    </div>
                    <div class="col-md-3 d-flex justify-content-md-end">
                        <button class="btn btn-primary" type="button" data-service-section-create disabled><i class="fa fa-plus me-1" aria-hidden="true"></i>ایجاد ردیف محتوا</button>
                    </div>
                </div>
                <div class="table-responsive admin-table-wrap">
                    <table class="table table-striped table-hover align-middle admin-datatable-compact-actions" data-admin-datatable data-admin-table-search="false">
                        <thead><tr><th scope="col">خدمت</th><th scope="col">عنوان صفحه</th><th scope="col">نشانی</th><th scope="col">ردیف‌های محتوا</th><th scope="col">وضعیت</th><th scope="col">عملیات</th></tr></thead>
                        <tbody data-service-page-rows></tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>
@if (section == "magazine")
{
    <div class="modal fade" id="mag-editor-modal" tabindex="-1" aria-labelledby="mag-editor-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <form class="modal-content" data-mag-editor data-admin-confirm="مقاله با این محتوا ذخیره شود؟">
                @Html.AntiForgeryToken()<input type="hidden" name="id"/>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="mag-editor-title">ویرایش مقاله</h2><button class="btn-close ms-0" type="button" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body row g-3">
                    @foreach (var field in new[] { ("articleKey", "نشانی لاتین مقاله", "text", true, 150), ("title", "عنوان", "text", true, 300), ("category", "دسته", "text", true, 150), ("summary", "خلاصه", "text", true, 1500), ("author", "نویسنده", "text", false, 200), ("kicker", "روتیتر", "text", false, 300), ("branch", "شاخه", "text", true, 160), ("topic", "موضوع", "text", true, 240), ("area", "حوزه", "text", true, 240), ("heroImagePath", "مسیر تصویر اصلی", "text", false, 1000), ("contentImagePath", "مسیر تصویر متن", "text", false, 1000), ("readTimeMinutes", "زمان مطالعه (دقیقه)", "number", false, 0), ("readTimeText", "متن زمان مطالعه", "text", false, 80) })
                    {
                        <div class="col-md-6">
                            <label class="form-label" for="mag-@field.Item1">@field.Item2</label><input class="form-control" id="mag-@field.Item1" name="@field.Item1" type="@field.Item3" maxlength="@(field.Item5 > 0 ? field.Item5 : null)" required="@(field.Item4 ? "required" : null)" min="@(field.Item1 == "readTimeMinutes" ? "1" : null)" max="@(field.Item1 == "readTimeMinutes" ? "180" : null)"/>
                        </div>
                    }
                    <div class="col-12">
                        <label class="form-label" for="mag-lead">مقدمه</label><textarea class="form-control" data-rich-editor id="mag-lead" name="lead" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="mag-conclusion">جمع‌بندی</label><textarea class="form-control" data-rich-editor id="mag-conclusion" name="conclusion" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                            <div>
                                <label class="form-label mb-0">بخش‌های مقاله</label>
                                <p class="admin-editor-help small text-muted">برای هر بخش یک عنوان و متن بنویسید؛ ترتیب کارت‌ها ترتیب نمایش در مقاله است.</p>
                            </div><button class="btn btn-default btn-sm flex-shrink-0" type="button" data-mag-section-add><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن بخش</button>
                        </div><input type="hidden" name="sections" value="[]"/>
                        <div class="d-grid gap-3" data-mag-sections></div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input data-admin-switch role="switch" class="form-check-input" id="mag-published" name="isPublished" type="checkbox"/><label class="form-check-label" for="mag-published">مقاله در سایت منتشر باشد</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" type="button" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal fade" id="article-image-modal" tabindex="-1" aria-labelledby="article-image-title" aria-hidden="true">
        <div class="modal-dialog">
            <form class="modal-content" data-media-upload-form data-article-image-form data-admin-confirm="تصویر انتخاب‌شده برای مقاله بارگذاری شود؟" enctype="multipart/form-data">
                @Html.AntiForgeryToken()<input type="hidden" name="kind" value="article"/><input type="hidden" name="articleKey"/>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="article-image-title">تصویر مقاله</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <p data-article-image-name></p><label for="article-image-file" class="form-label">فایل تصویر</label><input id="article-image-file" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required/>
                    <div class="mt-2" data-media-upload-result role="status" aria-live="polite"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>بارگذاری و اتصال به مقاله</button>
                </div>
            </form>
        </div>
    </div>
}
@if (section == "pages")
{
    <div class="modal fade" id="service-page-editor-modal" tabindex="-1" aria-labelledby="service-page-editor-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-xl">
            <form class="modal-content" data-service-page-editor data-admin-confirm="محتوای این صفحهٔ خدماتی ذخیره شود؟">
                @Html.AntiForgeryToken()<input type="hidden" name="pageKey"/>
                <div class="modal-header">
                    <div><h2 class="modal-title fs-5" id="service-page-editor-title" data-service-page-editor-title>ویرایش صفحهٔ خدماتی</h2><p class="admin-editor-help small text-muted mb-0" data-service-page-editor-hint></p></div>
                    <button class="btn-close ms-0" type="button" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="service-page-title">عنوان صفحه</label><input class="form-control" id="service-page-title" name="title" maxlength="300" required/>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="service-page-description">معرفی کوتاه صفحه</label><textarea class="form-control" id="service-page-description" name="description" maxlength="1000" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
                            <div><label class="form-label mb-0">بخش‌های محتوا</label><p class="admin-editor-help small text-muted mb-0">ترتیب نمایش را با دکمه‌های بالا و پایین در فهرست تغییر دهید؛ ردیف تازه را هم از همان فهرست ایجاد کنید.</p></div>
                        </div>
                        <div class="d-grid gap-3" data-service-sections></div>
                    </div>
                    <div class="col-12">
                        <div class="form-check"><input data-admin-switch role="switch" class="form-check-input" id="service-page-published" name="isPublished" type="checkbox"/><label class="form-check-label" for="service-page-published">صفحه در سایت منتشر باشد</label></div>
                        <p class="admin-editor-help small text-muted">صفحهٔ پیش‌نویس برای بازدیدکنندگان نمایش داده نمی‌شود.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" type="button" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary" type="submit"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیرهٔ تغییرات</button>
                </div>
            </form>
        </div>
    </div>
}
@if (section == "faq")
{
    <div class="modal fade" id="faq-editor-modal" tabindex="-1" aria-labelledby="faq-editor-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <form class="modal-content" data-faq-editor data-admin-confirm="پرسش و پاسخ ذخیره شود؟">
                @Html.AntiForgeryToken()<input type="hidden" name="id"/>
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="faq-editor-title">ویرایش پرسش متداول</h2><button class="btn-close ms-0" type="button" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="faq-question">پرسش</label><textarea id="faq-question" name="question" class="form-control mb-3" maxlength="1000" required></textarea>
                    <label class="form-label" for="faq-answer">پاسخ</label><textarea id="faq-answer" data-rich-editor name="answer" class="form-control mb-3" maxlength="10000" rows="5" required></textarea>
                    <label class="form-label" for="faq-link-text">متن پیوند اختیاری</label><input id="faq-link-text" name="linkText" class="form-control mb-3" maxlength="300"/>
                    <label class="form-label" for="faq-link-url">مسیر داخلی پیوند، مانند /contact</label><input id="faq-link-url" name="linkUrl" class="form-control mb-3" maxlength="1000"/>
                    <label class="form-label" for="faq-order">ترتیب نمایش</label><input id="faq-order" name="sortOrder" type="number" min="0" max="1000000" step="1" class="form-control mb-3" required/>
                    <div class="form-check">
                        <input data-admin-switch role="switch" id="faq-published" name="isPublished" class="form-check-input" type="checkbox"/><label for="faq-published" class="form-check-label">منتشر شود</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button>
                </div>
            </form>
        </div>
    </div>
}
