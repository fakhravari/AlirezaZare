@model Shop.Admin.Areas.Store.Controllers.HomeCollectionModel

<div class="admin-page" data-home-collection>
    @await Html.PartialAsync("_AdminPageIntro", ("محصولات منتخب صفحهٔ اصلی", "دسته‌های فیلتر و کالاهای این بخش را مدیریت کنید."))
    @if (TempData["HomeCollectionMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">دسته‌های فیلتر</h2>
        </div>
        <div class="panel-body">
            @if (!Model.TabsReady)
            {
                <div class="alert alert-warning">برای مدیریت دسته‌ها ابتدا migration شمارهٔ ۱۵۴ را روی پایگاه دادهٔ هدف اجرا کنید.</div>
            }
            <p>دسته‌های فعال به ترتیب مشخص‌شده نمایش داده می‌شوند و شامل کالاهای زیردسته‌های خود نیز هستند.</p>
            @if (Model.TabsReady)
            {
                <form asp-action="AddCategories" method="post" class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div class="home-collection-category-picker">
                        <label for="categoryIds" class="form-label">افزودن دسته‌های فیلتر</label>
                        <select id="categoryIds" name="categoryIds" class="form-select" multiple data-checkbox-filter aria-label="انتخاب چند دسته برای فیلتر">
                            @foreach (var category in Model.Categories.Where(category => !Model.Tabs.Any(tab => tab.CategoryId == category.Id)))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">افزودن دسته‌های انتخاب‌شده</button>
                </form>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                        <tr>
                            <th>دسته</th><th>تنظیمات</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var tab in Model.Tabs)
                        {
                            <tr>
                                <td>
                                    @tab.Name
                                    @if (!tab.CategoryActive)
                                    {
                                        <span class="text-danger">(دسته غیرفعال است)</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Category" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                        <input type="hidden" name="id" value="@tab.Id"/>
                                        <label for="category-order-@tab.Id">ترتیب</label><input id="category-order-@tab.Id" type="number" name="sortOrder" min="0" value="@tab.SortOrder" class="form-control w-auto" required/>
                                        <label><input type="checkbox" name="isActive" value="true" checked="@tab.IsActive"/> فعال</label>
                                        <button type="submit" name="operation" value="save" class="btn btn-primary btn-sm">ذخیره</button>
                                        <button type="submit" name="operation" value="remove" class="btn btn-danger btn-sm">حذف از فیلتر</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (Model.Tabs.Count == 0)
                        {
                            <tr>
                                <td colspan="2">دسته‌ای انتخاب نشده است.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">کالاهای منتخب</h2>
        </div>
        <div class="panel-body">
            <p>نمایش کالا در فروشگاه به وضعیت فعال کالا، دسته و برند و شرایط فروش آن بستگی دارد.</p>
            <form asp-action="AddProducts" method="post" class="d-flex flex-wrap gap-2 align-items-end mb-3">
                <div class="home-collection-product-picker">
                    <label for="productIds" class="form-label">افزودن کالا به منتخب‌ها</label>
                    <select id="productIds" name="productIds" class="form-select" multiple data-product-filter
                            data-product-candidates-url="@Url.Action("Candidates", "HomeCollection", new { area = "Store" })"
                            aria-label="جست‌وجو و انتخاب کالاها"></select>
                </div>
                <button type="submit" class="btn btn-primary">افزودن کالاهای انتخاب‌شده</button>
            </form>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                    <tr>
                        <th>کالا</th><th>کد</th><th>تنظیمات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                @product.Name
                                @if (!product.IsStoreEnabled)
                                {
                                    <span class="text-danger">(غیرفعال در فروشگاه)</span>
                                }
                            </td><td>@product.Code</td>
                            <td>
                                <form asp-action="Product" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                    <input type="hidden" name="id" value="@product.Id"/>
                                    <label for="product-order-@product.Id">ترتیب</label><input id="product-order-@product.Id" type="number" name="sortOrder" min="0" value="@product.SortOrder" class="form-control w-auto" required/>
                                    <button type="submit" name="operation" value="save" class="btn btn-primary btn-sm">ذخیره</button>
                                    <button type="submit" name="operation" value="remove" class="btn btn-danger btn-sm">حذف از منتخب</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="3">کالایی انتخاب نشده است.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
