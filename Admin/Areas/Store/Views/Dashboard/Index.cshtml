@{
    ViewData["Title"] = "نمای کلی فروشگاه";
    ViewData["AreaTitle"] = "مدیریت فروشگاه";
}

<div class="admin-page" data-admin-page="store-dashboard">
    @await Html.PartialAsync("_AdminPageIntro", ("نمای کلی فروشگاه", "ورود سریع به کاتالوگ و بخش‌های اصلی فروشگاه."))
    <div class="row g-3 g-xl-4">
        <div class="col-md-6 col-xxl-3">
            <a class="card border-0 shadow-sm h-100 text-decoration-none" asp-area="Store" asp-controller="Catalog" asp-action="Products" data-admin-nav>
                <span class="card-body d-flex flex-column align-items-start p-4">
                    <span class="rounded-3 bg-light border text-blue p-3 mb-4" aria-hidden="true"><i class="fa fa-box-open fs-4"></i></span>
                    <span class="fw-bold text-body">کاتالوگ کالا</span>
                    <span class="text-muted small mt-2">محصولات، دسته‌ها، برندها و ویژگی‌ها</span>
                    <span class="d-flex align-items-center gap-2 text-theme small mt-auto pt-4">ورود به کاتالوگ <i class="fa fa-arrow-left" aria-hidden="true"></i></span>
                </span>
            </a>
        </div>
        <div class="col-md-6 col-xxl-3">
            <a class="card border-0 shadow-sm h-100 text-decoration-none" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="orders" data-admin-nav>
                <span class="card-body d-flex flex-column align-items-start p-4">
                    <span class="rounded-3 bg-light border text-orange p-3 mb-4" aria-hidden="true"><i class="fa fa-receipt fs-4"></i></span>
                    <span class="fw-bold text-body">سفارش‌ها</span>
                    <span class="text-muted small mt-2">چرخهٔ پرداخت، آماده‌سازی و ارسال</span>
                    <span class="d-flex align-items-center gap-2 text-theme small mt-auto pt-4">مشاهدهٔ سفارش‌ها <i class="fa fa-arrow-left" aria-hidden="true"></i></span>
                </span>
            </a>
        </div>
        <div class="col-md-6 col-xxl-3">
            <a class="card border-0 shadow-sm h-100 text-decoration-none" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="customers" data-admin-nav>
                <span class="card-body d-flex flex-column align-items-start p-4">
                    <span class="rounded-3 bg-light border text-green p-3 mb-4" aria-hidden="true"><i class="fa fa-users fs-4"></i></span>
                    <span class="fw-bold text-body">مشتریان</span>
                    <span class="text-muted small mt-2">پروفایل، نشانی و سابقهٔ خرید</span>
                    <span class="d-flex align-items-center gap-2 text-theme small mt-auto pt-4">مدیریت مشتریان <i class="fa fa-arrow-left" aria-hidden="true"></i></span>
                </span>
            </a>
        </div>
        <div class="col-md-6 col-xxl-3">
            <a class="card border-0 shadow-sm h-100 text-decoration-none" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="reviews" data-admin-nav>
                <span class="card-body d-flex flex-column align-items-start p-4">
                    <span class="rounded-3 bg-light border text-purple p-3 mb-4" aria-hidden="true"><i class="fa fa-comments fs-4"></i></span>
                    <span class="fw-bold text-body">بازخورد محصول</span>
                    <span class="text-muted small mt-2">دیدگاه‌ها و پرسش‌های مشتریان</span>
                    <span class="d-flex align-items-center gap-2 text-theme small mt-auto pt-4">بررسی بازخوردها <i class="fa fa-arrow-left" aria-hidden="true"></i></span>
                </span>
            </a>
        </div>
    </div>
    <section class="card border-0 shadow-sm mt-4" aria-labelledby="store-catalog-shortcuts-title">
        <div class="card-header bg-transparent border-bottom-0 px-4 pt-4">
            <h2 class="h5 mb-0" id="store-catalog-shortcuts-title">میان‌برهای کاتالوگ</h2>
        </div>
        <div class="card-body pt-0 px-4 pb-4">
            <div class="list-group list-group-horizontal flex-wrap">
                <a class="list-group-item list-group-item-action" asp-area="Store" asp-controller="Catalog" asp-action="Products" data-admin-nav>محصولات <i class="fa fa-arrow-left ms-2" aria-hidden="true"></i></a>
                <a class="list-group-item list-group-item-action" asp-area="Store" asp-controller="Catalog" asp-action="Categories" data-admin-nav>دسته‌بندی‌ها <i class="fa fa-arrow-left ms-2" aria-hidden="true"></i></a>
                <a class="list-group-item list-group-item-action" asp-area="Store" asp-controller="Catalog" asp-action="Brands" data-admin-nav>برندها <i class="fa fa-arrow-left ms-2" aria-hidden="true"></i></a>
                <a class="list-group-item list-group-item-action" asp-area="Store" asp-controller="Catalog" asp-action="Attributes" data-admin-nav>ویژگی‌ها <i class="fa fa-arrow-left ms-2" aria-hidden="true"></i></a>
            </div>
        </div>
    </section>
</div>
