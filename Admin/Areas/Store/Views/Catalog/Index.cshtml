@{
    string catalogSection = (string)ViewData["Section"]!;
    string apiUrl = (string)ViewData["ApiUrl"]!;
}
<div class="admin-page" data-admin-page="catalog" data-admin-section="@catalogSection" data-admin-api="@apiUrl" data-can-upload-image="@(User.IsInRole("system.full-access") ? "true" : "false")" data-can-edit-category="@(User.IsInRole("system.full-access") || (User.HasClaim("admin_permission", "Store:StoreCategoryContentApi:Get") && User.HasClaim("admin_permission", "Store:StoreCategoryContentApi:Update")) ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", ((string)ViewData["Title"]!, (string)ViewData["Description"]!))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">@ViewData["Title"]</h2>
            <div class="panel-heading-btn">
                @if (catalogSection == "products" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-product-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن کالا</button>
                }
                @if (catalogSection == "categories" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-category-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن دسته</button>
                }
                @if (catalogSection == "brands" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-brand-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن برند</button>
                }
                @if (catalogSection == "attributes" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-attribute-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن ویژگی</button>
                }
                <button class="btn btn-xs btn-icon btn-default" type="button" data-admin-refresh aria-label="بارگذاری دوباره">
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3" data-admin-filter>
                <label class="visually-hidden" for="catalog-search">جست‌وجوی کاتالوگ</label>
                <input id="catalog-search" class="form-control" type="search" name="q" placeholder="جست‌وجو در @ViewData["Title"]" autocomplete="off"/>
                <button class="btn btn-primary" type="submit"><i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>جست‌وجو</button>
                @if (catalogSection == "categories")
                {
                    <button class="btn btn-default" type="button" data-category-tree-expand>بازکردن همه</button>
                    <button class="btn btn-default" type="button" data-category-tree-collapse>بستن همه</button>
                }
                <span class="admin-record-count ms-auto small text-muted" data-admin-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite">در حال خواندن داده از دیتابیس…</div>
            <div class="table-responsive admin-table-wrap @(catalogSection == "categories" ? "admin-category-tree-wrap" : "")">
                <table class="table table-striped table-hover align-middle mb-0" data-admin-datatable data-admin-table-mode="@(catalogSection == "categories" ? "tree" : "server")">
                    <thead>
                    <tr>
                        @if (catalogSection == "products")
                        {
                            <th scope="col">کد</th>
                            <th scope="col">نام کالا</th>
                            <th scope="col">برند</th>
                            <th scope="col">دسته‌بندی</th>
                            <th scope="col">عملیات</th>
                        }
                        else if (catalogSection == "categories")
                        {
                            <th scope="col">شناسه</th>
                            <th scope="col">دسته‌بندی</th>
                            <th scope="col">نام لاتین</th>
                            <th scope="col">والد</th>
                            <th scope="col">نشانی</th>
                            <th scope="col">وضعیت انتشار</th>
                        }
                        else if (catalogSection == "brands")
                        {
                            <th scope="col">شناسه</th>
                            <th scope="col">برند</th>
                            <th scope="col">نام لاتین</th>
                            <th scope="col">کشور</th>
                            <th scope="col">وضعیت انتشار</th>
                            <th scope="col">عملیات</th>
                        }
                        else if (catalogSection == "payment-institutions")
                        {
                            <th scope="col">نام درگاه</th>
                            <th scope="col">شناسه</th>
                            <th scope="col">لوگو</th>
                            <th scope="col">مسیر فایل</th>
                            <th scope="col">عملیات</th>
                        }
                        else
                        {
                            <th scope="col">کلید</th>
                            <th scope="col">ویژگی</th>
                            <th scope="col">منبع</th>
                            <th scope="col">کلید فیلتر</th>
                            <th scope="col">قابل فیلتر</th>
                            <th scope="col">نمایش برجسته</th>
                            <th scope="col">وضعیت انتشار</th>
                            <th scope="col">عملیات</th>
                        }
                    </tr>
                    </thead>
                    <tbody data-admin-results></tbody>
                </table>
            </div>
            <div class="admin-empty-state d-none p-4 text-center text-muted small" data-admin-empty>موردی برای نمایش پیدا نشد.</div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3" data-admin-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="-1">قبلی</button>
                <span data-admin-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="1">بعدی</button>
            </div>
            <p class="admin-readonly-note alert alert-info small d-flex align-items-start gap-2 mt-3"><i class="fa fa-circle-info" aria-hidden="true"></i> @(catalogSection == "categories" ? "محتوای مشترک محصول در دسته قابل ویرایش است." : catalogSection == "products" ? "مدیر دارای دسترسی کامل می‌تواند تصویر، ویدئو و فایل کالا را بارگذاری کند." : catalogSection == "brands" ? "مدیر دارای دسترسی کامل می‌تواند برند را ایجاد یا ویرایش و نشان آن را بارگذاری کند." : catalogSection == "payment-institutions" ? "تصویرها به WebP و فایل SVG پس از پاک‌سازی ذخیره می‌شود؛ فایل در FTP قرار می‌گیرد و مسیر آن در جدول ثبت می‌شود." : "مدیر دارای دسترسی کامل می‌تواند ویژگی را ایجاد و ویرایش کند؛ کلید ویژگی پس از استفاده ثابت می‌ماند.")</p>
        </div>
    </section>
</div>
@if (catalogSection == "products" && User.IsInRole("system.full-access"))
{
    <section class="panel panel-inverse" data-admin-page="product-drafts" data-admin-section="products" data-can-upload-image="true">
        <div class="panel-heading"><h2 class="panel-title">پیش‌نویس‌های کالا</h2></div>
        <div class="panel-body"><p>پیش‌نویس پس از ثبت تصویر و انتشار در فروشگاه نمایش داده می‌شود.</p>
            <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite"></div>
            <div class="table-responsive"><table class="table table-striped align-middle" data-admin-datatable data-admin-table-mode="server"><thead><tr><th>کد</th><th>نام</th><th>برند</th><th>دسته</th><th>قیمت تومان</th><th>تصویر</th><th>عملیات</th></tr></thead><tbody data-admin-results></tbody></table></div>
            <div class="admin-empty-state d-none p-4 text-center text-muted small" data-admin-empty>پیش‌نویسی وجود ندارد.</div>
        </div>
    </section>
    <div class="modal fade" id="product-create-modal" tabindex="-1" aria-labelledby="product-create-title" aria-hidden="true">
        <div class="modal-dialog modal-lg"><form class="modal-content" data-product-create-form>
            @Html.AntiForgeryToken()
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-create-title">افزودن پیش‌نویس کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <label class="form-label" for="new-product-key">شناسه و نشانی لاتین</label><input class="form-control mb-3" id="new-product-key" name="key" maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" required />
                <label class="form-label" for="new-product-code">کد کالا</label><input class="form-control mb-3" id="new-product-code" name="code" maxlength="100" required />
                <label class="form-label" for="new-product-name">نام فارسی</label><input class="form-control mb-3" id="new-product-name" name="name" maxlength="300" required />
                <label class="form-label" for="new-product-english">نام لاتین</label><input class="form-control mb-3" id="new-product-english" name="englishName" maxlength="300" required />
                <label class="form-label" for="new-product-brand">برند</label><select class="form-select mb-3" id="new-product-brand" name="brandId" required></select>
                <label class="form-label" for="new-product-category">دستهٔ برگ</label><select class="form-select mb-3" id="new-product-category" name="categoryId" required></select>
                <label class="form-label" for="new-product-unit">واحد پایه</label><select class="form-select mb-3" id="new-product-unit" name="unitId" required></select>
                <label class="form-label" for="new-product-price">قیمت فروش عادی (تومان)</label><input class="form-control mb-3" id="new-product-price" name="priceAmount" type="number" min="0" max="9007199254740991" step="1" required />
                <label class="form-label" for="new-product-discount">درصد تخفیف نمایشی</label><input class="form-control mb-3" id="new-product-discount" name="discountPercent" type="number" min="0" max="99.99" step="0.01" value="0" required />
                <label class="form-label" for="new-product-limit">حداکثر تعداد خرید</label><input class="form-control" id="new-product-limit" name="maxPurchaseQuantity" type="number" min="1" max="99" step="1" value="99" required />
            </div><div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-file-circle-plus me-1" aria-hidden="true"></i>ساخت پیش‌نویس</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="product-editor-modal" tabindex="-1" aria-labelledby="product-editor-title" aria-hidden="true">
        <div class="modal-dialog modal-lg"><form class="modal-content" data-product-editor>
            @Html.AntiForgeryToken()<input type="hidden" name="id" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-editor-title">ویرایش اطلاعات کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <p data-product-editor-code></p>
                <label for="product-edit-name" class="form-label">نام فارسی</label><input id="product-edit-name" name="name" class="form-control mb-3" maxlength="300" required />
                <label for="product-edit-english" class="form-label">نام لاتین</label><input id="product-edit-english" name="englishName" class="form-control mb-3" maxlength="300" required />
                <label for="product-edit-brand" class="form-label">برند</label><select id="product-edit-brand" name="brandId" class="form-select mb-3" required></select>
                <label for="product-edit-category" class="form-label">دستهٔ برگ</label><select id="product-edit-category" name="categoryId" class="form-select mb-3" required></select>
                <label for="product-edit-price" class="form-label">قیمت نهایی فروش عادی (تومان)</label><input id="product-edit-price" name="priceAmount" type="number" min="0" max="9007199254740991" step="1" class="form-control mb-3" required />
                <label for="product-edit-discount" class="form-label">درصد تخفیف نمایشی</label><input id="product-edit-discount" name="discountPercent" type="number" min="0" max="99.99" step="0.01" class="form-control mb-3" required />
                <label for="product-edit-limit" class="form-label">حداکثر تعداد خرید</label><input id="product-edit-limit" name="maxPurchaseQuantity" type="number" min="1" max="99" step="1" class="form-control" required />
                <p class="text-muted mt-2">قیمت نهایی فروش عادی وارد می‌شود؛ قیمت اختصاصی تنوع یا طرح جداگانه تنظیم می‌شود.</p>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="product-image-modal" tabindex="-1" aria-labelledby="product-image-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-product-image-form enctype="multipart/form-data">
            @Html.AntiForgeryToken()<input type="hidden" name="productId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-image-title">تصویر اصلی محصول</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <p data-product-image-name></p>
                <p class="text-muted">تصویر اصلی، کارت و تصویر کوچک به ترتیب تا ۱۶۰۰، ۸۰۰ و ۲۵۶ پیکسل ساخته می‌شوند. تصاویر قبلی گالری حفظ می‌شوند.</p>
                <label for="product-image-file" class="form-label">انتخاب تصویر، حداکثر ۱۰ مگابایت</label>
                <input id="product-image-file" name="image" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required />
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>بارگذاری تصویر</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="product-file-modal" tabindex="-1" aria-labelledby="product-file-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-product-file-form enctype="multipart/form-data">
            @Html.AntiForgeryToken()<input type="hidden" name="productId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-file-title">فایل محصول</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <p data-product-file-name></p>
                <label for="product-file-kind" class="form-label">نوع فایل</label>
                <select id="product-file-kind" name="kind" class="form-select mb-3"><option value="product-document">فایل PDF</option><option value="product-video">ویدئوی MP4</option></select>
                <label for="product-file-description" class="form-label">عنوان فایل PDF</label>
                <input id="product-file-description" name="title" class="form-control mb-3" maxlength="200" />
                <label for="product-file-input" class="form-label">فایل PDF تا ۱۰ یا ویدئو تا ۵۰ مگابایت</label>
                <input id="product-file-input" name="file" type="file" accept="application/pdf,video/mp4" class="form-control" required />
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>بارگذاری و اتصال</button></div>
        </form></div>
    </div>
}
@if (catalogSection == "payment-institutions" && User.IsInRole("system.full-access"))
{
    <div class="modal fade" id="payment-institution-image-modal" tabindex="-1" aria-labelledby="payment-institution-image-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-payment-institution-image-form enctype="multipart/form-data">
            @Html.AntiForgeryToken()<input type="hidden" name="paymentInstitutionCode" /><input type="hidden" name="kind" value="payment" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="payment-institution-image-title">لوگوی درگاه</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body"><p data-payment-institution-name></p><label for="payment-institution-image-file" class="form-label">لوگوی PNG یا SVG، حداکثر ۱۰ مگابایت</label><input id="payment-institution-image-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/svg+xml" class="form-control" required /></div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">بارگذاری لوگو</button></div>
        </form></div>
    </div>
}
@if (catalogSection == "categories")
{
    @if (User.IsInRole("system.full-access"))
    {
        <div class="modal fade" id="category-editor-modal" tabindex="-1" aria-labelledby="category-editor-title" aria-hidden="true">
            <div class="modal-dialog"><form class="modal-content" data-category-editor>
                @Html.AntiForgeryToken()<input type="hidden" name="originalKey" />
                <div class="modal-header"><h2 class="modal-title fs-5" id="category-editor-title">مدیریت دسته</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
                <div class="modal-body">
                    <label class="form-label" for="category-key">شناسهٔ لاتین</label><input class="form-control mb-3" id="category-key" name="key" maxlength="150" pattern="[a-z0-9]+(-[a-z0-9]+)*" required />
                    <label class="form-label" for="category-name-fa">نام فارسی</label><input class="form-control mb-3" id="category-name-fa" name="nameFa" maxlength="200" required />
                    <label class="form-label" for="category-name-en">نام لاتین</label><input class="form-control mb-3" id="category-name-en" name="nameEn" maxlength="200" required />
                    <label class="form-label" for="category-parent">دستهٔ والد</label><select class="form-select" id="category-parent" name="parentId"></select>
                    <p class="text-muted mt-2">والد دسته پس از ساخت تغییر نمی‌کند. برای دستهٔ دارای کالای منتشرشده نمی‌توان زیردسته ساخت.</p>
                </div><div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
            </form></div>
        </div>
    }
    <div class="modal fade" id="category-content-modal" tabindex="-1" aria-labelledby="category-content-title" aria-hidden="true">
        <div class="modal-dialog modal-lg"><form class="modal-content" data-category-content-form>
            @Html.AntiForgeryToken()<input type="hidden" name="key" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="category-content-title">محتوای مشترک دسته</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <p data-category-content-name></p>
                <p class="text-muted">این محتوا فقط برای کالاهای متصل به همین دسته نمایش داده می‌شود و به زیردسته‌ها منتقل نمی‌شود.</p>
                <label for="category-intro" class="form-label">معرفی</label><textarea id="category-intro" name="intro" class="form-control mb-3" rows="4" maxlength="10000"></textarea>
                <label for="category-highlights" class="form-label">نکات برجسته، هر مورد در یک خط</label><textarea id="category-highlights" name="highlights" class="form-control mb-3" rows="4"></textarea>
                <label for="category-specs" class="form-label">مشخصات عمومی، هر خط به شکل «عنوان | مقدار»</label><textarea id="category-specs" name="specs" class="form-control" rows="5"></textarea>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
        </form></div>
    </div>
}
@if (catalogSection == "brands" && User.IsInRole("system.full-access"))
{
    <div class="modal fade" id="brand-editor-modal" tabindex="-1" aria-labelledby="brand-editor-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-brand-editor>
            @Html.AntiForgeryToken()<input type="hidden" name="originalKey" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="brand-editor-title">مدیریت برند</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <label for="brand-key" class="form-label">شناسهٔ لاتین</label><input id="brand-key" name="key" class="form-control mb-3" maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" required />
                <label for="brand-name-fa" class="form-label">نام فارسی</label><input id="brand-name-fa" name="nameFa" class="form-control mb-3" maxlength="200" required />
                <label for="brand-name-en" class="form-label">نام لاتین</label><input id="brand-name-en" name="nameEn" class="form-control mb-3" maxlength="200" required />
                <label for="brand-country" class="form-label">کشور</label><select id="brand-country" name="countryCode" class="form-select"></select>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="brand-image-modal" tabindex="-1" aria-labelledby="brand-image-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-brand-image-form enctype="multipart/form-data">
            @Html.AntiForgeryToken()<input type="hidden" name="brandKey" /><input type="hidden" name="kind" value="brand" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="brand-image-title">نشان برند</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body"><p data-brand-image-name></p><label for="brand-image-file" class="form-label">تصویر JPEG، PNG یا WebP، حداکثر ۱۰ مگابایت</label><input id="brand-image-file" name="file" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" required /></div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-cloud-arrow-up me-1" aria-hidden="true"></i>بارگذاری نشان</button></div>
        </form></div>
    </div>
}
@if (catalogSection == "attributes" && User.IsInRole("system.full-access"))
{
    <div class="modal fade" id="attribute-editor-modal" tabindex="-1" aria-labelledby="attribute-editor-title" aria-hidden="true">
        <div class="modal-dialog"><form class="modal-content" data-attribute-editor>
            @Html.AntiForgeryToken()<input type="hidden" name="originalKey" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="attribute-editor-title">مدیریت ویژگی</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body">
                <label for="attribute-key" class="form-label">کلید لاتین</label><input id="attribute-key" name="key" class="form-control mb-3" maxlength="100" pattern="[A-Za-z][A-Za-z0-9]*(-[A-Za-z0-9]+)*" required />
                <label for="attribute-label" class="form-label">عنوان</label><input id="attribute-label" name="label" class="form-control mb-3" maxlength="200" required />
                <label for="attribute-icon" class="form-label">کلاس آیکن (اختیاری)</label><input id="attribute-icon" name="icon" class="form-control mb-3" maxlength="100" pattern="[a-z0-9-]*" />
                <label for="attribute-source" class="form-label">کلید منبع (اختیاری)</label><input id="attribute-source" name="sourceKey" class="form-control mb-3" maxlength="100" pattern="[A-Za-z][A-Za-z0-9_:-]*" />
                <label for="attribute-filter" class="form-label">کلید فیلتر (برای ویژگی قابل‌فیلتر اجباری)</label><input id="attribute-filter" name="filterKey" class="form-control mb-3" maxlength="100" pattern="[A-Za-z][A-Za-z0-9_-]*" />
                <div class="form-check mb-2"><input id="attribute-filterable" name="isFilterable" type="checkbox" class="form-check-input" /><label for="attribute-filterable" class="form-check-label">نمایش در فیلتر کاتالوگ</label></div>
                <div class="form-check"><input id="attribute-highlight" name="isHighlight" type="checkbox" class="form-check-input" /><label for="attribute-highlight" class="form-check-label">نمایش برجسته در کارت</label></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-floppy-disk me-1" aria-hidden="true"></i>ذخیره</button></div>
        </form></div>
    </div>
}
