@{
    string catalogSection = (string)ViewData["Section"]!;
    string apiUrl = (string)ViewData["ApiUrl"]!;
}
<div class="admin-page" data-admin-page="catalog" data-admin-section="@catalogSection" data-admin-api="@apiUrl" data-can-upload-image="@(User.IsInRole("system.full-access") ? "true" : "false")" data-can-edit-category="@(User.IsInRole("system.full-access") || (User.HasClaim("admin_permission", "Store:StoreCategoryContentApi:Get") && User.HasClaim("admin_permission", "Store:StoreCategoryContentApi:Update")) ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", ((string)ViewData["Title"]!, (string)ViewData["Description"]!))
    @if (catalogSection == "attributes" && (User.IsInRole("system.full-access") || User.HasClaim("admin_permission", "Store:Catalog:Attributes")))
    {
        <section class="panel panel-inverse mb-3" data-catalog-feature-manager>
            <div class="panel-heading"><h2 class="panel-title">مرجع ویژگی‌های کالا</h2><button class="btn btn-xs btn-icon btn-default" type="button" data-feature-manager-refresh aria-label="بارگذاری دوبارهٔ مرجع ویژگی‌ها"><i class="fa fa-rotate" aria-hidden="true"></i></button></div>
            <div class="panel-body">
                @Html.AntiForgeryToken()
                <p class="text-muted">نام و مقدار ویژگی‌ها در یک مرجع نگهداری می‌شوند؛ سپس در دسته‌ها تخصیص می‌یابند و ویژگی‌های دستهٔ والد به زیر‌دسته ارث می‌رسد.</p>
                <div class="small text-muted mb-3" data-feature-manager-status role="status" aria-live="polite">در حال دریافت مرجع ویژگی‌ها…</div>
                <div class="row g-3">
                    @foreach (var kind in new[] { (Id: 1, Title: "تنوع قیمتی"), (Id: 2, Title: "ویژگی نمایشی و جست‌وجو") })
                    {
                        <div class="col-lg-6"><section class="border rounded p-3 h-100" data-reference-feature-kind="@kind.Id">
                            <h3 class="h5">@kind.Title</h3>
                            <div class="d-grid gap-2 mb-3" data-reference-feature-list="@kind.Id"></div>
                            <form class="row g-2 align-items-end" data-reference-feature-create>
                                <input type="hidden" name="kind" value="@kind.Id" />
                                <div class="col"><label class="form-label" for="reference-feature-name-@kind.Id">نام ویژگی جدید</label><input id="reference-feature-name-@kind.Id" name="name" class="form-control" maxlength="200" required /></div>
                                <div class="col-auto"><button class="btn btn-outline-primary" type="submit">افزودن ویژگی</button></div>
                            </form>
                        </section></div>
                    }
                </div>
            </div>
        </section>
    }
    @if (catalogSection == "products" && User.IsInRole("system.full-access"))
    {
        <div class="nav nav-pills gap-2 mb-3" role="group" aria-label="بخش‌های کالا">
            <button class="nav-link active" type="button" data-product-section-switch="products" aria-controls="published-products-section" aria-pressed="true">محصولات</button>
            <button class="nav-link" type="button" data-product-section-switch="drafts" aria-controls="product-drafts-section" aria-pressed="false">پیش‌نویس‌های کالا</button>
        </div>
    }
    <section class="panel panel-inverse" id="published-products-section" data-product-section="products">
        <div class="panel-heading">
            <h2 class="panel-title">@ViewData["Title"]</h2>
            <div class="panel-heading-btn d-flex align-items-center gap-2">
                @if (catalogSection == "products" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-product-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن کالا</button>
                }
                @if (catalogSection == "categories" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-category-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن دسته</button>
                }
                @if (catalogSection == "brands" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-brand-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن برند</button>
                }
                @if (catalogSection == "attributes" && User.IsInRole("system.full-access"))
                {
                    <button class="btn btn-xs btn-primary" type="button" data-attribute-create><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن ویژگی</button>
                }
                <button class="btn btn-xs btn-icon btn-default" type="button" data-admin-refresh aria-label="بارگذاری دوباره" title="بارگذاری دوبارهٔ فهرست">
                    <i class="fa fa-rotate" aria-hidden="true"></i>
                </button>
                @if (catalogSection == "products")
                {
                    <button class="btn btn-xs btn-icon btn-default" type="button" data-admin-panel-collapse aria-controls="published-products-body" aria-expanded="true" aria-label="جمع‌کردن پنل" title="جمع‌کردن پنل"><i class="fa fa-minus" aria-hidden="true"></i></button>
                }
            </div>
        </div>
        <div class="panel-body" id="published-products-body">
            <form class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3" data-admin-filter>
                <label class="visually-hidden" for="catalog-search">جست‌وجوی کاتالوگ</label>
                <input id="catalog-search" class="form-control" type="search" name="q" placeholder="جست‌وجو در @ViewData["Title"]" autocomplete="off"/>
                <button class="btn btn-primary" type="submit"><i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>جست‌وجو</button>
                @if (catalogSection == "categories")
                {
                    <button class="btn btn-default" type="button" data-category-tree-expand>بازکردن همه</button>
                    <button class="btn btn-default" type="button" data-category-tree-collapse>بستن همه</button>
                }
                @if (catalogSection == "attributes")
                {
                    <button class="btn btn-default" type="button" data-attribute-tree-expand>بازکردن همه</button>
                    <button class="btn btn-default" type="button" data-attribute-tree-collapse>بستن همه</button>
                }
                <span class="admin-record-count ms-auto small text-muted" data-admin-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite">در حال خواندن داده از دیتابیس…</div>
            @if (catalogSection == "categories")
            {
                <div class="admin-category-tree-wrap admin-permission-tree" data-admin-results role="tree" aria-label="درخت دسته‌بندی‌ها"></div>
            }
            else
            {
            <div class="table-responsive admin-table-wrap @(catalogSection == "attributes" ? "admin-category-tree-wrap" : "")">
                <table class="table table-striped table-hover align-middle mb-0" data-admin-datatable data-admin-table-mode="@((catalogSection is "categories" or "attributes") ? "tree" : "server")">
                    <thead>
                    <tr>
                        @if (catalogSection == "products")
                        {
                            <th scope="col">کد</th>
                            <th scope="col">نام کالا</th>
                            <th scope="col">برند</th>
                            <th scope="col">دسته‌بندی</th>
                            <th scope="col">عملیات</th>
                        }
                        else if (catalogSection == "categories")
                        {
                            <th scope="col">شناسه</th>
                            <th scope="col">دسته‌بندی</th>
                            <th scope="col">نام لاتین</th>
                            <th scope="col">والد</th>
                            <th scope="col">نشانی</th>
                            <th scope="col">وضعیت انتشار</th>
                            <th scope="col">عملیات</th>
                        }
                        else if (catalogSection == "brands")
                        {
                            <th scope="col">شناسه</th>
                            <th scope="col">برند</th>
                            <th scope="col">نام لاتین</th>
                            <th scope="col">کشور</th>
                            <th scope="col">وضعیت انتشار</th>
                            <th scope="col">نمایش در فروشگاه</th>
                            <th scope="col">عملیات</th>
                        }
                        else if (catalogSection == "payment-institutions")
                        {
                            <th scope="col">نام درگاه</th>
                            <th scope="col">شناسه</th>
                            <th scope="col">لوگو</th>
                            <th scope="col">مسیر فایل</th>
                            <th scope="col">عملیات</th>
                        }
                        else
                        {
                            <th scope="col">کلید</th>
                            <th scope="col">ویژگی</th>
                            <th scope="col">منبع</th>
                            <th scope="col">کلید فیلتر</th>
                            <th scope="col">قابل فیلتر</th>
                            <th scope="col">نمایش برجسته</th>
                            <th scope="col">وضعیت انتشار</th>
                            <th scope="col">عملیات</th>
                        }
                    </tr>
                    </thead>
                    <tbody data-admin-results></tbody>
                </table>
            </div>
            }
            <div class="admin-empty-state d-none p-4 text-center text-muted small" data-admin-empty>موردی برای نمایش پیدا نشد.</div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3" data-admin-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="-1">قبلی</button>
                <span data-admin-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="1">بعدی</button>
            </div>
            <p class="admin-readonly-note alert alert-info small d-flex align-items-start gap-2 mt-3"><i class="fa fa-circle-info" aria-hidden="true"></i> @(catalogSection == "categories" ? "محتوای مشترک محصول در دسته قابل ویرایش است." : catalogSection == "products" ? "مدیر دارای دسترسی کامل می‌تواند تصویر، ویدئو و فایل کالا را بارگذاری کند." : catalogSection == "brands" ? "مدیر دارای دسترسی کامل می‌تواند برند را ایجاد یا ویرایش و نشان آن را بارگذاری کند." : catalogSection == "payment-institutions" ? "تصویرها به WebP و فایل SVG پس از پاک‌سازی ذخیره می‌شود؛ فایل در FTP قرار می‌گیرد و مسیر آن در جدول ثبت می‌شود." : "مدیر دارای دسترسی کامل می‌تواند ویژگی را ایجاد و ویرایش کند؛ کلید ویژگی پس از استفاده ثابت می‌ماند.")</p>
        </div>
    </section>
    </div>
@if (catalogSection == "products" && User.IsInRole("system.full-access"))
{
    <section class="panel panel-inverse" id="product-drafts-section" data-product-section="drafts" data-admin-page="product-drafts" data-admin-section="products" data-can-upload-image="true" hidden>
        <div class="panel-heading"><h2 class="panel-title">پیش‌نویس‌های کالا</h2><div class="panel-heading-btn"><button class="btn btn-xs btn-icon btn-default" type="button" data-admin-panel-collapse aria-controls="product-drafts-body" aria-expanded="true" aria-label="جمع‌کردن پنل" title="جمع‌کردن پنل"><i class="fa fa-minus" aria-hidden="true"></i></button></div></div>
        <div class="panel-body" id="product-drafts-body"><p>پیش‌نویس پس از ثبت تصویر و انتشار در فروشگاه نمایش داده می‌شود.</p>
            <form class="admin-filter-bar d-flex flex-wrap align-items-center gap-2 mb-3" data-admin-filter>
                <label class="visually-hidden" for="product-drafts-search">جست‌وجوی پیش‌نویس‌ها</label>
                <input id="product-drafts-search" class="form-control" type="search" name="q" maxlength="100" placeholder="نام، کد، برند یا دستهٔ کالا" autocomplete="off" />
                <button class="btn btn-primary" type="submit"><i class="fa fa-magnifying-glass me-1" aria-hidden="true"></i>جست‌وجو</button>
                <button class="btn btn-default" type="button" data-admin-reset-filter>پاک‌کردن</button>
                <span class="admin-record-count ms-auto small text-muted" data-admin-count aria-live="polite"></span>
            </form>
            <div class="admin-data-status small text-muted" data-admin-status role="status" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table table-striped align-middle"
                       data-admin-datatable data-admin-table-mode="server">
                    <thead>
                    <tr>
                        <th>کد</th>
                        <th>نام</th>
                        <th>برند</th>
                        <th>دسته</th>
                        <th>قیمت تومان</th>
                        <th>تصویر</th>
                        <th>عملیات</th>
                    </tr>
                    </thead>
                    <tbody data-admin-results></tbody>
                </table>
            </div>
            <div class="admin-empty-state d-none p-4 text-center text-muted small" data-admin-empty>پیش‌نویسی وجود ندارد.</div>
            <div class="admin-pagination d-flex align-items-center justify-content-center gap-3 mt-3" data-admin-pagination hidden>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="-1">قبلی</button>
                <span data-admin-page-label></span>
                <button type="button" class="btn btn-default btn-sm" data-admin-page-step="1">بعدی</button>
            </div>
        </div>
    </section>
    <div class="modal fade" id="product-create-modal" tabindex="-1" aria-labelledby="product-create-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content" data-product-create-form data-admin-confirm="پیش‌نویس کالا با اطلاعات واردشده ساخته شود؟">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-create-title">افزودن پیش‌نویس کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body admin-modal-grid-two admin-product-editor-grid">
                <div class="admin-modal-field admin-modal-field-wide"><label class="form-label" for="new-product-key">کد کالا (اختیاری)</label><input class="form-control" id="new-product-key" name="key" maxlength="100" dir="ltr" /><small class="text-muted">در صورت خالی‌بودن، شناسهٔ کالا به‌عنوان کد ثبت می‌شود.</small></div>
                <div class="admin-modal-field admin-product-name"><label class="form-label" for="new-product-name">نام فارسی</label><input class="form-control" id="new-product-name" name="name" maxlength="300" required /></div>
                <div class="admin-modal-field admin-product-english"><label class="form-label" for="new-product-english">نام لاتین</label><input class="form-control" id="new-product-english" name="englishName" dir="ltr" maxlength="300" required /></div>
                <div class="admin-modal-field admin-product-unit"><label class="form-label" for="new-product-unit">واحد پایه</label><select class="form-select" id="new-product-unit" name="unitId" required></select></div>
                <fieldset class="admin-modal-field-wide border rounded p-3">
                    <legend class="float-none w-auto px-1 fs-6 fw-semibold">واحدهای تبدیل کالا</legend>
                    <p class="small text-muted">واحدهای تعریف‌شده را اضافه کنید و ضریب هرکدام را نسبت به واحد پایه وارد کنید.</p>
                    <div class="d-grid gap-2" data-product-create-unit-conversions></div>
                    <button class="btn btn-default btn-sm mt-2" type="button" data-add-unit-conversion="create"><i class="fa fa-plus me-1" aria-hidden="true"></i>افزودن واحد تبدیل</button>
                </fieldset>
                <div class="admin-modal-field admin-product-category"><label class="form-label" for="new-product-category">دستهٔ برگ</label><select class="form-select" id="new-product-category" name="categoryId" required></select></div>
                <div class="admin-modal-field admin-product-brand"><label class="form-label" for="new-product-brand">برند</label><select class="form-select" id="new-product-brand" name="brandId" required></select></div>
                <div class="admin-modal-field admin-product-price"><label class="form-label" for="new-product-price">قیمت فروش عادی (تومان)</label><input class="form-control" id="new-product-price" name="priceAmount" type="text" inputmode="numeric" dir="ltr" data-admin-price max="9007199254740991" required /></div>
                <div class="admin-modal-field admin-product-discount"><label class="form-label" for="new-product-discount">درصد تخفیف نمایشی</label><input class="form-control" id="new-product-discount" name="discountPercent" type="number" min="0" max="99.99" step="0.01" value="0" required /></div>
                <div class="admin-modal-field admin-product-limit"><label class="form-label" for="new-product-limit">حداکثر تعداد خرید</label><input class="form-control" id="new-product-limit" name="maxPurchaseQuantity" type="number" min="1" max="99" step="1" value="99" required /></div>
            </div><div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary"><i class="fa fa-file-circle-plus me-1" aria-hidden="true"></i>ساخت پیش‌نویس</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="product-features-modal" tabindex="-1" aria-labelledby="product-features-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable"><form class="modal-content" data-product-features-form>
            @Html.AntiForgeryToken()<input type="hidden" name="productId" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-features-title">ویژگی‌های نمایشی کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body"><p data-product-features-name></p><p class="text-muted">ویژگی‌های دسته و والدهای آن در اینجا قابل انتخاب‌اند.</p><p data-product-features-status role="status"></p><div data-product-features-choices></div></div>
            <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary" disabled>ذخیرهٔ ویژگی‌ها</button></div>
        </form></div>
    </div>
    <div class="modal fade" id="product-accessories-modal" tabindex="-1" aria-labelledby="product-accessories-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content" data-product-accessories-manager>
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-accessories-title">متعلقات کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body admin-accessory-manager">
                <div class="admin-accessory-context"><span class="admin-accessory-context-label">کالای انتخاب‌شده</span><strong data-product-accessories-name></strong><p>قیمت پایه برای فروش عادی است؛ قیمت و مجازبودن در طرح ویژه جداگانه تنظیم می‌شود.</p></div>
                <section class="admin-accessory-list" aria-labelledby="product-accessories-list-title">
                    <div class="admin-accessory-section-heading"><h3 id="product-accessories-list-title">متعلقات ثبت‌شده</h3><span data-product-accessories-status role="status" aria-live="polite"></span></div>
                    <div class="admin-accessory-items" data-product-accessories-rows></div>
                </section>
                <form class="admin-accessory-editor" data-product-accessory-form data-admin-confirm="متعلقهٔ کالا ذخیره شود؟">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" />
                    <div class="admin-accessory-section-heading"><div><h3 data-product-accessory-form-title>افزودن متعلقه</h3><p>مشخصات و تنظیمات متعلقه را وارد کنید.</p></div></div>
                    <label for="accessory-name" class="form-label">نام متعلقه</label><input id="accessory-name" class="form-control mb-2" name="name" maxlength="300" required />
                    <label for="accessory-description" class="form-label">توضیح (اختیاری)</label><textarea id="accessory-description" class="form-control mb-2" name="description" maxlength="1000"></textarea>
                    <div class="admin-product-accessory-grid mb-2">
                        <div class="admin-modal-field"><label for="accessory-price" class="form-label">قیمت پایه (تومان)</label><input id="accessory-price" class="form-control" name="priceAmount" type="text" inputmode="numeric" dir="ltr" data-admin-price max="9007199254740991" required /></div>
                        <div class="admin-modal-field"><label for="accessory-display-discount" class="form-label">درصد تخفیف نمایشی</label><input id="accessory-display-discount" class="form-control" name="displayDiscountPercent" type="number" min="0" max="99.99" step="0.01" /><small class="text-muted">فقط نمایش؛ قیمت واردشده تغییر نمی‌کند.</small></div>
                        <div class="admin-modal-field"><label for="accessory-order" class="form-label">ترتیب نمایش</label><input id="accessory-order" class="form-control" name="sortOrder" type="number" min="0" max="2147483647" step="1" value="0" required /></div>
                        <div class="admin-modal-field admin-accessory-switch"><div class="form-check"><input data-admin-switch role="switch" id="accessory-required" name="isRequired" type="checkbox" class="form-check-input" /><label for="accessory-required" class="form-check-label">متعلقه اجباری است</label></div></div>
                        <div class="admin-modal-field admin-accessory-switch"><div class="form-check"><input data-admin-switch role="switch" id="accessory-active" name="isActive" type="checkbox" class="form-check-input" checked /><label for="accessory-active" class="form-check-label">متعلقه فعال است</label></div></div>
                    </div>
                    <div class="admin-accessory-actions"><button type="submit" class="btn btn-primary">ذخیره متعلقه</button>
                    <button type="button" class="btn btn-default" data-product-accessory-reset>متعلقهٔ جدید</button></div>
                </form>
            </div>
        </div></div>
    </div>
    <div class="modal fade" id="product-editor-modal" tabindex="-1" aria-labelledby="product-editor-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content" data-product-editor data-admin-confirm="تغییرات اطلاعات کالا ثبت شود؟">
            @Html.AntiForgeryToken()<input type="hidden" name="id" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="product-editor-title">ویرایش اطلاعات کالا</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button></div>
            <div class="modal-body admin-modal-grid-two admin-product-editor-grid">
                <div class="admin-modal-field admin-modal-field-wide"><label for="product-edit-key" class="form-label">کد کالا</label><input id="product-edit-key" name="key" class="form-control" maxlength="100" dir="ltr" required /></div>
