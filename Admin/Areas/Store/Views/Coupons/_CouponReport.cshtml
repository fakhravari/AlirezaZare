@model Shop.Admin.Areas.Store.Controllers.CouponReportModel
<div id="coupon-report-content" data-coupon-report-code="@Model.Code">
<p>تعداد مصرف: @Model.Uses از @Model.UsageLimit · ظرفیت باقی‌مانده: @Math.Max(0, Model.UsageLimit - Model.Uses)</p>
<p>جمع پیش از کوپن: @Model.Subtotal.ToString("N0") تومان · تخفیف کوپن: @Model.Discount.ToString("N0") تومان · مبلغ سفارش‌ها: @Model.Total.ToString("N0") تومان</p>
<p class="small text-muted">این گزارش همهٔ وضعیت‌های سفارش را شامل می‌شود و معادل فروش پرداخت‌شده نیست. زمان‌ها به وقت تهران هستند.</p>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>شماره سفارش</th><th>مشتری</th><th>وضعیت سفارش</th><th>زمان ثبت (تهران)</th><th>پیش از کوپن (تومان)</th><th>تخفیف (تومان)</th><th>مبلغ سفارش (تومان)</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td><bdi dir="ltr">@order.OrderNumber</bdi></td>
                <td>@order.Customer</td>
                <td>@order.Status</td>
                <td><time data-admin-date datetime="@(order.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture))Z" dir="ltr">@order.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</time></td>
                <td>@order.Subtotal.ToString("N0")</td>
                <td>@order.Discount.ToString("N0")</td>
                <td>@order.Total.ToString("N0")</td>
            </tr>
        }
        @if (Model.Orders.Count == 0)
        {
            <tr><td colspan="7">مصرفی در این صفحه ثبت نشده است.</td></tr>
        }
        </tbody>
    </table>
</div>
<nav aria-label="صفحه‌بندی گزارش" class="d-flex align-items-center gap-3">
    @if (Model.Page > 1)
    {
        <button type="button" class="btn btn-sm btn-default" data-coupon-report-page="@Url.Action("Report", new { id = Model.Id, page = Model.Page - 1 })">صفحهٔ قبل</button>
    }
    <span>صفحهٔ @Model.Page</span>
    @if ((long)Model.Page * 25 < Model.Uses)
    {
        <button type="button" class="btn btn-sm btn-default" data-coupon-report-page="@Url.Action("Report", new { id = Model.Id, page = Model.Page + 1 })">صفحهٔ بعد</button>
    }
</nav>
</div>
