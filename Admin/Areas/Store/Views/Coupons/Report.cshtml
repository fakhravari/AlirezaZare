@model Shop.Admin.Areas.Store.Controllers.CouponReportModel

<div class="admin-page">
    @await Html.PartialAsync("_AdminPageIntro", ("گزارش مصرف کد تخفیف", "سفارش‌هایی که از این کد استفاده کرده‌اند."))
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">گزارش <bdi dir="ltr">@Model.Code</bdi></h2></div>
        <div class="panel-body">
            @await Html.PartialAsync("_CouponReport", Model)
            <a asp-action="Index" class="btn btn-default mt-3">بازگشت به کدها</a>
        </div>
    </section>
</div>
