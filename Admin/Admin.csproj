<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shop.Admin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>AlirezaZare-Shop-Admin-Local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Data\Data.csproj" />
    <PackageReference Include="FluentFTP" Version="48.0.3" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the supplied demo library in source control without putting every demo/plugin in the app asset manifest. -->
    <Content Remove="wwwroot/color_admin/pages/**/*" />
    <Content Remove="wwwroot/color_admin/assets/plugins/**/*" />
    <Content Remove="wwwroot/color_admin/assets/data/**/*" />
    <Content Remove="wwwroot/color_admin/assets/demo/**/*" />
    <!-- Summernote is used by the shared RTL content editor in admin forms. -->
    <Content Include="wwwroot/color_admin/assets/plugins/summernote/dist/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- DataTables is required by the shared admin table renderer. -->
    <Content Include="wwwroot/color_admin/assets/plugins/datatables.net/js/dataTables.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/color_admin/assets/plugins/datatables.net-bs5/js/dataTables.bootstrap5.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/color_admin/assets/plugins/datatables.net-bs5/css/dataTables.bootstrap5.min.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/color_admin/assets/plugins/select2/dist/css/select2.min.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/color_admin/assets/plugins/select2/dist/js/select2.min.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/color_admin/assets/plugins/select2/dist/js/i18n/fa.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\content\brands\" />
    <Folder Include="wwwroot\content\countries\flags\" />
    <Folder Include="wwwroot\content\identity\" />
    <Folder Include="wwwroot\content\payments\" />
    <Folder Include="wwwroot\content\products\files\" />
    <Folder Include="wwwroot\content\products\images\card\" />
    <Folder Include="wwwroot\content\products\images\main\" />
    <Folder Include="wwwroot\content\products\images\thumbnail\" />
    <Folder Include="wwwroot\content\products\videos\" />
  </ItemGroup>
</Project>
