k-list","id":"productQuestionList"},["ARTICLE",{"class":"product-feedback-card"},["DIV",{"class":"product-feedback-meta"},["IMG",{"__playwright_current_src__":"","class":"product-feedback-avatar","src":"shop/images/guest-avatar.svg","alt":"","loading":"lazy"}],["STRONG",{"title":"کاربر مهمان"},"کاربر مهمان"],["SPAN",{},"نمونه"],["SPAN",{"class":"product-feedback-meta-details"}]],["P",{"class":"product-question-user-text"},"برای سوراخ‌کاری مصالح چه نکته‌ای مهم است؟"],["ASIDE",{"class":"product-feedback-admin-reply"},["DIV",{"class":"product-feedback-admin-meta"},["SPAN",{},["I",{"class":"bi bi-patch-check-fill","aria-hidden":"true"}],"پاسخ نمونه"]],["P",{},"از متهٔ مناسب مصالح استفاده کنید و حالت چکشی و سرعت را مطابق راهنمای دستگاه تنظیم کنید.\n\nحالت چکشی را فقط برای مصالح مناسب فعال کنید و هنگام کار از عینک محافظ و فشار یکنواخت استفاده کنید."]]],["ARTICLE",{"class":"product-feedback-card"},["DIV",{"class":"product-feedback-meta"},["IMG",{"__playwright_current_src__":"","class":"product-feedback-avatar","src":"shop/images/guest-avatar.svg","alt":"","loading":"lazy"}],["STRONG",{"title":"کاربر مهمان"},"کاربر مهمان"],["SPAN",{},"نمونه"],["SPAN",{"class":"product-feedback-meta-details"}]],["P",{"class":"product-question-user-text"},"باتری و شارژر داخل بسته هستند؟"],["ASIDE",{"class":"product-feedback-admin-reply"},["DIV",{"class":"product-feedback-admin-meta"},["SPAN",{},["I",{"class":"bi bi-patch-check-fill","aria-hidden":"true"}],"پاسخ نمونه"]],["P",{},"اقلام همراه را در بخش مشخصات و فهرست محتویات بستهٔ همین کالا ببینید.\n\nمحتویات بسته ممکن است بین نسخه‌های مختلف تفاوت داشته باشد؛ فهرست اقلام همین محصول را پیش از ثبت سفارش بررسی کنید."]]],["ARTICLE",{"class":"product-feedback-card"},["DIV",{"class":"product-feedback-meta"},["IMG",{"__playwright_current_src__":"","class":"product-feedback-avatar","src":"shop/images/guest-avatar.svg","alt":"","loading":"lazy"}],["STRONG",{"title":"کاربر مهمان"},"کاربر مهمان"],["SPAN",{},"نمونه"],["SPAN",{"class":"product-feedback-meta-details"}]],["P",{"class":"product-question-user-text"},"چه مته‌ای برای این دریل مناسب است؟"],["ASIDE",{"class":"product-feedback-admin-reply"},["DIV",{"class":"product-feedback-admin-meta"},["SPAN",{},["I",{"class":"bi bi-patch-check-fill","aria-hidden":"true"}],"پاسخ نمونه"]],["P",{},"مته را با جنس سطح و قطر سوراخ انتخاب کنید و سازگاری آن با سه‌نظام دستگاه را بررسی کنید.\n\nبرای چوب، فلز یا مصالح از متهٔ مخصوص همان سطح استفاده کنید و قطر قابل پشتیبانی سه‌نظام را در مشخصات مدل ببینید."]]]],[[2,1756]]]]],[[2,1917]]],[[2,1919]]],[[2,1921]]],[[2,1923]],[[2,2014]],[[2,2015]]],[[2,2017]],[[2,2154]],[[2,2155]],[[2,2639]],[[2,2640]],[[2,2815]],[[2,2816]],[[2,2901]],[[2,2902]],[[2,2910]],[[2,2911]],[[2,2915]],[[2,2916]],[[2,2917]],[[2,2918]],[[2,2919]],[[2,2920]],[[2,2921]],[[2,2922]],[[2,2923]],[[2,2924]],[[2,2925]],[[2,2926]],[[2,2927]],[[2,2928]],[[2,2929]],[[2,2930]],[[2,2931]],[[2,2932]],[[2,2933]],[[2,2934]],[[2,2945]],[[2,2946]],[[2,2947]],[[2,2948]],[[2,2963]],[[1,28]],[[2,3045]],[[2,3081]],[[2,3117]],[[2,3192]],[[2,3265]]]],"viewport":{"width":320,"height":800},"timestamp":94904.499,"wallTime":1794310187095,"collectionTime":11,"resourceOverrides":[],"isMainFrame":true}}
