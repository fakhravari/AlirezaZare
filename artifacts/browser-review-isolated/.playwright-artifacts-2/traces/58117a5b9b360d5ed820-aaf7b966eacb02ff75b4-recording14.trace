   transform: none;\n      }\n      .search-cart-head {\n        display: flex;\n        min-height: 82px;\n        padding: 0 20px;\n        align-items: center;\n        justify-content: space-between;\n        background: linear-gradient(\n          135deg,\n          var(--color-blue),\n          var(--color-navy)\n        );\n        color: #fff;\n      }\n      .search-cart-head span {\n        display: flex;\n        flex-direction: column;\n      }\n      .search-cart-head small {\n        margin-top: 3px;\n        color: rgba(255, 255, 255, 0.6);\n        font-size: 10px;\n      }\n      .search-cart-head button {\n        width: 38px;\n        height: 38px;\n        border: 1px solid rgba(255, 255, 255, 0.18);\n        border-radius: 50%;\n        background: rgba(255, 255, 255, 0.08);\n        color: #fff;\n      }\n      .search-cart-items {\n        max-height: calc(100dvh - 190px);\n        padding: 12px;\n        overflow: auto;\n      }\n      .search-cart-item {\n        display: grid;\n        padding: 10px;\n        grid-template-columns: 62px 1fr auto;\n        gap: 11px;\n        align-items: center;\n        border-bottom: 1px solid #ded4c6;\n      }\n      .search-cart-item img {\n        width: 62px;\n        height: 68px;\n        border-radius: 9px;\n        object-fit: cover;\n      }\n      .search-cart-item span {\n        display: flex;\n        flex-direction: column;\n      }\n      .search-cart-item strong {\n        font-size: 12px;\n      }\n      .search-cart-item small {\n        margin-top: 5px;\n        color: #926a35;\n        font-size: 10px;\n      }\n      .search-cart-item > b {\n        font-size: 10px;\n      }\n      .search-cart-empty {\n        display: flex;\n        min-height: 270px;\n        align-items: center;\n        justify-content: center;\n        flex-direction: column;\n        color: #788290;\n      }\n      .search-cart-empty i {\n        margin-bottom: 12px;\n        color: var(--color-blue);\n        font-size: 38px;\n      }\n      .search-cart-footer {\n        position: absolute;\n        right: 0;\n        bottom: 0;\n        left: 0;\n        padding: 16px 18px;\n        background: #f1e9dd;\n      }\n      .search-cart-footer > div {\n        display: flex;\n        margin-bottom: 12px;\n        justify-content: space-between;\n        font-size: 11px;\n      }\n      .search-cart-footer strong {\n        color: var(--color-blue);\n        font-size: 14px;\n      }\n      .search-cart-footer > button {\n        width: 100%;\n        min-height: 46px;\n        border: 0;\n        border-radius: 11px;\n        background: var(--color-blue);\n        color: #fff;\n        font-weight: 700;\n      }\n      @media (min-width: 992px) {\n        .search-cart-backdrop {\n          display: none;\n        }\n        .search-cart-drawer {\n          top: 92px;\n          bottom: auto;\n          left: 24px;\n          width: 410px;\n          height: min(560px, calc(100dvh - 116px));\n          max-height: calc(100dvh - 116px);\n          overflow: hidden;\n          border-radius: 22px;\n          opacity: 0;\n          visibility: hidden;\n          transform: translateY(12px) scale(0.985);\n          transform-origin: top left;\n          pointer-events: none;\n          transition:\n            opacity 0.24s ease,\n            visibility 0.24s ease,\n            transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n        }\n        .search-cart-drawer.open {\n          opacity: 1;\n          visibility: visible;\n          transform: none;\n          pointer-events: auto;\n        }\n        .search-cart-items {\n          max-height: calc(100% - 190px);\n        }\n      }\n    "],"\n\n\n\n\n"],"\n",["FOOTER",{},"\n    ",["DIV",{"class":"container"},"\n        ",["DIV",{"class":"row g-4 footer-main"},"\n            ",["DIV",{"class":"col-lg-4"},"\n                ",["A",{"class":"brand footer-brand","href":"/home/index#home","aria-label":"برق شیراز؛ مرجع تخصصی ابزار