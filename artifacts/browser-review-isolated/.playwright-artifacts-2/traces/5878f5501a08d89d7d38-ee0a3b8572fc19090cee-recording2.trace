{"type":"before","callId":"rynp@222","startTime":22446.952,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n    window.AdminUI = {\n      notify: () => {},\n      getJson: async () => ({\n        countries: [{\n          id: 1,\n          nameFa: 'ایران',\n          nameEn: 'Iran',\n          code: 'IR'\n        }, {\n          id: 2,\n          nameFa: 'ترکیه',\n          nameEn: 'Turkey',\n          code: 'TR'\n        }],\n        provinces: [{\n          id: 11,\n          countryId: 1,\n          nameFa: 'تهران',\n          nameEn: 'Tehran',\n          parentName: 'ایران'\n        }, {\n          id: 12,\n          countryId: 1,\n          nameFa: 'فارس',\n          nameEn: 'Fars',\n          parentName: 'ایران'\n        }, {\n          id: 21,\n          countryId: 2,\n          nameFa: 'استانبول',\n          nameEn: 'Istanbul',\n          parentName: 'ترکیه'\n        }],\n        cities: []\n      })\n    };\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
