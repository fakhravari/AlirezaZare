@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Shop.Admin.Areas.Admin.Controllers.SiteSettingsInput
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "تنظیمات سایت";
    ViewData["AreaTitle"] = "سامانهٔ مدیریت";
}
<div class="admin-page">
    @await Html.PartialAsync("_AdminPageIntro", ("تنظیمات سایت", "هویت، انبار منبع موجودی و تنظیمات ارسال ایمیل فروشگاه."))
    @if (TempData["SiteSettingsSaved"] is true) { <div class="alert alert-success" role="status">تنظیمات ذخیره شد.</div> }
    <form asp-area="Admin" asp-controller="SiteSettings" asp-action="Index" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <section class="panel panel-inverse"><div class="panel-heading"><h2 class="panel-title">هویت و ارتباط</h2></div><div class="panel-body row g-3">
            <div class="col-md-6"><label asp-for="DisplayName" class="form-label">نام نمایشی</label><input asp-for="DisplayName" class="form-control" required maxlength="160" /></div>
            <div class="col-md-6"><label asp-for="StoreName" class="form-label">نام فروشگاه</label><input asp-for="StoreName" class="form-control" required maxlength="240" /></div>
            <div class="col-md-6"><label asp-for="VisualBrandName" class="form-label">نام برند</label><input asp-for="VisualBrandName" class="form-control" required maxlength="160" /></div>
            <div class="col-md-6"><label asp-for="PublicEmail" class="form-label">ایمیل عمومی</label><input asp-for="PublicEmail" type="email" dir="ltr" class="form-control" required maxlength="254" /></div>
            <div class="col-md-4"><label asp-for="SupportPhoneDisplay" class="form-label">تلفن نمایشی</label><input asp-for="SupportPhoneDisplay" class="form-control" required maxlength="32" /></div>
            <div class="col-md-4"><label asp-for="SupportPhoneUri" class="form-label">شمارهٔ لینک تماس</label><input asp-for="SupportPhoneUri" dir="ltr" class="form-control" required maxlength="40" /></div>
            <div class="col-md-4"><label asp-for="WhatsAppNumber" class="form-label">شمارهٔ واتس‌اپ</label><input asp-for="WhatsAppNumber" dir="ltr" class="form-control" required maxlength="32" /></div>
        </div></section>
        <section class="panel panel-inverse"><div class="panel-heading"><h2 class="panel-title">موجودی فروشگاه</h2></div><div class="panel-body">
            <label asp-for="IdWarehouse" class="form-label">انبار منبع موجودی سایت</label>
            <select asp-for="IdWarehouse" asp-items="@(ViewData["Warehouses"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="form-select"><option value="">انبار انتخاب نشده</option></select>
        </div></section>
        <section class="panel panel-inverse"><div class="panel-heading"><h2 class="panel-title">ارسال ایمیل</h2></div><div class="panel-body row g-3">
            <div class="col-md-6"><label asp-for="SmtpHost" class="form-label">میزبان SMTP</label><input asp-for="SmtpHost" dir="ltr" class="form-control" required maxlength="255" /></div>
            <div class="col-md-6"><label asp-for="SmtpPort" class="form-label">درگاه</label><input asp-for="SmtpPort" type="number" min="1" max="65535" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="SmtpUsername" class="form-label">نام کاربری SMTP</label><input asp-for="SmtpUsername" dir="ltr" class="form-control" required maxlength="320" /></div>
            <div class="col-md-6"><label asp-for="SmtpFrom" class="form-label">ایمیل فرستنده</label><input asp-for="SmtpFrom" type="email" dir="ltr" class="form-control" required maxlength="320" /></div>
            <div class="col-12"><div class="form-check"><input asp-for="SmtpEnableSsl" class="form-check-input" /><label asp-for="SmtpEnableSsl" class="form-check-label">اتصال امن SSL</label></div></div>
            <p class="text-muted mb-0">رمز SMTP از تنظیمات امن سرور خوانده می‌شود.</p>
        </div></section>
        <section class="panel panel-inverse"><div class="panel-heading"><h2 class="panel-title">فضای تصاویر فروشگاه</h2></div><div class="panel-body row g-3">
            <div class="col-md-6"><label asp-for="FtpHost" class="form-label">میزبان FTP</label><input asp-for="FtpHost" dir="ltr" class="form-control" maxlength="255" /></div>
            <div class="col-md-6"><label asp-for="FtpPort" class="form-label">درگاه</label><input asp-for="FtpPort" type="number" min="1" max="65535" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="FtpUsername" class="form-label">نام کاربری</label><input asp-for="FtpUsername" dir="ltr" class="form-control" maxlength="320" /></div>
            <div class="col-md-6"><label asp-for="FtpPassword" class="form-label">رمز عبور</label><input asp-for="FtpPassword" type="password" autocomplete="new-password" dir="ltr" class="form-control" maxlength="1024" /></div>
            <p class="text-muted mb-0">ریشهٔ تصاویر /content است. برای حفظ رمز فعلی، کادر رمز را خالی بگذارید. اتصال FTP بدون رمزگذاری انجام می‌شود.</p>
        </div></section>
        <button type="submit" class="btn btn-primary">ذخیرهٔ تنظیمات</button>
    </form>
    <section class="panel panel-inverse mt-3">
        <div class="panel-heading"><h2 class="panel-title">بارگذاری رسانهٔ فروشگاه</h2></div>
        <div class="panel-body">
            <p>فایل در پوشهٔ مربوط به خود زیر content ذخیره می‌شود. برای اتصال آن به محتوا، مسیر خروجی را در بخش مربوط ثبت کنید.</p>
            <form data-media-upload-form data-public-site-url="@Configuration["PublicSiteUrl"]" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-4"><label for="media-kind" class="form-label">کاربرد</label>
                        <select id="media-kind" name="kind" class="form-select" required>
                            <option value="brand">تصویر برند</option><option value="slider">تصویر اسلایدر</option>
                            <option value="testimonial">تصویر دیدگاه</option><option value="trust">نماد اعتماد</option>
                            <option value="identity">هویت فروشگاه</option><option value="payment">نشان پرداخت</option>
                            <option value="country">تصویر کشور</option><option value="article">تصویر مقاله</option>
                        </select>
                    </div>
                    <div class="col-md-8"><label for="media-file" class="form-label">فایل</label><input id="media-file" name="file" type="file" class="form-control" required /></div>
                    <div class="col-md-4" data-media-country-container hidden><label for="media-country" class="form-label">کشور</label><select id="media-country" name="countryCode" class="form-select" disabled><option value="">کشور را انتخاب کنید</option></select></div>
                    <div class="col-md-4" data-media-article-container hidden><label for="media-article" class="form-label">مقاله</label><select id="media-article" name="articleKey" class="form-select" disabled><option value="">مقاله را انتخاب کنید</option></select><small class="text-muted">برای تصویر سربرگ و متن مقاله استفاده می‌شود.</small></div>
                    <div class="col-12"><p class="text-muted mb-0">تصاویر JPEG، PNG یا WebP تا ۱۰ مگابایت مجازند. برای تصویر، نسخهٔ کوچک نیز ساخته می‌شود. فایل و ویدئوی محصول را از فهرست کالاها بارگذاری کنید.</p></div>
                    <div class="col-12"><button type="submit" class="btn btn-primary">بارگذاری فایل</button></div>
                    <div class="col-12" data-media-upload-result role="status" aria-live="polite"></div>
                </div>
            </form>
        </div>
    </section>
</div>
