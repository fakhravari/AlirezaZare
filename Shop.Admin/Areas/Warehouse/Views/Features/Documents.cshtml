@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-documents data-api="@ViewData["ApiUrl"]" data-document-feature="@Model.FeatureId" data-can-create="@(User.HasClaim("admin_permission", "Warehouse:DocumentsApi:Create") ? "true" : "false")" data-can-edit="@(User.HasClaim("admin_permission", "Warehouse:DocumentsApi:Update") ? "true" : "false")" data-can-delete="@(User.HasClaim("admin_permission", "Warehouse:DocumentsApi:Delete") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">سندهای انبار</h2>
            <div class="panel-heading-btn">
                <button class="btn btn-primary btn-sm" type="button" data-document-create><i class="fa fa-plus me-1" aria-hidden="true"></i>ثبت سند</button>
            </div>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar" data-document-filter>
                <label class="visually-hidden" for="document-warehouse-filter">انبار</label>
                <select id="document-warehouse-filter" class="form-select" name="warehouseId" data-document-warehouses>
                    <option value="">همهٔ انبارهای مجاز</option>
                </select>
                <label class="visually-hidden" for="document-status-filter">وضعیت سند</label>
                <select id="document-status-filter" class="form-select" name="status">
                    <option value="">همهٔ وضعیت‌ها</option><option value="D">موقت</option><option value="F">قطعی</option>
                </select>
                <button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="button" data-document-reset>پاک‌کردن</button>
            </form>
            <div class="admin-data-status" data-document-status role="status" aria-live="polite">در حال بارگذاری سندها…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                    <tr>
                        <th>شماره</th><th>تاریخ</th><th>نوع سند</th><th>انبار</th><th>طرح فروش</th><th>مرجع</th><th>وضعیت</th><th>اثر بر موجودی</th>
                        <th>
                            <span class="visually-hidden">عملیات</span>
                        </th>
                    </tr>
                    </thead><tbody data-document-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination" data-document-pagination hidden>
                <button class="btn btn-default btn-sm" type="button" data-document-page="-1">قبلی</button><span data-document-page-label></span><button class="btn btn-default btn-sm" type="button" data-document-page="1">بعدی</button>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="admin-document-modal" tabindex="-1" aria-labelledby="admin-document-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <form class="modal-content" data-document-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="id"/>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="admin-document-title">ثبت سند انبار</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-type">نوع سند</label><select id="document-type" name="documentTypeId" class="form-select" required data-document-types></select>
                    </div>
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-warehouse">انبار</label><select id="document-warehouse" name="warehouseId" class="form-select" required data-document-warehouse></select>
                    </div>
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-plan">مالک کالا / طرح فروش</label><select id="document-plan" name="salesPlanId" class="form-select" required data-document-plans></select>
                    </div>
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-party">مرجع</label><select id="document-party" name="partyId" class="form-select" required data-document-parties></select>
                    </div>
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-date">تاریخ سند</label><input id="document-date" name="documentDate" class="form-control" type="date" required/>
                    </div>
                    <div class="col-md-6 col-xl-4">
                        <label class="form-label" for="document-state">وضعیت</label>
                        <select id="document-state" name="status" class="form-select">
                            <option value="D">موقت</option><option value="F">قطعی</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="document-reference" data-reference-label>شماره سفارش / مرجع بیرونی</label><input id="document-reference" name="externalReference" class="form-control" maxlength="128" data-document-reference/>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="document-reason">دلیل / توضیح</label><textarea id="document-reason" name="reason" class="form-control" maxlength="1000" rows="2" required></textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                    <h3 class="h6 mb-0">اقلام سند</h3><button class="btn btn-outline-primary btn-sm" type="button" data-document-line-add>افزودن قلم</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead>
                        <tr>
                            <th>کالا / تنوع</th><th>واحد</th><th>مقدار</th><th>ضریب تبدیل</th><th>مقدار واحد اصلی</th><th></th>
                        </tr>
                        </thead><tbody data-document-lines></tbody>
                    </table>
                </div>
                <p class="text-muted small mb-0">مقدار در واحد اصلی تا سه رقم اعشار بریده می‌شود. تغییر وضعیت موقت/قطعی و گردش موجودی در یک تراکنش ثبت می‌شوند.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">ذخیرهٔ سند</button>
            </div>
        </form>
    </div>
</div>
