@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-movements data-api="@ViewData["ApiUrl"]">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title" data-movement-title>کاردکس و گردش اسناد</h2>
            <div class="panel-heading-btn btn-group" role="group" aria-label="نوع اطلاعات گردش">
                <button type="button" class="btn btn-primary btn-sm" data-movement-mode="stock" aria-pressed="true">گردش موجودی</button><button type="button" class="btn btn-default btn-sm" data-movement-mode="summary" aria-pressed="false">خلاصهٔ گردش</button><button type="button" class="btn btn-default btn-sm" data-movement-mode="audit" aria-pressed="false">تاریخچهٔ تغییر سند</button>
            </div>
        </div>
        <div class="panel-body">
            <p>مانده و خلاصهٔ گردش بر اساس سندهای قطعی مؤثر بر موجودی، برای هر کالا، تنوع، انبار و طرح محاسبه می‌شوند.</p>
            <form class="admin-filter-bar" data-movement-filter>
                <label class="visually-hidden" for="movement-search">جست‌وجو</label><input class="form-control" id="movement-search" name="search" placeholder="کالا، نوع سند یا دلیل"/><label class="visually-hidden" for="movement-warehouse">انبار</label>
                <select class="form-select" name="warehouseId" id="movement-warehouse">
                    <option value="">همهٔ انبارهای مجاز</option>
                </select><label class="visually-hidden" for="movement-plan">طرح یا مالک کالا</label><input class="form-control" id="movement-plan" name="salesPlan" maxlength="100" placeholder="نام یا کد طرح"/><label class="visually-hidden" for="movement-from">از تاریخ</label><input class="form-control" type="date" name="from" id="movement-from"/><label class="visually-hidden" for="movement-to">تا تاریخ</label><input class="form-control" type="date" name="to" id="movement-to"/><button class="btn btn-primary" type="submit">جست‌وجو</button><button class="btn btn-default" type="reset" data-movement-reset>پاک‌کردن</button>
            </form>
            <div class="admin-data-status" data-movement-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead data-movement-head>
                    <tr>
                        <th>تاریخ</th><th>شماره</th><th>نوع سند</th><th>انبار</th><th>طرح</th><th>کالا / تنوع</th><th>مقدار سند</th><th>مقدار گردش</th><th>مانده به واحد اصلی</th><th>وضعیت</th><th>دلیل</th>
                    </tr>
                    </thead><tbody data-movement-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination" data-movement-pagination>
                <button class="btn btn-default btn-sm" type="button" data-movement-page="-1">قبلی</button><span data-movement-page-label></span><button class="btn btn-default btn-sm" type="button" data-movement-page="1">بعدی</button>
            </div>
            <p class="text-muted small mt-2">در خلاصه، ماندهٔ اول دوره پیش از تاریخ شروع و ماندهٔ پایان تا تاریخ پایان است؛ مقادیر بر حسب واحد اصلی کالا هستند. فیلتر طرح در تاریخچهٔ تغییر سند اعمال نمی‌شود.</p>
        </div>
    </section>
</div>
