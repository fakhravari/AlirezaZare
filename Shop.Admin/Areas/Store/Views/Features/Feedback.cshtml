@model Shop.Admin.Models.FeaturePageViewModel
@{
    string type = Model.FeatureId == "questions" ? "questions" : "reviews";
}
<div class="admin-page" data-admin-feedback data-api="/api/admin/store/feedback/@type" data-feedback-type="@type" data-can-moderate="@(User.HasClaim("admin_permission", type == "reviews" ? "Store:StoreFeedbackApi:ModerateReview" : "Store:StoreFeedbackApi:ModerateQuestion") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", (Model.Title, Model.Description))
    <section class="panel panel-inverse">
        <div class="panel-heading">
            <h2 class="panel-title">فهرست @(type == "reviews" ? "دیدگاه‌ها" : "پرسش‌ها")</h2>
        </div>
        <div class="panel-body">
            <form class="admin-filter-bar" data-feedback-filter>
                <label class="visually-hidden" for="feedback-search">جست‌وجو</label><input class="form-control" id="feedback-search" name="search" type="search" placeholder="نام یا کد محصول، نام کاربر یا متن"/><label class="visually-hidden" for="feedback-status">وضعیت</label>
                <select class="form-select" id="feedback-status" name="status">
                    <option value="">همهٔ وضعیت‌ها</option><option value="pending">در انتظار بررسی</option><option value="approved">تأییدشده</option><option value="rejected">ردشده</option>
                </select><button class="btn btn-primary" type="submit">اعمال فیلتر</button><button class="btn btn-default" type="reset" data-feedback-reset>پاک‌کردن</button>
            </form>
            <div class="admin-data-status" data-feedback-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                    <tr>
                        <th>تاریخ</th><th>محصول</th><th>نام نمایشی</th><th>متن</th><th>امتیاز</th><th>وضعیت</th><th>پاسخ مدیر</th><th>عملیات</th>
                    </tr>
                    </thead><tbody data-feedback-rows></tbody>
                </table>
            </div>
            <div class="admin-pagination" data-feedback-pagination>
                <button class="btn btn-default btn-sm" type="button" data-feedback-page="-1">قبلی</button><span data-feedback-page-label></span><button class="btn btn-default btn-sm" type="button" data-feedback-page="1">بعدی</button>
            </div>
        </div>
    </section>
</div>
<div class="modal fade" id="admin-feedback-modal" tabindex="-1" aria-labelledby="admin-feedback-title" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" data-feedback-form>
            @Html.AntiForgeryToken()<input type="hidden" name="id"/>
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="admin-feedback-title">بازبینی</h2><button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p data-feedback-text class="border rounded p-3 bg-light"></p><label class="form-label" for="feedback-review-status">وضعیت</label>
                <select class="form-select mb-3" name="status" id="feedback-review-status">
                    <option value="pending">در انتظار بررسی</option><option value="approved">تأییدشده</option><option value="rejected">ردشده</option>
                </select><label class="form-label" for="feedback-reply">پاسخ مدیر</label><textarea class="form-control" name="adminReply" id="feedback-reply" rows="4" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary" data-feedback-save>ذخیرهٔ بررسی</button>
            </div>
        </form>
    </div>
</div>
