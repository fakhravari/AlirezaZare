@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-admin-page="faq" data-admin-api="/api/admin/store/faq">
    @await Html.PartialAsync("_AdminPageIntro", ("پرسش‌های متداول", "مدیریت پرسش‌ها و پاسخ‌های صفحهٔ پرسش‌های متداول فروشگاه."))
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">پرسش‌های متداول</h2><div class="panel-heading-btn"><button class="btn btn-primary btn-sm" type="button" data-faq-create>افزودن پرسش</button></div></div>
        <div class="panel-body">
            <div class="admin-data-status" data-admin-status role="status" aria-live="polite">در حال دریافت پرسش‌ها…</div>
            <div class="table-responsive admin-table-wrap"><table class="table table-striped table-hover align-middle"><thead><tr><th scope="col">پرسش</th><th scope="col">ترتیب</th><th scope="col">وضعیت</th><th scope="col">عملیات</th></tr></thead><tbody data-faq-rows></tbody></table></div>
            <p>پرسش‌های منتشرنشده در سایت نمایش داده نمی‌شوند. عنوان، معرفی و بخش‌های صفحه در پنل صفحه‌های خدماتی قابل ویرایش است.</p>
        </div>
    </section>
</div>
<section class="panel panel-inverse mt-4" data-magazine-admin data-api="/api/admin/store/magazine">
    <div class="panel-heading"><h2 class="panel-title">مقاله‌های مجله</h2><div class="panel-heading-btn"><button class="btn btn-primary btn-sm" type="button" data-mag-create>افزودن مقاله</button></div></div>
    <div class="panel-body"><div class="admin-data-status" data-mag-status role="status" aria-live="polite">در حال دریافت مقاله‌ها…</div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>عنوان</th><th>نشانی</th><th>بخش‌ها</th><th>انتشار</th><th>عملیات</th></tr></thead><tbody data-mag-rows></tbody></table></div></div>
</section>
<section class="panel panel-inverse mt-4" data-service-pages data-api="/api/admin/store/content/pages">
    <div class="panel-heading"><h2 class="panel-title">صفحه‌های خدماتی</h2></div>
    <div class="panel-body">
        <div class="row g-3 mb-3"><div class="col-md-8"><label class="form-label" for="service-page-select">صفحه</label><select class="form-select" id="service-page-select" data-service-page-select><option value="">در حال دریافت صفحه‌ها…</option></select></div><div class="col-md-4 d-flex align-items-end"><span class="admin-data-status" data-service-page-status role="status" aria-live="polite"></span></div></div>
        <form data-service-page-editor hidden>
            @Html.AntiForgeryToken()
            <div class="row g-3"><div class="col-md-6"><label class="form-label" for="service-page-title">عنوان صفحه</label><input class="form-control" id="service-page-title" name="title" maxlength="300" required /></div><div class="col-md-6"><label class="form-label" for="service-page-description">شرح و توضیح بالای صفحه</label><input class="form-control" id="service-page-description" name="description" maxlength="1000" /></div>
                <div class="col-12"><div class="d-flex justify-content-between align-items-center mb-2"><span class="form-label mb-0">بخش‌های صفحه</span><button class="btn btn-default btn-sm" type="button" data-service-section-add>افزودن بخش</button></div><div class="d-grid gap-3" data-service-sections></div><small class="form-text">عنوان و متن هر بخش را ویرایش، جابه‌جایی را با ترتیب کارت‌ها انجام دهید یا بخش را حذف کنید.</small></div>
                <div class="col-12 form-check ms-2"><input class="form-check-input" id="service-page-published" name="isPublished" type="checkbox" /><label class="form-check-label" for="service-page-published">صفحه در سایت منتشر باشد</label></div>
                <div class="col-12"><button class="btn btn-primary" type="submit">ذخیرهٔ صفحه</button></div>
            </div>
        </form>
    </div>
</section>
<div class="modal fade" id="mag-editor-modal" tabindex="-1" aria-labelledby="mag-editor-title" aria-hidden="true"><div class="modal-dialog modal-xl"><form class="modal-content" data-mag-editor>@Html.AntiForgeryToken()<input type="hidden" name="id" />
<div class="modal-header"><h2 class="modal-title fs-5" id="mag-editor-title">ویرایش مقاله</h2><button class="btn-close ms-0" type="button" data-bs-dismiss="modal" aria-label="بستن"></button></div><div class="modal-body row g-3">
@foreach (var field in new[] { ("articleKey","نشانی لاتین مقاله","text"),("title","عنوان","text"),("category","دسته","text"),("summary","خلاصه","text"),("author","نویسنده","text"),("kicker","روتیتر","text"),("branch","شاخه","text"),("topic","موضوع","text"),("area","حوزه","text"),("heroImagePath","مسیر تصویر اصلی","text"),("contentImagePath","مسیر تصویر متن","text"),("readTimeMinutes","زمان مطالعه (دقیقه)","number"),("readTimeText","متن زمان مطالعه","text") }) { <div class="col-md-6"><label class="form-label" for="mag-@field.Item1">@field.Item2</label><input class="form-control" id="mag-@field.Item1" name="@field.Item1" type="@field.Item3" /></div> }
<div class="col-12"><label class="form-label" for="mag-lead">مقدمه</label><textarea class="form-control" id="mag-lead" name="lead" rows="3"></textarea></div><div class="col-12"><label class="form-label" for="mag-conclusion">جمع‌بندی</label><textarea class="form-control" id="mag-conclusion" name="conclusion" rows="3"></textarea></div><div class="col-12"><label class="form-label" for="mag-sections">بخش‌های مقاله (JSON: آرایه‌ای از heading و body)</label><textarea class="form-control" id="mag-sections" name="sections" rows="8" placeholder='[{"heading":"عنوان بخش","body":"متن بخش"}]'></textarea></div><div class="col-12 form-check ms-2"><input class="form-check-input" id="mag-published" name="isPublished" type="checkbox" /><label class="form-check-label" for="mag-published">منتشر شود</label></div>
</div><div class="modal-footer"><button class="btn btn-default" type="button" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary" type="submit">ذخیره</button></div></form></div></div>
<div class="modal fade" id="faq-editor-modal" tabindex="-1" aria-labelledby="faq-editor-title" aria-hidden="true">
    <div class="modal-dialog modal-lg"><form class="modal-content" data-faq-editor>
        @Html.AntiForgeryToken()<input type="hidden" name="id" />
        <div class="modal-header"><h2 class="modal-title fs-5" id="faq-editor-title">ویرایش پرسش متداول</h2><button class="btn-close ms-0" type="button" data-bs-dismiss="modal" aria-label="بستن"></button></div>
        <div class="modal-body">
            <label class="form-label" for="faq-question">پرسش</label><textarea id="faq-question" name="question" class="form-control mb-3" maxlength="1000" required></textarea>
            <label class="form-label" for="faq-answer">پاسخ</label><textarea id="faq-answer" name="answer" class="form-control mb-3" maxlength="10000" rows="5" required></textarea>
            <label class="form-label" for="faq-link-text">متن پیوند اختیاری</label><input id="faq-link-text" name="linkText" class="form-control mb-3" maxlength="300" />
            <label class="form-label" for="faq-link-url">مسیر داخلی پیوند، مانند /contact</label><input id="faq-link-url" name="linkUrl" class="form-control mb-3" maxlength="1000" />
            <label class="form-label" for="faq-order">ترتیب نمایش</label><input id="faq-order" name="sortOrder" type="number" min="0" max="1000000" step="1" class="form-control mb-3" required />
            <div class="form-check"><input id="faq-published" name="isPublished" class="form-check-input" type="checkbox" /><label for="faq-published" class="form-check-label">منتشر شود</label></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-default" data-bs-dismiss="modal">انصراف</button><button type="submit" class="btn btn-primary">ذخیره</button></div>
    </form></div>
</div>
