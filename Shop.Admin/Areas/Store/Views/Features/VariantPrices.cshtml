@model Shop.Admin.Models.FeaturePageViewModel
<div class="admin-page" data-store-variant-prices data-api="@ViewData["ApiUrl"]" data-can-edit="@(User.IsInRole("system.full-access") || User.HasClaim("admin_permission", "Store:Features:Index:promotions") ? "true" : "false")">
    @await Html.PartialAsync("_AdminPageIntro", ("قیمت تنوع‌ها در طرح فروش", "برای هر تنوع انبار و هر طرح، قیمت فروش مستقل تعیین کنید. در صورت حذف قیمت اختصاصی، قیمت پایهٔ همان کالا و طرح استفاده می‌شود."))
    @Html.AntiForgeryToken()
    <section class="panel panel-inverse">
        <div class="panel-heading"><h2 class="panel-title">قیمت تنوع و طرح</h2><div class="panel-heading-btn"><button type="button" class="btn btn-xs btn-icon btn-default" data-price-refresh aria-label="بارگذاری دوباره"><i class="fa fa-rotate" aria-hidden="true"></i></button></div></div>
        <div class="panel-body">
            <form class="admin-filter-bar mb-3" data-price-filter><label class="visually-hidden" for="variant-price-search">جست‌وجو</label><input class="form-control" id="variant-price-search" type="search" placeholder="جست‌وجوی کالا، تنوع یا طرح" autocomplete="off"><span class="admin-record-count ms-auto" data-price-count aria-live="polite"></span></form>
            <div class="admin-data-status" data-price-status role="status" aria-live="polite">در حال بارگذاری…</div>
            <div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th scope="col">کالا</th><th scope="col">تنوع انبار</th><th scope="col">طرح فروش</th><th scope="col">قیمت (تومان)</th><th scope="col">تخفیف (%)</th><th scope="col">وضعیت</th><th scope="col">عملیات</th></tr></thead><tbody data-price-rows></tbody></table></div>
        </div>
    </section>
</div>
