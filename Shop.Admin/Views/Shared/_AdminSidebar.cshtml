@{
    string? area = ViewContext.RouteData.Values["area"]?.ToString();
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    string? feature = ViewData["FeatureId"]?.ToString();
    bool inStore = string.Equals(area, "Store", StringComparison.OrdinalIgnoreCase);
    bool inWarehouse = string.Equals(area, "Warehouse", StringComparison.OrdinalIgnoreCase);
    bool isHome = string.Equals(area, "Admin", StringComparison.OrdinalIgnoreCase);
    bool IsFeature(string id) => string.Equals(feature, id, StringComparison.OrdinalIgnoreCase);
    bool catalogOpen = inStore && string.Equals(controller, "Catalog", StringComparison.OrdinalIgnoreCase);
    bool salesOpen = inStore && (new[] { "Orders", "Promotions" }.Contains(controller, StringComparer.OrdinalIgnoreCase) || IsFeature("orders") || IsFeature("promotions"));
}
<aside id="sidebar" class="app-sidebar" data-bs-theme="dark" aria-label="ناوبری پنل">
    <div class="app-sidebar-content" data-scrollbar="true" data-height="100%">
        <nav class="menu" aria-label="منوی مدیریت">
            <div class="menu-profile">
                <div class="menu-profile-link admin-sidebar-profile">
                    <div class="menu-profile-cover with-shadow"></div>
                    <div class="menu-profile-image"><span class="admin-sidebar-mark">ش</span></div>
                    <div class="menu-profile-info">
                        <div class="admin-sidebar-profile__title">فروشگاه فخراوری</div>
                        <small>سامانهٔ مدیریت یکپارچه</small>
                    </div>
                </div>
            </div>

            <div class="menu-header">نمای کلی</div>
            <div class="menu-item @(isHome ? "active" : "")">
                <a class="menu-link" asp-area="Admin" asp-controller="Home" asp-action="Index" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-gauge-high" aria-hidden="true"></i></span>
                    <span class="menu-text">پیشخوان کل</span>
                </a>
            </div>

            <div class="menu-header">مدیریت فروشگاه</div>
            <div class="menu-item @(inStore && controller == "Dashboard" ? "active" : "")">
                <a class="menu-link" asp-area="Store" asp-controller="Dashboard" asp-action="Index" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-gauge-high" aria-hidden="true"></i></span><span class="menu-text">پیشخوان فروشگاه</span>
                </a>
            </div>
            <div class="menu-item has-sub @(catalogOpen ? "active expand" : "")">
                <a href="#store-catalog" class="menu-link" aria-expanded="@(catalogOpen ? "true" : "false")">
                    <span class="menu-icon"><i class="fa fa-box-open" aria-hidden="true"></i></span>
                    <span class="menu-text">کاتالوگ</span>
                    <span class="menu-caret"></span>
                </a>
                <div id="store-catalog" class="menu-submenu">
                    <div class="menu-item @(IsFeature("products") ? "active" : "")">
                        <a class="menu-link" asp-area="Store" asp-controller="Catalog" asp-action="Products" data-admin-nav><span class="menu-text">محصولات</span></a>
                    </div>
                    <div class="menu-item @(IsFeature("categories") ? "active" : "")">
                        <a class="menu-link" asp-area="Store" asp-controller="Catalog" asp-action="Categories" data-admin-nav><span class="menu-text">دسته‌بندی‌ها</span></a>
                    </div>
                    <div class="menu-item @(IsFeature("brands") ? "active" : "")">
                        <a class="menu-link" asp-area="Store" asp-controller="Catalog" asp-action="Brands" data-admin-nav><span class="menu-text">برندها</span></a>
                    </div>
                    <div class="menu-item @(IsFeature("attributes") ? "active" : "")">
                        <a class="menu-link" asp-area="Store" asp-controller="Catalog" asp-action="Attributes" data-admin-nav><span class="menu-text">ویژگی‌ها</span></a>
                    </div>
                </div>
            </div>
            <div class="menu-item has-sub @(salesOpen ? "active expand" : "")">
                <a href="#store-sales" class="menu-link" aria-expanded="@(salesOpen ? "true" : "false")">
                    <span class="menu-icon"><i class="fa fa-cart-shopping" aria-hidden="true"></i></span>
                    <span class="menu-text">فروش و سفارش</span>
                    <span class="menu-caret"></span>
                </a>
                <div id="store-sales" class="menu-submenu">
                    <div class="menu-item @(IsFeature("orders") ? "active" : "")"><a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="orders" data-admin-nav><span class="menu-text">سفارش‌ها</span></a></div>
                    <div class="menu-item @(IsFeature("promotions") ? "active" : "")"><a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="promotions" data-admin-nav><span class="menu-text">طرح‌های فروش و تخفیف</span></a></div>
                </div>
            </div>
            <div class="menu-item has-sub @(inStore && new[] { "Customers", "Features" }.Contains(controller, StringComparer.OrdinalIgnoreCase) && new[] { "customers", "reviews", "questions" }.Contains(feature ?? "", StringComparer.OrdinalIgnoreCase) ? "active expand" : "")">
                <a href="#store-customers" class="menu-link" aria-expanded="@(inStore && new[] { "Customers", "Features" }.Contains(controller, StringComparer.OrdinalIgnoreCase) && new[] { "customers", "reviews", "questions" }.Contains(feature ?? "", StringComparer.OrdinalIgnoreCase) ? "true" : "false")">
                    <span class="menu-icon"><i class="fa fa-users" aria-hidden="true"></i></span>
                    <span class="menu-text">مشتریان و بازخورد</span>
                    <span class="menu-caret"></span>
                </a>
                <div id="store-customers" class="menu-submenu">
                    <div class="menu-item @(IsFeature("customers") ? "active" : "")"><a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="customers" data-admin-nav><span class="menu-text">مشتریان</span></a></div>
                    <div class="menu-item @(IsFeature("reviews") ? "active" : "")"><a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="reviews" data-admin-nav><span class="menu-text">دیدگاه‌های محصول</span></a></div>
                    <div class="menu-item @(IsFeature("questions") ? "active" : "")"><a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="questions" data-admin-nav><span class="menu-text">پرسش‌های محصول</span></a></div>
                </div>
            </div>
            <div class="menu-item @(IsFeature("content") || IsFeature("settings") ? "active" : "")">
                <a class="menu-link" asp-area="Store" asp-controller="Features" asp-action="Index" asp-route-feature="content" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-file-lines" aria-hidden="true"></i></span><span class="menu-text">محتوا و صفحات</span>
                </a>
            </div>

            <div class="menu-header">مدیریت انبار</div>
            <div class="menu-item @(inWarehouse && controller == "Dashboard" ? "active" : "")">
                <a class="menu-link" asp-area="Warehouse" asp-controller="Dashboard" asp-action="Index" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-chart-pie" aria-hidden="true"></i></span><span class="menu-text">نمای کلی انبار</span>
                </a>
            </div>
            <div class="menu-item @(controller == "Warehouses" ? "active" : "")">
                <a class="menu-link" asp-area="Warehouse" asp-controller="Warehouses" asp-action="Index" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-warehouse" aria-hidden="true"></i></span><span class="menu-text">انبارها</span>
                </a>
            </div>
            <div class="menu-item @(controller == "Stock" ? "active" : "")">
                <a class="menu-link" asp-area="Warehouse" asp-controller="Stock" asp-action="Index" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-boxes-stacked" aria-hidden="true"></i></span><span class="menu-text">موجودی کالا</span>
                </a>
            </div>
            <div class="menu-item has-sub @(inWarehouse && controller == "Features" ? "active expand" : "")">
                <a href="#warehouse-operations" class="menu-link" aria-expanded="@(inWarehouse && controller == "Features" ? "true" : "false")">
                    <span class="menu-icon"><i class="fa fa-arrows-rotate" aria-hidden="true"></i></span>
                    <span class="menu-text">عملیات انبار</span>
                    <span class="menu-caret"></span>
                </a>
                <div id="warehouse-operations" class="menu-submenu">
                    <div class="menu-item @(IsFeature("receipts") ? "active" : "")"><a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="receipts" data-admin-nav><span class="menu-text">رسید کالا</span></a></div>
                    <div class="menu-item @(IsFeature("dispatches") ? "active" : "")"><a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="dispatches" data-admin-nav><span class="menu-text">حواله خروج</span></a></div>
                    <div class="menu-item @(IsFeature("transfers") ? "active" : "")"><a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="transfers" data-admin-nav><span class="menu-text">انتقال بین انبارها</span></a></div>
                    <div class="menu-item @(IsFeature("adjustments") ? "active" : "")"><a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="adjustments" data-admin-nav><span class="menu-text">اصلاح موجودی</span></a></div>
                    <div class="menu-item @(IsFeature("movements") ? "active" : "")"><a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="movements" data-admin-nav><span class="menu-text">گردش کالا</span></a></div>
                </div>
            </div>
            <div class="menu-item @(IsFeature("companies") ? "active" : "")">
                <a class="menu-link" asp-area="Warehouse" asp-controller="Features" asp-action="Index" asp-route-feature="companies" data-admin-nav>
                    <span class="menu-icon"><i class="fa fa-building" aria-hidden="true"></i></span><span class="menu-text">شرکت‌ها و تأمین‌کنندگان</span>
                </a>
            </div>
            <div class="menu-divider"></div>
            <div class="menu-item">
                <a class="menu-link" href="/" target="_blank" rel="noopener">
                    <span class="menu-icon"><i class="fa fa-arrow-up-right-from-square" aria-hidden="true"></i></span><span class="menu-text">مشاهدهٔ فروشگاه</span>
                </a>
            </div>
        </nav>
    </div>
</aside>
