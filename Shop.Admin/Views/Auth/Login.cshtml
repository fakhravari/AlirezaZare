@model Shop.Admin.Controllers.LoginInput
@{
    Layout = null;
    ViewData["Title"] = "ورود کاربران سامانه";
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/color_admin/assets/css/vendor.min.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/color_admin/assets/css/default/app-rtl.min.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/color_admin/assets/css/persian-font.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true"/>
</head>
<body class="bg-component">
<main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <section class="panel panel-inverse w-100" style="max-width: 460px" aria-labelledby="login-title">
        <div class="panel-heading">
            <h1 id="login-title" class="panel-title">ورود به سامانهٔ مدیریت</h1>
        </div>
        <div class="panel-body">
            <p class="text-muted">این حساب فقط برای کاربران سیستم است و با حساب مشتریان فروشگاه تفاوت دارد.</p>
            <form asp-controller="Auth" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden"/>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">نام کاربری سیستم</label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" required autofocus/>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">گذرواژه</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" required/>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input"/>
                    <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label>
                </div>
                <button class="btn btn-theme w-100" type="submit">ورود</button>
            </form>
        </div>
    </section>
</main>
</body>
</html>